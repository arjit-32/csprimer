---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const topicRequestUrl = "https://github.com/arjit-32/csprimer/issues/new?template=topic_request.yml";
---

<section class={`px-4 sm:px-6 py-12 md:py-16 ${className}`}>
  <div class="container max-w-5xl mx-auto">
    <div class="rounded-3xl border border-gray-200/90 bg-white p-7 sm:p-10 lg:p-12 shadow-sm">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-12">
        
        <!-- Left: Broad Information & Topic Request -->
        <div class="flex-1 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold tracking-wider mb-4">
            <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
            Newsletter & Community
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight leading-tight mb-3">
            Stay in the Loop
          </h2>

          <p class="text-zinc-600 text-sm sm:text-base leading-relaxed mb-6 max-w-xl">
            Get the monthly newsletter with real-world architecture breakdowns, curated engineering reads, and new curriculum releases. 100% free, zero spam.
          </p>

          <div class="flex items-center justify-center lg:justify-start gap-1.5 text-xs sm:text-sm text-zinc-500">
            <span>Want a specific topic or interview breakdown?</span>
            <a
              href={topicRequestUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[#FE6019] hover:underline inline-flex items-center gap-0.5 cursor-pointer"
            >
              <span>Request on GitHub</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right: Substack Embed (Direct without nested border box) -->
        <div class="w-full lg:w-[480px] shrink-0">
          <iframe
            src="https://csprimer.substack.com/embed"
            width="100%"
            height="320"
            style="border: none; background: transparent; width: 100%; display: block;"
            frameborder="0"
            scrolling="no"
            loading="lazy"
            title="CSPrimer Substack Newsletter"
          ></iframe>
        </div>

      </div>
    </div>
  </div>
</section>
