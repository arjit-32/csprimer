---
// Structured Learning - Interactive Roadmap Tree with Clean 3-Node Tracks
const categories = [
  {
    id: 0,
    category: "DSA",
    name: "DSA",
    fullName: "Data Structures & Algorithms",
    tag: "Algorithms",
    color: "#ef4444",
    accentBg: "bg-red-50",
    accentBorder: "border-red-500",
    accentText: "text-red-700",
    dotColor: "bg-red-500",
    glowShadow: "rgba(239, 68, 68, 0.35)",
    nodes: [
      { id: "dsa-overview", title: "DSA Overview", sub: "Complexity & Big-O", url: "/courses/dsa-overview" },
      { id: "dsa-array", title: "Arrays & Strings", sub: "Pointers & Sliding Window", url: "/courses/dsa-array" },
      { id: "dsa-dynamic-programming", title: "Dynamic Programming", sub: "Memoization & Grids", url: "/courses/dsa-dynamic-programming" },
    ],
  },
  {
    id: 1,
    category: "Development",
    name: "Fullstack Dev",
    fullName: "Full-Stack Web Development",
    tag: "Engineering",
    color: "#10b981",
    accentBg: "bg-emerald-50",
    accentBorder: "border-emerald-500",
    accentText: "text-emerald-700",
    dotColor: "bg-emerald-500",
    glowShadow: "rgba(16, 185, 129, 0.35)",
    nodes: [
      { id: "javascript", title: "JavaScript Core", sub: "Async, Closures & DOM", url: "/courses/javascript" },
      { id: "nodejs", title: "Node.js & Express", sub: "REST APIs & Middleware", url: "/courses/nodejs" },
      { id: "sql", title: "MySQL & Prisma", sub: "Relational Queries & ORM", url: "/courses/sql" },
    ],
  },
  {
    id: 2,
    category: "System-Design",
    name: "System Design",
    fullName: "System Design & Cloud",
    tag: "Architecture",
    color: "#a855f7",
    accentBg: "bg-purple-50",
    accentBorder: "border-purple-500",
    accentText: "text-purple-700",
    dotColor: "bg-purple-500",
    glowShadow: "rgba(168, 85, 247, 0.35)",
    nodes: [
      { id: "distributed", title: "Distributed Systems", sub: "CAP, Consensus & Sharding", url: "/courses/distributed" },
      { id: "high-level-system-design", title: "High Level Design", sub: "Microservices & Caching", url: "/courses/high-level-system-design" },
      { id: "api", title: "API Design", sub: "REST, GraphQL & gRPC", url: "/courses/api" },
    ],
  },
  {
    id: 3,
    category: "Core-CS",
    name: "Core CS",
    fullName: "Core Computer Science",
    tag: "Fundamentals",
    color: "#0284c7",
    accentBg: "bg-sky-50",
    accentBorder: "border-sky-500",
    accentText: "text-sky-700",
    dotColor: "bg-sky-500",
    glowShadow: "rgba(2, 132, 199, 0.35)",
    nodes: [
      { id: "os", title: "Operating Systems", sub: "Processes, Threads & Memory", url: "/courses/os" },
      { id: "cn", title: "Computer Networks", sub: "TCP/IP, Routing & DNS", url: "/courses/cn" },
      { id: "dbms", title: "Database Systems", sub: "ACID, B-Trees & Indexing", url: "/courses/dbms" },
    ],
  },
];
---

<section class="section structured-learning-section py-12 md:py-16 bg-[#fafafa] relative overflow-hidden" id="structured-learning">
  <div class="container mx-auto px-4 max-w-7xl">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-5 border-b border-zinc-200 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold tracking-wider mb-3 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          Structured Learning Paths
        </div>
        <h2 class="text-3xl md:text-4xl font-black font-secondary text-zinc-900 tracking-tight leading-tight">
          Learning Roadmaps
        </h2>
        <p class="text-zinc-600 text-sm md:text-base mt-2 max-w-2xl leading-relaxed">
          From computer science fundamentals to algorithms, full-stack systems, and distributed architecture. Select any track to preview its progression.
        </p>
      </div>

      <a 
        href="/roadmaps" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-zinc-200 text-sm font-bold text-zinc-800 hover:text-[#FE6019] hover:border-[#FE6019] shadow-sm hover:shadow-md transition-all self-start md:self-auto shrink-0 group"
      >
        <span>Open Interactive Canvas</span>
        <svg class="w-4 h-4 text-[#FE6019] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Tree Canvas Frame -->
    <div class="bg-white border border-zinc-200/90 rounded-2xl shadow-sm overflow-hidden" id="treeCanvasWrapper">
      
      <!-- Top Canvas Status Bar -->
      <div class="flex items-center justify-between px-5 py-3.5 bg-zinc-50/90 border-b border-zinc-200 text-xs text-zinc-500">
        <div class="flex items-center gap-2">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
          </span>
          <span class="font-mono font-semibold text-zinc-700 uppercase tracking-wider text-[11px]">Active Learning Path</span>
        </div>
        
        <!-- Category selector buttons for quick manual switching -->
        <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none">
          {categories.map((cat) => (
            <button
              type="button"
              class="cat-pill-btn px-2.5 py-1 rounded-lg text-[11px] font-bold tracking-tight transition-all cursor-pointer border"
              data-target-track={cat.id}
              style={`--cat-color: ${cat.color};`}
            >
              <span class="inline-block w-1.5 h-1.5 rounded-full mr-1.5" style={`background-color: ${cat.color};`}></span>
              <span>{cat.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Canvas Body -->
      <div 
        id="treeCanvas" 
        class="p-5 sm:p-8 md:p-10 bg-[#fdfdfd] relative bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:18px_18px] overflow-x-auto"
        data-active-cat="0"
      >
        <div class="min-w-[820px] lg:min-w-[980px] py-4 flex items-center justify-start lg:justify-center select-none gap-0">
          
          <!-- Column 1: Start Node -->
          <div class="flex items-center shrink-0">
            <a
              href="/roadmaps"
              class="group relative flex items-center justify-between w-32 sm:w-36 p-3 rounded-xl shadow-md hover:shadow-xl hover:scale-105 transition-all duration-200 border border-zinc-700 no-underline shrink-0 bg-zinc-900"
              title="Start Your Journey"
            >
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-500 animate-pulse"></span>
                <div>
                  <div class="text-[9px] font-mono uppercase tracking-wider text-orange-400 font-bold leading-none">Step 0</div>
                  <div class="text-xs font-bold font-secondary text-white mt-1">Start Here</div>
                </div>
              </div>
              <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Connector from Start to Prerequisites with animated pulse -->
            <div class="relative w-8 h-0.5 bg-zinc-300 shrink-0 overflow-hidden">
              <div class="line-pulse-beam"></div>
            </div>
          </div>

          <!-- Column 2: Foundations Node -->
          <div class="flex items-center shrink-0">
            <a
              href="/roadmaps?category=Core-CS"
              class="group relative flex flex-col justify-between w-40 sm:w-44 p-3 rounded-xl border-2 border-sky-300 bg-white shadow-xs hover:border-sky-500 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 no-underline shrink-0"
              title="Core Computer Science Prerequisite"
            >
              <div class="flex items-center justify-between mb-1">
                <span class="text-[9px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200">
                  Prerequisite
                </span>
                <span class="w-2 h-2 rounded-full bg-sky-500"></span>
              </div>
              <div class="text-xs sm:text-sm font-bold text-zinc-900 group-hover:text-sky-700 transition-colors font-secondary">
                CS Core
              </div>
              <div class="text-[10px] text-zinc-500 mt-0.5 truncate">
                OS, Networks, DBMS &amp; Arch
              </div>
            </a>
          </div>

          <!-- Center Spine & Connector into Categories List -->
          <div class="relative flex items-center shrink-0">
            <div class="w-6 h-0.5 bg-zinc-300 shrink-0"></div>
          </div>

          <!-- Column 3: The 4 Categories with Connected Left Spine -->
          <div class="relative flex flex-col gap-4 py-2 shrink-0">
            <!-- Vertical Spine connecting all 4 categories at their exact centers -->
            <div class="cat-spine absolute left-0 top-[26px] bottom-[26px] w-0.5 bg-zinc-300">
              <!-- Animated traveling indicator on the spine -->
              <div id="spineIndicator" class="absolute left-[-2px] w-1.5 h-6 rounded-full bg-[#ef4444] transition-all duration-500 shadow-sm"></div>
            </div>

            {categories.map((cat) => (
              <div 
                class={`category-tree-row relative flex items-center pl-6 cat-row-${cat.id}`}
                data-track-id={cat.id}
              >
                <!-- Horizontal branch connector from spine directly into category card center -->
                <div class="cat-in-connector absolute left-0 top-1/2 -translate-y-1/2 w-6 h-0.5 bg-zinc-300 overflow-hidden">
                  <div class={`cat-beep-beam cat-beep-${cat.id}`} style={`--accent-color: ${cat.color};`}></div>
                </div>

                <!-- Category Card -->
                <a
                  href={`/roadmaps?category=${cat.category}`}
                  class={`cat-node-btn relative flex items-center justify-between w-40 sm:w-44 p-2.5 px-3 rounded-xl border bg-white shadow-xs transition-all duration-300 no-underline shrink-0 cursor-pointer ${cat.accentBorder}`}
                  title={`Open ${cat.fullName} Roadmap`}
                >
                  <div class="flex items-center gap-2">
                    <span class={`cat-dot w-2.5 h-2.5 rounded-full shrink-0 transition-transform ${cat.dotColor}`}></span>
                    <div>
                      <div class="text-[9px] font-mono uppercase text-zinc-400 font-bold leading-none">{cat.tag}</div>
                      <div class="text-xs font-bold text-zinc-900 font-secondary mt-0.5 truncate">{cat.name}</div>
                    </div>
                  </div>
                  <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:translate-x-0.5 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            ))}
          </div>

          <!-- Column 4: Dynamic 3-Course Pathway for Active Category -->
          <div class="relative flex items-center shrink-0 pl-2">
            {categories.map((cat) => (
              <div 
                class={`category-branch-panel cat-branch-panel-${cat.id} flex items-center transition-all duration-300`}
                data-panel-id={cat.id}
              >
                <!-- Connector Stem leading out of active category into nodes -->
                <div class="w-8 h-0.5 bg-zinc-300 relative overflow-hidden shrink-0">
                  <div class="sub-beep-beam" style={`--accent-color: ${cat.color};`}></div>
                </div>

                <!-- Sequential 2-3 Courses Row -->
                <div class="flex items-center gap-0">
                  {cat.nodes.map((node, nIdx) => (
                    <div class="flex items-center">
                      {/* Connector between nodes */}
                      {nIdx > 0 && (
                        <div class="w-6 h-0.5 bg-zinc-300 relative overflow-hidden shrink-0">
                          <div class="sub-beep-beam" style={`--accent-color: ${cat.color}; animation-delay: ${nIdx * 0.3}s;`}></div>
                        </div>
                      )}

                      <!-- Node Card -->
                      <a
                        href={node.url}
                        class="subnode-card relative flex flex-col justify-center px-3.5 py-2.5 rounded-xl border border-zinc-200 bg-white shadow-xs hover:border-[var(--card-accent)] hover:shadow-md transition-all duration-200 no-underline shrink-0 w-36 sm:w-44"
                        style={`--card-accent: ${cat.color};`}
                        title={`View ${node.title} Course`}
                      >
                        <div class="text-[9px] font-mono text-zinc-400 font-bold uppercase tracking-wider mb-0.5">
                          Milestone {nIdx + 1}
                        </div>
                        <div class="text-xs font-bold text-zinc-900 leading-snug truncate">
                          {node.title}
                        </div>
                        <div class="text-[10px] text-zinc-500 truncate mt-0.5">
                          {node.sub}
                        </div>
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>

      <!-- Canvas Footer Quick CTA -->
      <div class="p-4 md:px-6 md:py-3.5 bg-zinc-50/90 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-600">
        <div class="flex items-center gap-2 text-center sm:text-left">
          <svg class="w-4 h-4 text-[#FE6019] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Click any course milestone to open its syllabus, or explore the full interactive skill tree.</span>
        </div>
        <a
          href="/roadmaps"
          class="text-[#FE6019] hover:underline font-bold whitespace-nowrap flex items-center gap-1.5"
        >
          <span>Launch Full Interactive Tree</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  /* Continuous beam from Start to Prerequisites */
  .line-pulse-beam {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, #FE6019, transparent);
    animation: sweep-beam-start 2s ease-in-out infinite;
  }

  @keyframes sweep-beam-start {
    0%, 20% { left: -100%; opacity: 0; }
    40% { opacity: 1; }
    70% { opacity: 1; }
    90%, 100% { left: 100%; opacity: 0; }
  }

  /* Sweeping beep beam along connector lines */
  .cat-beep-beam,
  .sub-beep-beam {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--accent-color, #10b981), transparent);
    opacity: 0;
  }

  @keyframes sweep-beep-active {
    0% { left: -100%; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  /* Branch panels visibility (ONLY the active one shows!) */
  .category-branch-panel {
    display: none;
    opacity: 0;
    transform: translateX(-8px);
  }

  .category-branch-panel.panel-active {
    display: flex;
    opacity: 1;
    transform: translateX(0);
  }

  /* Dynamic Active States driven by data-active-cat */
  #treeCanvas[data-active-cat="0"] .cat-row-0 .cat-node-btn,
  #treeCanvas[data-active-cat="1"] .cat-row-1 .cat-node-btn,
  #treeCanvas[data-active-cat="2"] .cat-row-2 .cat-node-btn,
  #treeCanvas[data-active-cat="3"] .cat-row-3 .cat-node-btn {
    box-shadow: 0 4px 14px var(--glow-color, rgba(239, 68, 68, 0.25));
    transform: translateY(-2px);
  }

  #treeCanvas[data-active-cat="0"] .cat-row-0 .cat-beep-beam,
  #treeCanvas[data-active-cat="1"] .cat-row-1 .cat-beep-beam,
  #treeCanvas[data-active-cat="2"] .cat-row-2 .cat-beep-beam,
  #treeCanvas[data-active-cat="3"] .cat-row-3 .cat-beep-beam {
    opacity: 1;
    animation: sweep-beep-active 0.8s ease-out infinite;
  }

  #treeCanvas[data-active-cat="0"] .cat-row-0 .cat-dot,
  #treeCanvas[data-active-cat="1"] .cat-row-1 .cat-dot,
  #treeCanvas[data-active-cat="2"] .cat-row-2 .cat-dot,
  #treeCanvas[data-active-cat="3"] .cat-row-3 .cat-dot {
    transform: scale(1.35);
  }

  /* Subtree beeps while panel is active */
  .category-branch-panel.panel-active .sub-beep-beam {
    opacity: 1;
    animation: sweep-beep-active 0.9s ease-out infinite;
  }

  /* Top Pill Button active styles */
  .cat-pill-btn.active {
    background-color: #ffffff;
    color: #18181b;
    border-color: var(--cat-color);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .cat-pill-btn:not(.active) {
    background-color: #f4f4f5;
    color: #71717a;
    border-color: transparent;
  }
</style>

<script>
  let rotateTimer: ReturnType<typeof setInterval> | null = null;
  const spineTopOffsets = ["26px", "74px", "122px", "170px"];
  const spineColors = ["#ef4444", "#10b981", "#a855f7", "#0284c7"];

  function initStructuredTree() {
    const canvas = document.getElementById("treeCanvas");
    const spineIndicator = document.getElementById("spineIndicator");
    const pillButtons = document.querySelectorAll<HTMLButtonElement>(".cat-pill-btn");
    const branchPanels = document.querySelectorAll<HTMLElement>(".category-branch-panel");
    const categoryRows = document.querySelectorAll<HTMLElement>(".category-tree-row");

    if (!canvas) return;

    if (rotateTimer) clearInterval(rotateTimer);

    let currentTrack = parseInt(canvas.getAttribute("data-active-cat") || "0", 10);
    let isUserHovered = false;

    function applyActiveTrack(index: number) {
      currentTrack = index;
      canvas?.setAttribute("data-active-cat", String(currentTrack));

      // Update spine indicator position & color
      if (spineIndicator) {
        spineIndicator.style.top = spineTopOffsets[currentTrack] || "26px";
        spineIndicator.style.backgroundColor = spineColors[currentTrack] || "#ef4444";
      }

      // Show ONLY the active category's branch panel
      branchPanels.forEach((panel) => {
        const panelId = parseInt(panel.getAttribute("data-panel-id") || "0", 10);
        if (panelId === currentTrack) {
          panel.classList.add("panel-active");
        } else {
          panel.classList.remove("panel-active");
        }
      });

      // Update top pill buttons
      pillButtons.forEach((btn) => {
        const targetId = parseInt(btn.getAttribute("data-target-track") || "0", 10);
        if (targetId === currentTrack) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });
    }

    // Initialize with current track
    applyActiveTrack(currentTrack);

    // Auto-rotate every 4 seconds
    rotateTimer = setInterval(() => {
      if (!isUserHovered) {
        const nextTrack = (currentTrack + 1) % 4;
        applyActiveTrack(nextTrack);
      }
    }, 4000);

    // Interactive button clicks (instant switch)
    pillButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = parseInt(btn.getAttribute("data-target-track") || "0", 10);
        applyActiveTrack(targetId);
      });
    });

    // Hover on category rows to inspect
    categoryRows.forEach((row) => {
      row.addEventListener("mouseenter", () => {
        isUserHovered = true;
        const trackId = parseInt(row.getAttribute("data-track-id") || "0", 10);
        applyActiveTrack(trackId);
      });

      row.addEventListener("mouseleave", () => {
        isUserHovered = false;
      });
    });

    // Also pause if hovering inside the branch panel
    branchPanels.forEach((panel) => {
      panel.addEventListener("mouseenter", () => { isUserHovered = true; });
      panel.addEventListener("mouseleave", () => { isUserHovered = false; });
    });
  }

  document.addEventListener("astro:page-load", initStructuredTree);
</script>
