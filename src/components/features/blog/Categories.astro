---
// Structured Learning - NeetCode-style Left-to-Right Skill Tree
---

<section class="section structured-learning-section py-12 md:py-16 bg-[#fafafa] relative overflow-hidden" id="structured-learning">
  <div class="container mx-auto px-4 max-w-7xl">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-5 border-b border-zinc-200 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold uppercase tracking-wider mb-3 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          Visual Skill Tree
        </div>
        <h2 class="text-3xl md:text-4xl font-black font-secondary text-zinc-900 tracking-tight leading-tight">
          Structured Learning
        </h2>
        <p class="text-zinc-600 text-sm md:text-base mt-2 max-w-2xl leading-relaxed">
          Master computer science fundamentals first, then branch into specialized engineering tracks. Click any node to explore the interactive roadmap.
        </p>
      </div>

      <a 
        href="/roadmaps" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-zinc-200 text-sm font-bold text-zinc-800 hover:text-[#FE6019] hover:border-[#FE6019] shadow-sm hover:shadow-md transition-all self-start md:self-auto shrink-0 group"
      >
        <span>Open Interactive Canvas</span>
        <svg class="w-4 h-4 text-[#FE6019] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Tree Canvas Container -->
    <div class="bg-white border border-zinc-200/90 rounded-2xl shadow-sm overflow-hidden">
      
      <!-- Top Canvas Bar -->
      <div class="flex items-center justify-between px-5 py-3.5 bg-zinc-50/90 border-b border-zinc-200 text-xs text-zinc-500">
        <div class="flex items-center gap-2">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-mono font-semibold text-zinc-700 uppercase tracking-wider text-[11px]">Engineering Tree</span>
        </div>
        <div class="flex items-center gap-1.5 text-zinc-400 font-mono text-[11px]">
          <span>Click any node to open roadmap</span>
          <span class="hidden sm:inline">&rarr;</span>
        </div>
      </div>

      <!-- Canvas Body with Subtle Grid (Horizontal scrollable on mobile) -->
      <div class="p-6 sm:p-10 md:p-12 bg-[#fdfdfd] relative bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:18px_18px] overflow-x-auto">
        <div class="min-w-[960px] py-4 flex items-center gap-8 justify-start lg:justify-center select-none">
          
          <!-- Column 1: Start Node -->
          <div class="flex items-center shrink-0">
            <a
              href="/roadmaps"
              class="group relative flex items-center justify-between w-40 p-3.5 rounded-xl bg-gradient-to-br from-zinc-900 to-zinc-800 text-white shadow-md hover:shadow-xl hover:scale-105 transition-all duration-200 border border-zinc-700 no-underline"
              title="Start Here"
            >
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-500 animate-pulse"></span>
                <div>
                  <div class="text-[10px] font-mono uppercase tracking-wider text-orange-400 font-bold">Step 0</div>
                  <div class="text-sm font-bold font-secondary text-white">Tech Noob</div>
                </div>
              </div>
              <svg class="w-4 h-4 text-zinc-400 group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Line from Start to Core CS -->
            <div class="w-10 h-0.5 bg-zinc-300 relative">
              <svg class="w-3 h-3 text-zinc-400 absolute -right-1 -top-[5px]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </div>
          </div>

          <!-- Column 2: Core CS Node -->
          <div class="flex items-center shrink-0">
            <a
              href="/roadmaps?category=Core-CS"
              class="group relative flex flex-col justify-between w-52 p-4 rounded-xl border-2 border-sky-300 bg-white shadow-sm hover:border-sky-500 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 no-underline"
              title="Core Computer Science"
            >
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200">
                  Prerequisite
                </span>
                <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span>
              </div>
              <div class="text-sm font-bold text-zinc-900 group-hover:text-sky-700 transition-colors font-secondary leading-snug">
                Core CS
              </div>
              <div class="text-[11px] text-zinc-500 mt-1">
                Logic, Architecture, OS & Networks
              </div>
              <div class="mt-2.5 pt-2 border-t border-zinc-100 flex items-center justify-between text-[11px] font-semibold text-sky-600">
                <span>View Roadmap</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          </div>

          <!-- Branching connector from Core CS to the 4 tracks -->
          <div class="relative w-8 self-stretch flex items-center">
            <!-- SVG connector curves branching to 4 tracks -->
            <svg class="w-8 h-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 32 400">
              <!-- Trunk stem from left center (x=0, y=200) to x=16 -->
              <path d="M 0,200 L 16,200" stroke="#cbd5e1" stroke-width="2" fill="none" />
              <!-- Vertical spine from top track (y=48) to bottom track (y=352) -->
              <path d="M 16,48 L 16,352" stroke="#cbd5e1" stroke-width="2" fill="none" />
              <!-- Branch 1 to DSA (y=48) -->
              <path d="M 16,48 L 32,48" stroke="#cbd5e1" stroke-width="2" fill="none" />
              <!-- Branch 2 to Fullstack (y=164) -->
              <path d="M 16,164 L 32,164" stroke="#cbd5e1" stroke-width="2" fill="none" />
              <!-- Branch 3 to System Design (y=268) -->
              <path d="M 16,268 L 32,268" stroke="#cbd5e1" stroke-width="2" fill="none" />
              <!-- Branch 4 to AI Engineering (y=352) -->
              <path d="M 16,352 L 32,352" stroke="#cbd5e1" stroke-width="2" fill="none" />
            </svg>
          </div>

          <!-- Column 3: The 4 Tracks (DSA, Full-Stack Dev with branches, System Design, AI Engineering) -->
          <div class="flex flex-col gap-5 shrink-0 justify-center">
            
            <!-- Track 1: DSA -->
            <div class="flex items-center">
              <a
                href="/roadmaps?category=DSA"
                class="group relative flex items-center justify-between w-64 p-3.5 rounded-xl border border-zinc-200 bg-white shadow-xs hover:border-red-500 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 no-underline"
                title="Data Structures & Algorithms"
              >
                <div class="flex items-center gap-2.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500 shrink-0"></span>
                  <div>
                    <div class="text-[10px] font-mono uppercase text-red-600 font-bold">Algorithms Track</div>
                    <div class="text-sm font-bold text-zinc-900 group-hover:text-red-700 transition-colors font-secondary">
                      DSA
                    </div>
                  </div>
                </div>
                <svg class="w-4 h-4 text-zinc-400 group-hover:text-red-600 group-hover:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>

            <!-- Track 2: Full-Stack Dev + Sub-branches (Frontend, Backend, DB, Production Grade Eng, Extras) -->
            <div class="flex items-center gap-4">
              
              <!-- Full-Stack Parent Card -->
              <a
                href="/roadmaps?category=Development"
                class="group relative flex flex-col justify-between w-64 p-4 rounded-xl border-2 border-emerald-400 bg-emerald-50/30 shadow-xs hover:border-emerald-600 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 no-underline shrink-0"
                title="Full-Stack Development"
              >
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200">
                    Core Branching Track
                  </span>
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                </div>
                <div class="text-base font-bold text-zinc-900 group-hover:text-emerald-700 transition-colors font-secondary">
                  Fullstack Dev
                </div>
                <div class="text-[11px] text-zinc-500 mt-0.5">
                  5 Key Sub-Branches &rarr;
                </div>
                <div class="mt-2 pt-2 border-t border-emerald-200/60 flex items-center justify-between text-[11px] font-semibold text-emerald-700">
                  <span>Explore Roadmaps</span>
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>

              <!-- Branching connector line from Fullstack Dev to the 5 subnodes -->
              <div class="relative w-8 self-stretch flex items-center">
                <svg class="w-8 h-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 32 240">
                  <!-- Trunk stem from left (x=0, y=120) to x=16 -->
                  <path d="M 0,120 L 16,120" stroke="#10b981" stroke-width="2" fill="none" />
                  <!-- Vertical spine across all 5 subnodes -->
                  <path d="M 16,24 L 16,216" stroke="#10b981" stroke-width="2" fill="none" />
                  <!-- Branch 1 to Frontend (y=24) -->
                  <path d="M 16,24 L 32,24" stroke="#10b981" stroke-width="2" fill="none" />
                  <!-- Branch 2 to Backend (y=72) -->
                  <path d="M 16,72 L 32,72" stroke="#10b981" stroke-width="2" fill="none" />
                  <!-- Branch 3 to DB (y=120) -->
                  <path d="M 16,120 L 32,120" stroke="#10b981" stroke-width="2" fill="none" />
                  <!-- Branch 4 to Production Grade Eng (y=168) -->
                  <path d="M 16,168 L 32,168" stroke="#10b981" stroke-width="2" fill="none" />
                  <!-- Branch 5 to Extras (y=216) -->
                  <path d="M 16,216 L 32,216" stroke="#10b981" stroke-width="2" fill="none" />
                </svg>
              </div>

              <!-- Column 4: The 5 Fullstack Subnodes -->
              <div class="flex flex-col gap-2.5 shrink-0">
                
                <!-- Subnode 1: Frontend -->
                <a
                  href="/roadmaps?category=Development"
                  class="group flex items-center justify-between w-52 py-2 px-3 rounded-lg border border-zinc-200 bg-white hover:border-emerald-500 hover:shadow-sm hover:translate-x-1 transition-all duration-150 no-underline"
                  title="Frontend"
                >
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-bold text-zinc-800 group-hover:text-emerald-700">Frontend</span>
                  </div>
                  <span class="text-[10px] font-mono text-zinc-400 group-hover:text-emerald-600">&rarr;</span>
                </a>

                <!-- Subnode 2: Backend -->
                <a
                  href="/roadmaps?category=Development"
                  class="group flex items-center justify-between w-52 py-2 px-3 rounded-lg border border-zinc-200 bg-white hover:border-emerald-500 hover:shadow-sm hover:translate-x-1 transition-all duration-150 no-underline"
                  title="Backend"
                >
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-bold text-zinc-800 group-hover:text-emerald-700">Backend</span>
                  </div>
                  <span class="text-[10px] font-mono text-zinc-400 group-hover:text-emerald-600">&rarr;</span>
                </a>

                <!-- Subnode 3: DB -->
                <a
                  href="/roadmaps?category=Development"
                  class="group flex items-center justify-between w-52 py-2 px-3 rounded-lg border border-zinc-200 bg-white hover:border-emerald-500 hover:shadow-sm hover:translate-x-1 transition-all duration-150 no-underline"
                  title="DB (Databases)"
                >
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-bold text-zinc-800 group-hover:text-emerald-700">DB</span>
                  </div>
                  <span class="text-[10px] font-mono text-zinc-400 group-hover:text-emerald-600">&rarr;</span>
                </a>

                <!-- Subnode 4: Production Grade Eng -->
                <a
                  href="/roadmaps?category=Development"
                  class="group flex items-center justify-between w-52 py-2 px-3 rounded-lg border border-zinc-200 bg-white hover:border-emerald-500 hover:shadow-sm hover:translate-x-1 transition-all duration-150 no-underline"
                  title="Production Grade Eng"
                >
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-bold text-zinc-800 group-hover:text-emerald-700">Production Grade Eng</span>
                  </div>
                  <span class="text-[10px] font-mono text-zinc-400 group-hover:text-emerald-600">&rarr;</span>
                </a>

                <!-- Subnode 5: Extras -->
                <a
                  href="/roadmaps?category=Development"
                  class="group flex items-center justify-between w-52 py-2 px-3 rounded-lg border border-zinc-200 bg-white hover:border-emerald-500 hover:shadow-sm hover:translate-x-1 transition-all duration-150 no-underline"
                  title="Extras"
                >
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-bold text-zinc-800 group-hover:text-emerald-700">Extras</span>
                  </div>
                  <span class="text-[10px] font-mono text-zinc-400 group-hover:text-emerald-600">&rarr;</span>
                </a>

              </div>

            </div>

            <!-- Track 3: System Design -->
            <div class="flex items-center">
              <a
                href="/roadmaps?category=System-Design"
                class="group relative flex items-center justify-between w-64 p-3.5 rounded-xl border border-zinc-200 bg-white shadow-xs hover:border-purple-500 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 no-underline"
                title="System Design"
              >
                <div class="flex items-center gap-2.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-purple-500 shrink-0"></span>
                  <div>
                    <div class="text-[10px] font-mono uppercase text-purple-600 font-bold">Architecture Track</div>
                    <div class="text-sm font-bold text-zinc-900 group-hover:text-purple-700 transition-colors font-secondary">
                      System Design
                    </div>
                  </div>
                </div>
                <svg class="w-4 h-4 text-zinc-400 group-hover:text-purple-600 group-hover:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>

            <!-- Track 4: AI Engineering -->
            <div class="flex items-center">
              <a
                href="/roadmaps?category=AI-Engineering"
                class="group relative flex items-center justify-between w-64 p-3.5 rounded-xl border border-zinc-200 bg-white shadow-xs hover:border-pink-500 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 no-underline"
                title="AI Engineering"
              >
                <div class="flex items-center gap-2.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-pink-500 shrink-0"></span>
                  <div>
                    <div class="text-[10px] font-mono uppercase text-pink-600 font-bold">AI Track</div>
                    <div class="text-sm font-bold text-zinc-900 group-hover:text-pink-700 transition-colors font-secondary">
                      AI Engineering
                    </div>
                  </div>
                </div>
                <svg class="w-4 h-4 text-zinc-400 group-hover:text-pink-600 group-hover:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>

          </div>

        </div>
      </div>

      <!-- Canvas Footer Quick CTA -->
      <div class="p-4 md:px-6 md:py-3.5 bg-zinc-50/90 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-600">
        <div class="flex items-center gap-2 text-center sm:text-left">
          <svg class="w-4 h-4 text-[#FE6019] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Need full interactive pan, zoom, edge dependencies, and checklists?</span>
        </div>
        <a
          href="/roadmaps"
          class="text-[#FE6019] hover:underline font-bold whitespace-nowrap flex items-center gap-1.5"
        >
          <span>Launch Full Interactive Tree</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</section>
