---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
  title?: string;
  class?: string;
}

const { headings = [], title = "Table of Contents", class: className = "" } = Astro.props;

// Filter for h2 and h3
const tocHeadings = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <aside class={`toc-sidebar ${className}`} aria-label="Table of Contents">
    <div class="toc-wrapper">
      <div class="toc-card">
        <div class="toc-header">
          <div class="toc-header-main">
            <svg class="toc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="14" y2="12"></line>
              <line x1="4" y1="18" x2="18" y2="18"></line>
            </svg>
            <span class="toc-title">{title}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="toc-progress-badge" id="toc-progress-text">0% read</span>
            <button
              id="collapse-toc-btn"
              class="toc-burger-toggle p-1 rounded-md text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer"
              title="Hide Outline (expand reading area)"
              aria-label="Hide Outline"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Reading progress track -->
        <div class="toc-progress-track">
          <div class="toc-progress-bar" id="toc-progress-bar"></div>
        </div>

        <nav class="toc-nav" id="toc-nav">
          <ul class="toc-list" id="toc-list">
            {tocHeadings.map((heading) => (
              <li
                class={`toc-item toc-depth-${heading.depth}`}
                data-target={heading.slug}
              >
                <a
                  href={`#${heading.slug}`}
                  class="toc-link"
                  data-toc-link={heading.slug}
                  title={heading.text}
                >
                  <span class="toc-bullet"></span>
                  <span class="toc-text">{heading.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </aside>
)}

<script>
  let tocAbortController: AbortController | null = null;

  function initTableOfContents() {
    if (tocAbortController) {
      tocAbortController.abort();
      tocAbortController = null;
    }

    const nav = document.getElementById("toc-nav");
    if (!nav) return;

    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    const progressBar = document.getElementById("toc-progress-bar");
    const progressText = document.getElementById("toc-progress-text");

    if (links.length === 0) return;

    tocAbortController = new AbortController();
    const { signal } = tocAbortController;

    // Collect all corresponding heading elements
    const headingElements: HTMLElement[] = [];
    links.forEach((link) => {
      const slug = link.getAttribute("data-toc-link");
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    // 1. Smooth scroll with offset for fixed header
    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const slug = link.getAttribute("data-toc-link");
        if (!slug) return;
        const target = document.getElementById(slug);
        if (target) {
          const headerOffset = 90;
          const elementPosition = target.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });

          if (history.pushState) {
            history.pushState(null, "", `#${slug}`);
          }
        }
      }, { signal });
    });

    // 2. Scrollspy and reading progress calculation with requestAnimationFrame
    let ticking = false;
    function updateTocOnScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          ticking = false;
          const scrollY = window.pageYOffset || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? Math.min(100, Math.max(0, Math.round((scrollY / docHeight) * 100))) : 0;

          if (progressBar) progressBar.style.width = `${progress}%`;
          if (progressText) progressText.textContent = `${progress}% read`;

          // Determine active heading
          let activeSlug = "";
          const offsetMargin = 120;

          for (let i = 0; i < headingElements.length; i++) {
            const heading = headingElements[i];
            const rect = heading.getBoundingClientRect();
            if (rect.top <= offsetMargin) {
              activeSlug = heading.id;
            } else {
              break;
            }
          }

          // Default to first heading if none passed the threshold and we're at the top
          if (!activeSlug && headingElements.length > 0 && scrollY < 300) {
            activeSlug = headingElements[0].id;
          }

          // Highlight active link
          links.forEach((link) => {
            const slug = link.getAttribute("data-toc-link");
            const item = link.closest(".toc-item");
            if (slug === activeSlug) {
              link.classList.add("is-active");
              item?.classList.add("is-active");
            } else {
              link.classList.remove("is-active");
              item?.classList.remove("is-active");
            }
          });

          // Keep active heading visible within TOC navigation
          if (activeSlug && nav) {
            const activeItem = nav.querySelector(`.toc-item[data-target="${activeSlug}"]`) as HTMLElement | null;
            if (activeItem) {
              activeItem.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
          }
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", updateTocOnScroll, { passive: true, signal });
    updateTocOnScroll();
  }

  document.addEventListener("astro:page-load", initTableOfContents);
  document.addEventListener("astro:before-swap", () => {
    if (tocAbortController) {
      tocAbortController.abort();
      tocAbortController = null;
    }
  });
</script>

<style lang="scss">
  .toc-sidebar {
    width: 100%;
    position: sticky;
    top: 96px;
    z-index: 20;
    max-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
  }

  .toc-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .toc-card {
    background: #ffffff;
    border: 1px solid #f1f1f4;
    border-radius: 16px;
    padding: 16px 14px 18px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 130px);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 12px;
  }

  .toc-header-main {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toc-icon {
    width: 17px;
    height: 17px;
    color: #FE6019;
  }

  .toc-title {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1f2937;
  }

  .toc-progress-badge {
    font-size: 0.68rem;
    font-weight: 700;
    font-family: monospace;
    padding: 2px 7px;
    background: #fff4ed;
    color: #ea580c;
    border: 1px solid #fed7aa;
    border-radius: 999px;
  }

  .toc-progress-track {
    height: 3px;
    width: 100%;
    background: #f3f4f6;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .toc-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #FE6019, #fb7299);
    border-radius: 999px;
    transition: width 0.15s ease-out;
  }

  .toc-nav {
    overflow-y: auto;
    padding-right: 4px;

    /* Custom subtle scrollbar */
    &::-webkit-scrollbar {
      width: 4px;
    }
    &::-webkit-scrollbar-track {
      background: transparent;
    }
    &::-webkit-scrollbar-thumb {
      background: #e5e7eb;
      border-radius: 4px;
    }
    &::-webkit-scrollbar-thumb:hover {
      background: #d1d5db;
    }
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;

    /* Left continuous guide line */
    &::before {
      content: "";
      position: absolute;
      left: 7px;
      top: 6px;
      bottom: 6px;
      width: 1.5px;
      background: #f1f2f4;
      border-radius: 1px;
    }
  }

  .toc-item {
    position: relative;
    margin-bottom: 2px;

    &.toc-depth-3 {
      padding-left: 14px;

      .toc-link {
        font-size: 0.77rem;
        color: #6b7280;
      }

      .toc-bullet {
        width: 4px;
        height: 4px;
        left: 5px;
      }
    }

    &.is-active {
      .toc-link {
        color: #FE6019;
        font-weight: 600;
        background: #fff8f5;
      }

      .toc-bullet {
        background: #FE6019;
        box-shadow: 0 0 0 3px rgba(254, 96, 25, 0.2);
        transform: translateY(-50%) scale(1.2);
      }
    }
  }

  .toc-link {
    display: flex;
    align-items: center;
    padding: 5px 8px 5px 18px;
    border-radius: 8px;
    font-size: 0.81rem;
    line-height: 1.35;
    color: #4b5563;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;

    &:hover {
      color: #FE6019;
      background: #fafafb;
    }
  }

  .toc-bullet {
    position: absolute;
    left: 4.5px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d1d5db;
    transition: all 0.2s ease;
    z-index: 1;
  }

  .toc-text {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>