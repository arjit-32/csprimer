---
const { title, className = "" } = Astro.props;
---
<details class={`group rounded border border-border ${className}`}>
  <summary class="relative block w-full bg-theme-light px-4 py-3 text-left text-dark cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    {title}
    <svg class="absolute right-4 top-1/2 m-0 h-4 w-4 -translate-y-1/2 transition-transform group-open:rotate-180" viewBox="0 0 512.011 512.011" fill="currentColor">
      <path d="M505.755,123.592c-8.341-8.341-21.824-8.341-30.165,0L256.005,343.176L36.421,123.592c-8.341-8.341-21.824-8.341-30.165,0 s-8.341,21.824,0,30.165l234.667,234.667c4.16,4.16,9.621,6.251,15.083,6.251c5.462,0,10.923-2.091,15.083-6.251l234.667-234.667 C514.096,145.416,514.096,131.933,505.755,123.592z" />
    </svg>
  </summary>
  <div class="px-4 py-3">
    <slot />
  </div>
</details>
