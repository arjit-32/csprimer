---
interface Props {
  href: string;
  style?: string;
  rel?: string;
}

const { href, style, rel } = Astro.props;
const relAttribute = `noopener noreferrer ${rel ? (rel === "follow" ? "" : rel) : "nofollow"}`;
const btnClass = `btn me-4 mb-4 ${
  style === "outline" ? "btn-outline-primary" : "btn-primary"
} border-primary hover:text-white hover:no-underline`;
---

<a
  href={href}
  target="_blank"
  rel={relAttribute}
  class={btnClass}
>
  <slot />
</a>

