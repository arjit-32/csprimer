---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  totalCourses?: number | string;
}

const { totalCourses = "50+" } = Astro.props;
---

<section class="courses-banner relative pt-8 md:pt-12 pb-10 md:pb-14 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-10 lg:mb-0">
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-semibold mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FE6019]"></span>
          Theory & Foundations
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-4">
          Master Tech with <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">Structured</span> Courses
        </h1>

        <!-- Subtitle (Minimal) -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-5">
          Syntax changes, fundamentals don't.
        </p>

        <!-- Minimal Metadata Line -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-xs text-zinc-500 font-medium mb-7">
          <span class="text-zinc-800 font-semibold">{totalCourses} Courses</span>
          <span>•</span>
          <span>5 Structured Tracks</span>
          <span>•</span>
          <span class="text-[#FE6019] font-medium">Free & Open Source</span>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/roadmaps"
            class="btn btn-primary inline-flex items-center gap-2 shadow-sm hover:shadow-md transition-all text-sm font-bold"
          >
            <span>Interactive Roadmaps</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#categoryButtons"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Browse Categories</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Clean Track Hub Representation -->
      <div class="lg:col-6 relative">
        <div class="mx-auto max-w-lg lg:max-w-none">
          <!-- Main Track Representation Card -->
          <div class="bg-white rounded-2xl p-5 sm:p-6 shadow-xl border border-zinc-200/80">
            <!-- Window / Hub Header -->
            <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-zinc-100">
              <div class="flex items-center gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
                <span class="text-xs font-mono font-medium text-zinc-400 ml-1.5">csprimer / learning-tracks</span>
              </div>
              <span class="text-xs font-mono text-zinc-400">5 Tracks Available</span>
            </div>

            <!-- 4 Visual Track Items -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- Track 1: Core CS -->
              <div class="p-3.5 rounded-xl bg-blue-50/50 border border-blue-100 hover:border-blue-300 transition-all">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-base">💻</span>
                  <span class="text-[10px] font-bold text-blue-700 bg-blue-100/70 px-2 py-0.5 rounded-md">Systems</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900">Core Computer Science</h4>
                <p class="text-[11px] text-zinc-500 mt-0.5 line-clamp-1">Processes, Memory & Networking</p>
              </div>

              <!-- Track 2: DSA -->
              <div class="p-3.5 rounded-xl bg-red-50/50 border border-red-100 hover:border-red-300 transition-all">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-base">🌲</span>
                  <span class="text-[10px] font-bold text-red-700 bg-red-100/70 px-2 py-0.5 rounded-md">Algorithms</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900">Data Structures & Algo</h4>
                <p class="text-[11px] text-zinc-500 mt-0.5 line-clamp-1">Arrays, Trees, Graphs & DP</p>
              </div>

              <!-- Track 3: Full-Stack Dev -->
              <div class="p-3.5 rounded-xl bg-emerald-50/50 border border-emerald-100 hover:border-emerald-300 transition-all">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-base">🚀</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100/70 px-2 py-0.5 rounded-md">Full-Stack</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900">Full-Stack Development</h4>
                <p class="text-[11px] text-zinc-500 mt-0.5 line-clamp-1">React, Node.js, SQL & APIs</p>
              </div>

              <!-- Track 4: System Design -->
              <div class="p-3.5 rounded-xl bg-purple-50/50 border border-purple-100 hover:border-purple-300 transition-all">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-base">⚡</span>
                  <span class="text-[10px] font-bold text-purple-700 bg-purple-100/70 px-2 py-0.5 rounded-md">Architecture</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900">System Design</h4>
                <p class="text-[11px] text-zinc-500 mt-0.5 line-clamp-1">Microservices, Caching & Scaling</p>
              </div>
            </div>

            <!-- Footer note inside card -->
            <div class="mt-3.5 pt-3 border-t border-zinc-100 flex items-center justify-between text-[11px] text-zinc-400 font-mono">
              <span>All tracks include practical code examples</span>
              <span class="text-[#FE6019] font-medium font-sans">Self-Paced</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape (Same as Homepage) -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>
