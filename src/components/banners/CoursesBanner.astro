---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  totalCourses?: number | string;
}

const { totalCourses = "50+" } = Astro.props;
---

<section class="courses-banner relative pt-8 md:pt-12 pb-10 md:pb-14 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-10 lg:mb-0">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold uppercase tracking-wider mb-5 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          Structured Lessons
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-5">
          Master Tech with <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">Structured</span> Courses
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-7">
          Go beyond frameworks and syntax. Explore the concepts, architectures, and engineering principles behind the software we build.
        </p>

        <!-- Dynamic Island Stats Pill -->
        <div class="inline-flex flex-wrap items-center gap-2 sm:gap-4 p-2 sm:p-2.5 rounded-2xl bg-white/90 border border-zinc-200 shadow-sm backdrop-blur-sm mb-7">
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold text-zinc-900">{totalCourses} Courses</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-zinc-600">5 Tracks</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-[#FE6019]">100% Free & Open</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/roadmaps"
            class="btn btn-primary inline-flex items-center gap-2 shadow-md hover:shadow-lg transition-all text-sm font-bold"
          >
            <span>Interactive Roadmaps</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#categoryButtons"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Browse Categories</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Dynamic Island & Track Representations -->
      <div class="lg:col-6 relative">
        <div class="course-visual-hub relative mx-auto max-w-lg lg:max-w-none">
          
          <!-- Top Floating Dynamic Island (Active Learning Hub) -->
          <div class="dynamic-island-top absolute -top-4 sm:-top-6 left-1/2 -translate-x-1/2 z-30">
            <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-zinc-900/95 text-white text-xs font-semibold shadow-2xl border border-zinc-700/60 backdrop-blur-md">
              <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-zinc-200 font-mono tracking-wide">Track</span>
              
              <span class="text-zinc-500">|</span>
              <span class="text-emerald-400 font-bold">Courses</span>
              
            </div>
          </div>

          <!-- Main Track Representation Card -->
          <div class="track-card-hub bg-white rounded-3xl p-5 sm:p-7 shadow-xl border border-zinc-200/80 relative z-20 mt-4">
            
            <!-- Mini Hub Header -->
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100">
              <div class="flex items-center gap-2.5">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                <span class="text-xs font-mono font-medium text-zinc-400 ml-1">csprimer</span>
              </div>
              <!-- <span class="text-[11px] font-bold uppercase tracking-wider text-[#FE6019] bg-orange-50 px-2.5 py-0.5 rounded-full border border-orange-200">
                Core Tracks
              </span> -->
            </div>

            <!-- 4 Visual Track Islands -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              
              <!-- Track 1: Core CS -->
              <div class="track-item group p-3.5 rounded-2xl bg-gradient-to-br from-blue-50/70 to-indigo-50/40 border border-blue-200/60 hover:border-blue-400 transition-all hover:shadow-md">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-lg">💻</span>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 bg-blue-100/70 px-2 py-0.5 rounded-full">Systems</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900 group-hover:text-blue-700 transition-colors">Core Computer Science</h4>
                <p class="text-[11px] text-zinc-500 mt-1 line-clamp-1">Processes, Networks & More</p>
                <div class="mt-2.5 flex items-center gap-1.5">
                  <div class="h-1.5 flex-1 bg-blue-100 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-500 rounded-full w-4/5"></div>
                  </div>
                  <span class="text-[10px] font-mono text-blue-600 font-bold">85%</span>
                </div>
              </div>

              <!-- Track 2: DSA -->
              <div class="track-item group p-3.5 rounded-2xl bg-gradient-to-br from-red-50/70 to-rose-50/40 border border-red-200/60 hover:border-red-400 transition-all hover:shadow-md">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-lg">🌲</span>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 bg-red-100/70 px-2 py-0.5 rounded-full">Algorithms</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900 group-hover:text-red-700 transition-colors">Data Structures & Algo</h4>
                <p class="text-[11px] text-zinc-500 mt-1 line-clamp-1">Arrays, Trees, Graphs & More</p>
                <div class="mt-2.5 flex items-center gap-1.5">
                  <div class="h-1.5 flex-1 bg-red-100 rounded-full overflow-hidden">
                    <div class="h-full bg-red-500 rounded-full w-full"></div>
                  </div>
                  <span class="text-[10px] font-mono text-red-600 font-bold">100%</span>
                </div>
              </div>

              <!-- Track 3: Full-Stack Dev -->
              <div class="track-item group p-3.5 rounded-2xl bg-gradient-to-br from-emerald-50/70 to-teal-50/40 border border-emerald-200/60 hover:border-emerald-400 transition-all hover:shadow-md">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-lg">🚀</span>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100/70 px-2 py-0.5 rounded-full">Engineering</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900 group-hover:text-emerald-700 transition-colors">Full-Stack Development</h4>
                <p class="text-[11px] text-zinc-500 mt-1 line-clamp-1">React, Node, SQL & More</p>
                <div class="mt-2.5 flex items-center gap-1.5">
                  <div class="h-1.5 flex-1 bg-emerald-100 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full w-3/4"></div>
                  </div>
                  <span class="text-[10px] font-mono text-emerald-600 font-bold">75%</span>
                </div>
              </div>

              <!-- Track 4: System Design -->
              <div class="track-item group p-3.5 rounded-2xl bg-gradient-to-br from-purple-50/70 to-violet-50/40 border border-purple-200/60 hover:border-purple-400 transition-all hover:shadow-md">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-lg">⚡</span>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-purple-700 bg-purple-100/70 px-2 py-0.5 rounded-full">Architecture</span>
                </div>
                <h4 class="text-sm font-bold text-zinc-900 group-hover:text-purple-700 transition-colors">System Design</h4>
                <p class="text-[11px] text-zinc-500 mt-1 line-clamp-1">Microservices, Caching & More</p>
                <div class="mt-2.5 flex items-center gap-1.5">
                  <div class="h-1.5 flex-1 bg-purple-100 rounded-full overflow-hidden">
                    <div class="h-full bg-purple-500 rounded-full w-4/5"></div>
                  </div>
                  <span class="text-[10px] font-mono text-purple-600 font-bold">80%</span>
                </div>
              </div>

            </div>
          </div>

          <!-- Floating Satellite Dynamic Island 1 (Bottom Left) -->
          <div class="floating-island island-1 absolute -bottom-5 -left-3 sm:-left-6 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-orange-100 text-[#FE6019] text-xs font-black">
                ✓
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">Concise Articles</div>
                <div class="text-[10px] text-zinc-500">Real code & examples</div>
              </div>
            </div>
          </div>

          <!-- Floating Satellite Dynamic Island 2 (Bottom Right) -->
          <div class="floating-island island-2 absolute -bottom-5 -right-3 sm:-right-4 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-purple-100 text-purple-600 text-xs font-black">
                🌲
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">Additional Resources</div>
                <div class="text-[10px] text-zinc-500">Go beyond CSprimer</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape (Same as Homepage) -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>

<style lang="scss">
  .courses-banner {
    position: relative;
  }

  .floating-island {
    animation: floatSmooth 4s ease-in-out infinite;
  }

  .island-2 {
    animation-delay: 2s;
  }

  @keyframes floatSmooth {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
</style>

