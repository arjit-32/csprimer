---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  totalProjects?: number | string;
}

const { totalProjects = "12+" } = Astro.props;
---

<section class="projects-banner relative pt-8 md:pt-10 pb-8 md:pb-12 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-8 lg:mb-0">
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-semibold mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FE6019]"></span>
          Hands-on Engineering
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-4">
          Build Real Systems <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">From Scratch</span>
        </h1>

        <!-- Subtitle (Minimal) -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-5">
          Build production-grade systems, tools, and architectures from scratch.
        </p>

        <!-- Minimal Metadata Line -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-xs text-zinc-500 font-medium mb-6">
          <span class="text-zinc-800 font-semibold">{totalProjects} Projects & Deep Dives</span>
          <span>•</span>
          <span>System Architecture</span>
          <span>•</span>
          <span class="text-[#FE6019] font-medium">Production Grade</span>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#projects-list"
            class="btn btn-primary inline-flex items-center gap-2 shadow-sm hover:shadow-md transition-all text-sm font-bold"
          >
            <span>Explore Projects</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/courses"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Linked Courses</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Minimal HLD Diagram -->
      <div class="lg:col-6 relative">
        <div class="mx-auto max-w-md lg:max-w-none">
          <!-- Minimal HLD Architecture Card -->
          <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-lg border border-zinc-200/90 text-zinc-800">
            <!-- Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-zinc-100">
              <div class="flex items-center gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
                <span class="text-xs font-mono font-medium text-zinc-400 ml-1.5">hld / system-architecture</span>
              </div>
              <span class="text-[11px] font-mono text-zinc-500 bg-zinc-50 border border-zinc-200/70 px-2 py-0.5 rounded">
                High-Level Design
              </span>
            </div>

            <!-- Tier 1: Ingress ➔ Routing ➔ Compute -->
            <div class="flex items-center justify-between gap-1.5 sm:gap-2">
              <!-- Client Node -->
              <div class="flex-1 p-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-center">
                <div class="text-base mb-0.5">📱</div>
                <div class="text-xs font-bold text-zinc-900">Clients</div>
                <div class="text-[10px] text-zinc-400 font-mono">Web / Apps</div>
              </div>

              <!-- Connector Arrow -->
              <div class="text-zinc-300 font-mono text-xs select-none">➔</div>

              <!-- Load Balancer Node -->
              <div class="flex-1 p-2.5 rounded-xl bg-orange-50/70 border border-orange-200/80 text-center">
                <div class="text-base mb-0.5">⚖️</div>
                <div class="text-xs font-bold text-zinc-900">Load Balancer</div>
                <div class="text-[10px] text-[#FE6019] font-mono font-medium">Nginx / ALB</div>
              </div>

              <!-- Connector Arrow -->
              <div class="text-zinc-300 font-mono text-xs select-none">➔</div>

              <!-- App Server Node -->
              <div class="flex-1 p-2.5 rounded-xl bg-blue-50/70 border border-blue-200/80 text-center">
                <div class="text-base mb-0.5">⚙️</div>
                <div class="text-xs font-bold text-zinc-900">App Cluster</div>
                <div class="text-[10px] text-blue-600 font-mono font-medium">API Service</div>
              </div>
            </div>

            <!-- Branch Indicator to Data Tier -->
            <div class="flex items-center justify-between px-3 py-1.5 text-[10px] font-mono text-zinc-400">
              <span class="text-zinc-300">┌─ Client Ingress</span>
              <span class="flex items-center gap-1 text-zinc-500">
                <span>↓ Reads & Writes</span>
              </span>
            </div>

            <!-- Tier 2: Storage & Cache (Split Data Tier) -->
            <div class="grid grid-cols-2 gap-2.5">
              <!-- Redis Cache -->
              <div class="p-2.5 rounded-xl bg-rose-50/60 border border-rose-200/70 flex items-center gap-2.5">
                <span class="text-xl">⚡</span>
                <div>
                  <div class="text-xs font-bold text-zinc-900">Redis Cache</div>
                  <div class="text-[10px] text-rose-600 font-mono font-medium">&lt;1ms In-Memory</div>
                </div>
              </div>

              <!-- Database -->
              <div class="p-2.5 rounded-xl bg-emerald-50/60 border border-emerald-200/70 flex items-center gap-2.5">
                <span class="text-xl">🗄️</span>
                <div>
                  <div class="text-xs font-bold text-zinc-900">PostgreSQL</div>
                  <div class="text-[10px] text-emerald-600 font-mono font-medium">ACID Storage</div>
                </div>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="mt-3 pt-2.5 border-t border-zinc-100 flex items-center justify-between text-[11px] text-zinc-500 font-mono">
              <span>Clients ➔ Gateway ➔ Compute ➔ Data</span>
              <span class="text-[#FE6019] font-medium font-sans">System Design</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>
