---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  totalProjects?: number | string;
}

const { totalProjects = "12+" } = Astro.props;
---

<section class="projects-banner relative pt-8 md:pt-12 pb-10 md:pb-14 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-10 lg:mb-0">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold uppercase tracking-wider mb-5 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          Hands-on Engineering
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-5">
          Build Real Systems <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">From Scratch</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-7">
          Stop copying yet another Youtube project. Rather build engineering mindset by solving real problems faced in industry.
        </p>

        <!-- Dynamic Island Stats Pill -->
        <div class="inline-flex flex-wrap items-center gap-2 sm:gap-4 p-2 sm:p-2.5 rounded-2xl bg-white/90 border border-zinc-200 shadow-sm backdrop-blur-sm mb-7">
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold text-zinc-900">Zero Fluff Projects</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-zinc-600">Architecture-First</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-[#FE6019]">Production Grade</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#projects-list"
            class="btn btn-primary inline-flex items-center gap-2 shadow-md hover:shadow-lg transition-all text-sm font-bold"
          >
            <span>Explore Projects</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/courses"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Linked Courses</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Dynamic Island & Terminal Studio Representation -->
      <div class="lg:col-6 relative">
        <div class="project-visual-hub relative mx-auto max-w-lg lg:max-w-none">
          
          <!-- Top Floating Dynamic Island (Container & Architecture HUD) -->
          <div class="dynamic-island-top absolute -top-4 sm:-top-6 left-1/2 -translate-x-1/2 z-30">
            <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-zinc-900/95 text-white text-xs font-semibold shadow-2xl border border-zinc-700/60 backdrop-blur-md">
              <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-zinc-300 font-mono">DOCKER:</span>
              <span class="text-emerald-400 font-bold">redis-node-01</span>
              <span class="text-zinc-500">|</span>
              <span class="text-zinc-400 text-[11px] font-mono">P99: 0.8ms</span>
            </div>
          </div>

          <!-- Main Terminal / System Architecture Window -->
          <div class="terminal-hub bg-zinc-950 rounded-3xl p-5 sm:p-6 shadow-2xl border border-zinc-800 text-zinc-100 relative z-20 mt-4 font-mono">
            
            <!-- Window Bar -->
            <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-zinc-800">
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-rose-500"></div>
                <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
              </div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-[11px] text-zinc-300">
                <span class="text-[#FE6019]">~/projects/custom-redis</span>
                <span class="text-zinc-500">git:(<span class="text-emerald-400">main</span>)</span>
              </div>
              <span class="text-[10px] text-zinc-500 uppercase tracking-widest hidden sm:inline">x86_64</span>
            </div>

            <!-- Terminal Output Representation -->
            <div class="text-[12px] sm:text-[13px] leading-relaxed space-y-2">
              <div class="flex items-center gap-2 text-zinc-400">
                <span class="text-[#FE6019] font-bold">❯</span>
                <span class="text-zinc-200">cargo run --release -- --port 6379</span>
              </div>
              <div class="text-emerald-400 text-[11px] sm:text-xs">
                [INIT] In-memory storage engine ready (hash-tables + skip-list)
              </div>
              <div class="text-sky-400 text-[11px] sm:text-xs">
                [EPOLL] Multiplexing 10,000 non-blocking client connections
              </div>
              <div class="text-amber-300 text-[11px] sm:text-xs">
                [PERSIST] AOF append-only log synced to NVMe disk
              </div>
              <div class="p-2.5 rounded-xl bg-zinc-900/90 border border-zinc-800/80 mt-3 font-sans">
                <div class="flex items-center justify-between text-xs mb-1.5 font-bold">
                  <span class="text-zinc-300">Benchmark Performance</span>
                  <span class="text-emerald-400 font-mono">154,200 req/sec</span>
                </div>
                <div class="h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-[#FE6019] to-emerald-400 rounded-full w-[92%]"></div>
                </div>
              </div>
            </div>

            <!-- Micro Architecture Diagram Ribbon -->
            <div class="mt-4 pt-3.5 border-t border-zinc-800/80 flex items-center justify-between text-[10px] font-sans text-zinc-400">
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#FE6019]"></span>
                <span>Socket I/O</span>
              </div>
              <span>➔</span>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                <span>Event Loop</span>
              </div>
              <span>➔</span>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Memory Store</span>
              </div>
            </div>
          </div>

          <!-- Floating Dynamic Island 1 (Bottom Left) -->
          <div class="floating-island island-1 absolute -bottom-5 -left-3 sm:-left-6 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-orange-100 text-[#FE6019] text-xs font-black">
                ⚡
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">Custom Protocols & Sockets</div>
                <div class="text-[10px] text-zinc-500">Low-level networking</div>
              </div>
            </div>
          </div>

          <!-- Floating Dynamic Island 2 (Bottom Right) -->
          <div class="floating-island island-2 absolute -bottom-5 -right-3 sm:-right-4 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-emerald-100 text-emerald-600 text-xs font-black">
                🚀
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">Step-by-Step Architecture</div>
                <div class="text-[10px] text-zinc-500">Complete runnable code</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>

<style lang="scss">
  .projects-banner {
    position: relative;
  }

  .floating-island {
    animation: floatSmooth 4s ease-in-out infinite;
  }

  .island-2 {
    animation-delay: 2s;
  }

  @keyframes floatSmooth {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
</style>

