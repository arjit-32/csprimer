---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  currentTag?: string;
  totalQuestions?: number | string;
}

const { currentTag = "all", totalQuestions = "100+" } = Astro.props;
---

<section class="interview-banner relative pt-8 md:pt-12 pb-10 md:pb-14 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-10 lg:mb-0">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold uppercase tracking-wider mb-5 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          High-Yield Technical Prep
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-5">
          Ace Interviews with <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">Interview Bytes</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-7">
          Distilled, high-signal questions across various topics with integrated Anki flashcards for rapid active recall.
        </p>

        <!-- Dynamic Island Stats Pill -->
        <div class="inline-flex flex-wrap items-center gap-2 sm:gap-4 p-2 sm:p-2.5 rounded-2xl bg-white/90 border border-zinc-200 shadow-sm backdrop-blur-sm mb-7">
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold text-zinc-900">{totalQuestions} High-Yield Bytes</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-zinc-600">Active Recall Mode</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-[#FE6019]">100% Free</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-open-anki
            data-anki-topic={currentTag}
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-gradient-to-r from-[#FE6019] to-orange-500 text-white font-bold text-sm shadow-md hover:shadow-xl hover:scale-105 transition-all cursor-pointer group"
            title="Start Anki flashcard session"
          >
            <span class="text-base">⚡</span>
            <span>Revise with Anki Cards</span>
            <span class="text-[10px] font-mono opacity-90 px-2 py-0.5 rounded-full bg-white/20">Active Recall</span>
          </button>
          
          <a
            href="#question-list"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Browse Questions</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Dynamic Island & Flashcard Representation -->
      <div class="lg:col-6 relative">
        <div class="interview-visual-hub relative mx-auto max-w-lg lg:max-w-none">
          
          <!-- Top Floating Dynamic Island (Active Recall HUD) -->
          <div class="dynamic-island-top absolute -top-4 sm:-top-6 left-1/2 -translate-x-1/2 z-30">
            <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-zinc-900/95 text-white text-xs font-semibold shadow-2xl border border-zinc-700/60 backdrop-blur-md">
              <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
              </span>
              <span class="text-zinc-300 font-mono">ANKI SESSION:</span>
              <span class="text-amber-400 font-bold">14-Day Streak</span>
              <span class="text-zinc-500">|</span>
              <span class="text-zinc-400 text-[11px] font-mono">15 Cards Due</span>
            </div>
          </div>

          <!-- 3D Stacked Card Container -->
          <div class="flashcard-deck relative z-20 mt-4">
            
            <!-- Underneath Stack Card (Subtle depth) -->
            <div class="absolute inset-0 bg-orange-100/60 rounded-3xl transform rotate-2 translate-y-3 translate-x-2 border border-orange-200/50 -z-10"></div>
            
            <!-- Main Question Flashcard -->
            <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-xl border border-zinc-200/90 text-zinc-800">
              
              <!-- Card Meta Bar -->
              <div class="flex items-center justify-between pb-3.5 mb-3.5 border-b border-zinc-100">
                <div class="flex items-center gap-2">
                  <span class="px-2.5 py-1 rounded-lg bg-sky-50 border border-sky-200 text-sky-700 text-[11px] font-bold uppercase tracking-wider">
                    Databases
                  </span>
                  <span class="text-zinc-400 text-xs">•</span>
                  <span class="text-zinc-500 text-xs font-semibold">Storage Engines</span>
                </div>
                <span class="text-[11px] font-mono font-bold text-amber-600 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full">
                  Medium-Hard
                </span>
              </div>

              <!-- Question Header -->
              <h3 class="text-base sm:text-lg font-bold font-secondary text-zinc-900 leading-snug mb-3">
                Why do LSM-Trees provide significantly higher write throughput than B-Trees?
              </h3>

              <!-- Architectural Concept Breakdown Island -->
              <div class="p-3.5 rounded-2xl bg-zinc-50 border border-zinc-200/70 space-y-2 mb-4 font-mono text-[11px]">
                <div class="flex items-center justify-between text-zinc-600">
                  <span class="text-rose-600 font-bold">B-Trees:</span>
                  <span class="text-zinc-500">In-place random page writes (I/O bound)</span>
                </div>
                <div class="flex items-center justify-between text-zinc-800 font-bold">
                  <span class="text-emerald-600">LSM-Trees:</span>
                  <span class="text-zinc-900">Append-only WAL + Memory MemTable 🚀</span>
                </div>
              </div>

              <!-- Answer Reveal Hint -->
              <div class="flex items-center justify-between pt-2 text-xs text-zinc-500 border-t border-zinc-100">
                <span class="inline-flex items-center gap-1.5 text-[#FE6019] font-bold">
                  <span>💡 Instant Anki recall test</span>
                </span>
                <span class="text-zinc-400 font-mono text-[11px]">Card #042</span>
              </div>
            </div>
          </div>

          <!-- Floating Satellite Dynamic Island 1 (Bottom Left) -->
          <div class="floating-island island-1 absolute -bottom-5 -left-3 sm:-left-6 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-orange-100 text-[#FE6019] text-xs font-black">
                🎯
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">High-Yield Questions</div>
                <div class="text-[10px] text-zinc-500">System design & low-level CS</div>
              </div>
            </div>
          </div>

          <!-- Floating Satellite Dynamic Island 2 (Bottom Right) -->
          <div class="floating-island island-2 absolute -bottom-5 -right-3 sm:-right-4 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-emerald-100 text-emerald-600 text-xs font-black">
                🧠
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">Spaced Repetition</div>
                <div class="text-[10px] text-zinc-500">Flashcards for long-term memory</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>

<style lang="scss">
  .interview-banner {
    position: relative;
  }

  .floating-island {
    animation: floatSmooth 4s ease-in-out infinite;
  }

  .island-2 {
    animation-delay: 2s;
  }

  @keyframes floatSmooth {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
</style>

