---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  currentTag?: string;
  totalQuestions?: number | string;
}

const { currentTag = "all", totalQuestions = "100+" } = Astro.props;
---

<section class="interview-banner relative pt-8 md:pt-12 pb-10 md:pb-14 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-10 lg:mb-0">
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-semibold mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FE6019]"></span>
          Interview Prep
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-4">
          Ace Interviews with <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">Interview Bytes</span>
        </h1>

        <!-- Subtitle (Minimal) -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-5">
          High-signal questions with built-in Anki flashcards for active recall.
        </p>

        <!-- Minimal Metadata Line -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-xs text-zinc-500 font-medium mb-7">
          <span class="text-zinc-800 font-semibold">{totalQuestions} High-Yield Bytes</span>
          <span>•</span>
          <span>System Design & Core CS</span>
          <span>•</span>
          <span class="text-[#FE6019] font-medium">Anki Flashcard Mode</span>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-open-anki
            data-anki-topic={currentTag}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#FE6019] to-orange-500 text-white font-bold text-sm shadow-sm hover:shadow-md transition-all cursor-pointer group"
            title="Start Anki flashcard session"
          >
            <span>⚡ Revise with Anki Cards</span>
          </button>
          
          <a
            href="#question-list"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Browse Questions</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Clean System Design Flashcard -->
      <div class="lg:col-6 relative">
        <div class="mx-auto max-w-lg lg:max-w-none">
          <!-- Main Question Flashcard -->
          <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-xl border border-zinc-200/90 text-zinc-800">
            <!-- Card Header -->
            <div class="flex items-center justify-between pb-3.5 mb-3.5 border-b border-zinc-100">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-md bg-purple-50 border border-purple-200 text-purple-700 text-[11px] font-bold">
                  System Design • HLD
                </span>
                <span class="text-zinc-400 text-xs">•</span>
                <span class="text-zinc-500 text-xs">High Concurrency</span>
              </div>
              <span class="text-[11px] font-mono text-zinc-500 bg-zinc-100 px-2.5 py-0.5 rounded-md">
                Card #042
              </span>
            </div>

            <!-- Question -->
            <h3 class="text-base sm:text-lg font-bold font-secondary text-zinc-900 leading-snug mb-3">
              How would you design a distributed Rate Limiter to handle 500k requests/sec across regions?
            </h3>

            <!-- Architectural Flow & Solution Snippet -->
            <div class="p-3.5 rounded-xl bg-zinc-50 border border-zinc-200/70 space-y-2 mb-4 text-xs font-mono">
              <div class="flex items-center gap-1.5 text-zinc-700 font-sans font-bold text-[11px] uppercase tracking-wide">
                <span class="w-1.5 h-1.5 rounded-full bg-[#FE6019]"></span>
                Architecture Flow:
              </div>
              <div class="text-[11px] text-zinc-600 bg-white p-2 rounded-lg border border-zinc-200/60 leading-normal">
                Client ➔ API Gateway (Envoy) ➔ Redis Cluster (Sliding Window) ➔ Upstream Services
              </div>
              <div class="pt-1 space-y-1 text-[11px] text-zinc-600">
                <div>• <span class="text-zinc-900 font-semibold">Algorithm:</span> Sliding Window Counter with Redis Lua script for atomicity</div>
                <div>• <span class="text-zinc-900 font-semibold">Resilience:</span> Local memory fallback if Redis cluster latency exceeds 5ms</div>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="flex items-center justify-between pt-2 text-xs text-zinc-500 border-t border-zinc-100">
              <span class="inline-flex items-center gap-1 text-[#FE6019] font-medium">
                <span>💡 Active Recall: Test intuition before revealing</span>
              </span>
              <span class="text-zinc-400 font-mono text-[11px]">Free Always</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>
