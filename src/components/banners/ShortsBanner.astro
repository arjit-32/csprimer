---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  totalSeries?: number | string;
  firstShortHref?: string;
}

const { totalSeries = "6+", firstShortHref = "#series-grid" } = Astro.props;
---

<section class="shorts-banner relative pt-8 md:pt-12 pb-10 md:pb-14 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-10 lg:mb-0">
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-semibold mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FE6019]"></span>
          Quick Learning
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-4">
          Learn Complex Tech in <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">60 Seconds</span>
        </h1>

        <!-- Subtitle (Minimal) -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-5">
          Visual tech breakdowns in 60 seconds or less.
        </p>

        <!-- Minimal Metadata Line -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-xs text-zinc-500 font-medium mb-7">
          <span class="text-zinc-800 font-semibold">{totalSeries} Curated Series</span>
          <span>•</span>
          <span>YouTube Shorts</span>
          <span>•</span>
          <span class="text-[#FE6019] font-medium">Free & Mobile Friendly</span>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={firstShortHref}
            class="btn btn-primary inline-flex items-center gap-2 shadow-sm hover:shadow-md transition-all text-sm font-bold"
          >
            <span>▶ Start Watching</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#series-grid"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Browse All Series</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Clean YouTube Shorts Player Card -->
      <div class="lg:col-6 relative">
        <div class="mx-auto max-w-sm sm:max-w-md lg:max-w-none flex justify-center">
          <!-- YouTube Shorts Card Container -->
          <div class="w-72 sm:w-80 rounded-2xl bg-zinc-950 p-4 shadow-2xl border border-zinc-800 text-white relative">
            <!-- Shorts Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-zinc-800/80">
              <div class="flex items-center gap-2">
                <!-- Red YouTube Shorts Icon -->
                <svg class="w-5 h-5 text-red-600" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M10 14.65v-5.3L15 12l-5 2.65zm7.8-6.17c-.4-1.22-1.37-2.18-2.6-2.58C13.02 5.37 8 5.37 8 5.37s-5.02 0-7.2.5c-1.23.4-2.2 1.36-2.6 2.58C-2.3 10.65-2.3 12-2.3 12s0 1.35.5 3.52c.4 1.23 1.37 2.18 2.6 2.58 2.18.5 7.2.5 7.2.5s5.02 0 7.2-.5c1.23-.4 2.2-1.35 2.6-2.58.5-2.17.5-3.52.5-3.52s0-1.35-.5-3.52zM17.8 17.5c-.23.72-.8 1.28-1.52 1.5-1.4.38-4.28.38-4.28.38s-2.88 0-4.28-.38c-.72-.22-1.3-.78-1.52-1.5-.38-1.4-.38-4.32-.38-4.32s0-2.92.38-4.32c.22-.72.8-1.28 1.52-1.5 1.4-.38 4.28-.38 4.28-.38s2.88 0 4.28.38c.72.22 1.3.78 1.52 1.5.38 1.4.38 4.32.38 4.32s0 2.92-.38 4.32z"/>
                </svg>
                <span class="text-xs font-bold tracking-wide">YouTube Shorts</span>
              </div>
              <span class="text-[10px] font-mono text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded">60s Series</span>
            </div>

            <!-- Video Thumbnail & Content Area -->
            <div class="relative rounded-xl bg-gradient-to-b from-zinc-900 to-zinc-950 p-4 border border-zinc-800/80 min-h-[300px] flex flex-col justify-between">
              <!-- Topic Tag -->
              <div>
                <span class="inline-block px-2 py-0.5 rounded bg-red-600/20 border border-red-500/40 text-red-400 text-[10px] font-bold uppercase tracking-wider">
                  System Design
                </span>
              </div>

              <!-- Graphic / Concept Simulation in Video -->
              <div class="my-auto py-3 text-center space-y-2.5">
                <!-- Center Play Button -->
                <div class="w-12 h-12 rounded-full bg-white/90 text-zinc-900 shadow-xl mx-auto flex items-center justify-center hover:scale-105 transition-transform cursor-pointer">
                  <svg class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
                <div class="p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800 text-[11px] font-mono text-zinc-300">
                  Call Stack ➔ Libuv Threadpool ➔ Event Loop
                </div>
              </div>

              <!-- Shorts Video Overlay Info -->
              <div class="space-y-1.5 text-left">
                <div class="flex items-center gap-1.5 text-xs font-bold text-white">
                  <span>@CSPrimer</span>
                  <span class="text-[10px] text-zinc-400">✓</span>
                </div>
                <p class="text-xs font-medium text-zinc-200 line-clamp-2 leading-snug">
                  How the Node.js Event Loop handles 10,000 concurrent requests in 60s #shorts
                </p>
                <div class="text-[10px] text-zinc-400">
                  #systemdesign #nodejs #csfundamentals
                </div>
              </div>

              <!-- Right Vertical Action Icons (Classic Shorts Style) -->
              <div class="absolute right-3 bottom-14 flex flex-col items-center gap-3 text-zinc-300 text-[10px]">
                <div class="flex flex-col items-center gap-0.5">
                  <span class="w-7 h-7 rounded-full bg-zinc-800/80 flex items-center justify-center text-xs">👍</span>
                  <span>14K</span>
                </div>
                <div class="flex flex-col items-center gap-0.5">
                  <span class="w-7 h-7 rounded-full bg-zinc-800/80 flex items-center justify-center text-xs">💬</span>
                  <span>340</span>
                </div>
                <div class="flex flex-col items-center gap-0.5">
                  <span class="w-7 h-7 rounded-full bg-zinc-800/80 flex items-center justify-center text-xs">↗</span>
                  <span>Share</span>
                </div>
              </div>
            </div>

            <!-- YouTube Red Scrubber Progress Line -->
            <div class="mt-3 h-1 w-full bg-zinc-800 rounded-full overflow-hidden">
              <div class="h-full bg-red-600 rounded-full w-[65%]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>
