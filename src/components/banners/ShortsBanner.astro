---
import { Image } from "astro:assets";
import bannerShapeImg from "@/assets/images/banner-shape.png";

interface Props {
  totalSeries?: number | string;
  firstShortHref?: string;
}

const { totalSeries = "6+", firstShortHref = "#series-grid" } = Astro.props;
---

<section class="shorts-banner relative pt-8 md:pt-12 pb-10 md:pb-14 overflow-hidden border-b border-zinc-200/80 bg-gradient-to-b from-white via-orange-50/20 to-[#fafafa]">
  <!-- Subtle ambient background glow -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="row items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-6 mb-10 lg:mb-0">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold uppercase tracking-wider mb-5 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          60-Second Video Learning
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold font-secondary text-zinc-900 leading-[1.18] tracking-tight mb-5">
          Learn Complex Tech in <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-[#fb7299]">60 Seconds</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mb-7">
          Learn while doom-scrolling. Bite-sized visual breakdowns of Operating Systems, System Design, DSA, and Web Internals. No filler, pure intuition in under a minute.
        </p>

        <!-- Dynamic Island Stats Pill -->
        <div class="inline-flex flex-wrap items-center gap-2 sm:gap-4 p-2 sm:p-2.5 rounded-2xl bg-white/90 border border-zinc-200 shadow-sm backdrop-blur-sm mb-7">
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            <span class="text-xs font-bold text-zinc-900">{totalSeries} Curated Series</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-zinc-600">60s Micro-Lessons</span>
          </div>
          <span class="text-zinc-300 hidden sm:inline">•</span>
          <div class="flex items-center gap-2 px-3 py-1">
            <span class="text-xs font-semibold text-[#FE6019]">Mobile Friendly</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={firstShortHref}
            class="btn btn-primary inline-flex items-center gap-2 shadow-md hover:shadow-lg transition-all text-sm font-bold"
          >
            <span>▶ Start Watching</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#series-grid"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 text-sm font-bold border border-zinc-200 transition-all"
          >
            <span>Browse All Series</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Smartphone Mockup with Real Dynamic Island -->
      <div class="lg:col-6 relative">
        <div class="shorts-visual-hub relative mx-auto max-w-sm sm:max-w-md lg:max-w-none flex justify-center">
          
          <!-- Smartphone Outer Frame -->
          <div class="phone-frame w-72 sm:w-80 rounded-[44px] bg-zinc-950 p-3.5 shadow-2xl border-4 border-zinc-800/90 relative z-20">
            
            <!-- Phone Screen -->
            <div class="phone-screen rounded-[36px] bg-gradient-to-b from-zinc-900 to-zinc-950 p-4 pt-3 overflow-hidden relative border border-zinc-800 flex flex-col justify-between min-h-[380px]">
              
              <!-- THE DYNAMIC ISLAND (Phone Notch Dynamic Island) -->
              <div class="dynamic-island-notch mx-auto mb-4 z-30">
                <div class="inline-flex items-center justify-between gap-3 px-3 py-1.5 rounded-full bg-black text-white text-[11px] shadow-lg border border-zinc-800 w-52">
                  <!-- Left camera circle -->
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-zinc-800 border border-zinc-700"></span>
                    <span class="text-[#FE6019] font-bold text-[10px]">▶ LIVE</span>
                  </div>

                  <!-- Animated Sound Wave Bars -->
                  <div class="sound-wave flex items-center gap-0.5">
                    <span class="bar bar-1"></span>
                    <span class="bar bar-2"></span>
                    <span class="bar bar-3"></span>
                    <span class="bar bar-4"></span>
                  </div>

                  <!-- Time -->
                  <span class="font-mono text-zinc-400 text-[10px]">0:42</span>
                </div>
              </div>

              <!-- Reel Card Preview Content -->
              <div class="reel-content my-auto space-y-3">
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#FE6019]/20 border border-[#FE6019]/40 text-[#FE6019] text-[10px] font-bold uppercase tracking-wider">
                  🔥 System Design
                </div>

                <h4 class="text-sm font-bold text-white font-secondary leading-snug">
                  How Redis LRU Eviction Cleans Memory in O(1)
                </h4>

                <!-- Mini Architecture Diagram Graphic -->
                <div class="p-3 rounded-2xl bg-zinc-900/90 border border-zinc-800/80 text-[11px] font-mono space-y-2">
                  <div class="flex items-center justify-between text-zinc-400 text-[10px]">
                    <span>Cache Hit: 99.4%</span>
                    <span class="text-emerald-400 font-bold">RAM: 4.2 GB</span>
                  </div>
                  <!-- Visual Memory Block -->
                  <div class="flex gap-1">
                    <div class="flex-1 h-5 rounded-md bg-emerald-500/80 flex items-center justify-center text-[9px] text-white font-bold">Hot Key</div>
                    <div class="flex-1 h-5 rounded-md bg-blue-500/80 flex items-center justify-center text-[9px] text-white font-bold">Session</div>
                    <div class="w-14 h-5 rounded-md bg-rose-500/80 flex items-center justify-center text-[9px] text-white font-bold animate-pulse">Evict</div>
                  </div>
                </div>
              </div>

              <!-- Bottom Video Controls & Engagement -->
              <div class="reel-footer pt-3 border-t border-zinc-800/80">
                <!-- Video Progress Bar -->
                <div class="h-1 w-full bg-zinc-800 rounded-full overflow-hidden mb-3">
                  <div class="h-full bg-gradient-to-r from-[#FE6019] to-rose-500 rounded-full w-[70%]"></div>
                </div>
                <!-- Action Pills -->
                <div class="flex items-center justify-between text-[11px] text-zinc-400">
                  <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1 hover:text-white transition-colors cursor-pointer">
                      ❤️ 4.8k
                    </span>
                    <span class="flex items-center gap-1 hover:text-white transition-colors cursor-pointer">
                      💬 320
                    </span>
                  </div>
                  <span class="text-zinc-500 font-mono text-[10px]">60 FPS • HD</span>
                </div>
              </div>

            </div>
          </div>

          <!-- Floating Satellite Dynamic Island 1 (Left) -->
          <div class="floating-island island-1 absolute top-20 -left-6 sm:-left-10 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-rose-100 text-rose-600 text-xs font-black">
                ⚡
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">Zero Fluff</div>
                <div class="text-[10px] text-zinc-500">60-second concept density</div>
              </div>
            </div>
          </div>

          <!-- Floating Satellite Dynamic Island 2 (Right) -->
          <div class="floating-island island-2 absolute bottom-12 -right-4 sm:-right-8 z-30">
            <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-2xl bg-white/95 border border-zinc-200/90 shadow-lg backdrop-blur-md">
              <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-orange-100 text-[#FE6019] text-xs font-black">
                🎧
              </span>
              <div>
                <div class="text-[11px] font-bold text-zinc-900">Visual Audio Sync</div>
                <div class="text-[10px] text-zinc-500">Intuitive mental models</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Shape -->
  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none opacity-80"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>

<style lang="scss">
  .shorts-banner {
    position: relative;
  }

  .sound-wave {
    .bar {
      display: inline-block;
      width: 2px;
      border-radius: 2px;
      background: #FE6019;
      animation: soundJump 1s ease-in-out infinite alternate;
    }
    .bar-1 { height: 10px; animation-delay: 0.1s; }
    .bar-2 { height: 14px; animation-delay: 0.3s; }
    .bar-3 { height: 8px;  animation-delay: 0.2s; }
    .bar-4 { height: 12px; animation-delay: 0.4s; }
  }

  @keyframes soundJump {
    0% { height: 4px; }
    100% { height: 14px; }
  }

  .floating-island {
    animation: floatSmooth 4s ease-in-out infinite;
  }

  .island-2 {
    animation-delay: 2s;
  }

  @keyframes floatSmooth {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
</style>

