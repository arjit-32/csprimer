---
interface Props {
  id: string; // The unique ID for the star functionality
  issueTitle?: string; // Title for the GitHub issue (e.g. article title)
  issueUrl?: string; // The page URL to include in the issue body
}

const { id, issueTitle, issueUrl } = Astro.props;

const GITHUB_REPO = "https://github.com/arjit-32/csprimer";
const issueParams = new URLSearchParams({
  template: "content_issue.yml",
  title: `[Content Issue]: ${issueTitle || ""}`,
  page_url: issueUrl || "",
});
const reportIssueHref = `${GITHUB_REPO}/issues/new?${issueParams.toString()}`;
---

<div class="item-actions">
  <button
    class="action-btn star-btn"
    data-id={id}
    title="Save to starred"
    aria-label="Star this content"
  >
    <svg class="star-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>
    <span class="action-label">Star</span>
  </button>

  {issueTitle && (
    <a
      href={reportIssueHref}
      target="_blank"
      rel="noopener noreferrer"
      class="action-btn report-issue-btn"
      title="Report an issue with this content"
      aria-label="Report Issue"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span class="action-label">Report Issue</span>
    </a>
  )}
</div>

<script>
  const STARRED_KEY = 'ib_starred';

  function getStarred() {
    try { return JSON.parse(localStorage.getItem(STARRED_KEY) || '[]'); }
    catch { return []; }
  }
  
  function saveStarred(arr: string[]): void {
    localStorage.setItem(STARRED_KEY, JSON.stringify(arr));
  }

  // Sync starred filter (mostly for interview-bytes page)
  function syncStarredFilter() {
    const starred = getStarred();
    const btn = document.getElementById('starred-filter-btn');
    const countEl = document.getElementById('starred-filter-count');
    if (!btn || !countEl) return;
    if (starred.length > 0) {
      btn.classList.remove('hidden');
      countEl.textContent = starred.length.toString();
    } else {
      btn.classList.add('hidden');
      btn.classList.remove('active-starred');
      document.querySelectorAll('.question-item').forEach(el => { (el as HTMLElement).style.display = ''; });
    }
  }

  function renderStarState() {
    const starred = getStarred();
    document.querySelectorAll('.star-btn').forEach(btn => {
      const el = btn as HTMLElement;
      const id = el.dataset.id;
      if (!id) return;
      el.classList.toggle('is-starred', starred.includes(id));
    });
  }

  function handleDocumentClick(e: Event) {
    const target = e.target as HTMLElement;

    // Handle Star Button Click
    const starBtn = target.closest('.star-btn') as HTMLElement;
    if (starBtn) {
      const id = starBtn.dataset.id;
      if (id) {
        const current = getStarred();
        const idx = current.indexOf(id);
        if (idx === -1) { current.push(id); starBtn.classList.add('is-starred'); }
        else { current.splice(idx, 1); starBtn.classList.remove('is-starred'); }
        saveStarred(current);
        syncStarredFilter();

        const filterBtn = document.getElementById('starred-filter-btn');
        if (filterBtn?.classList.contains('active-starred')) {
          const nowStarred = getStarred();
          document.querySelectorAll('.question-item').forEach(item => {
            const itemEl = item as HTMLElement;
            itemEl.style.display = nowStarred.includes(itemEl.dataset.questionId || '') ? '' : 'none';
          });
        }
      }
      return;
    }
  }

  function init() {
    renderStarState();
    
    // Remove previous listener if it exists to avoid duplicates in Astro ViewTransitions
    document.removeEventListener('click', (document as any)['__actionButtonsClickHandler']);
    (document as any)['__actionButtonsClickHandler'] = handleDocumentClick;
    document.addEventListener('click', handleDocumentClick);
  }

  (window as any).initActionButtons = renderStarState;

  document.addEventListener('astro:page-load', init);
</script>

<style lang="scss" is:global>
  /* ── Action Buttons ── */
  .item-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    border: 1px solid #efefef;
    background: #fafafa;
    color: #a0a0a0;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;

    &:hover {
      border-color: #ddd;
      background: #fff;
      color: #444;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    }

    .action-label {
      @media (max-width: 600px) { display: none; }
    }
  }


  /* Star */
  .star-btn {
    &.is-starred {
      background: #fffbeb;
      border-color: #fde68a;
      color: #d97706;

      .star-icon { fill: #f59e0b; stroke: #f59e0b; }

      &:hover { background: #fef3c7; border-color: #fcd34d; }
    }
  }

  /* Edit */
  .edit-btn:hover { color: #1a1a1a; }

  /* Report Issue */
  .report-issue-btn {
    text-decoration: none;

    &:hover {
      border-color: #fca5a5;
      background: #fef2f2;
      color: #dc2626;
    }
  }
</style>
