---
// VideoFeatureBanner.astro - Platform Overview & Features
---

<section class="section video-showcase relative py-12 md:py-16 bg-gradient-to-b from-white via-[#fcfbf9] to-[#fafafa] overflow-hidden border-y border-zinc-100">
  <div class="container mx-auto px-4 max-w-6xl relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold uppercase tracking-wider mb-3 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
        Platform Overview
      </div>
      <h2 class="text-3xl md:text-5xl font-black font-secondary text-zinc-900 tracking-tight">
        Everything You Need to Master Software Engineering
      </h2>
      <p class="text-zinc-600 text-base md:text-lg mt-3 leading-relaxed">
        CSPrimer bridges the gap between deep computer science fundamentals, modern full-stack development, and tech interview preparation.
      </p>
    </div>

    <!-- Video Container -->
    <div class="relative mx-auto max-w-4xl">
      <!-- Glow effect behind video -->
      <div class="absolute -inset-2 bg-gradient-to-r from-orange-500/20 via-pink-500/20 to-amber-500/20 rounded-3xl blur-2xl -z-10 opacity-70"></div>

      <div class="relative rounded-2xl overflow-hidden bg-zinc-950 border border-zinc-200/80 shadow-2xl">
        <div class="aspect-video w-full">
          <iframe 
            class="w-full h-full"
            src="https://www.youtube.com/embed/CrQ-oSLW10A?rel=0&showinfo=0"
            title="CSPrimer Platform Overview"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>

    <!-- 3 Core Feature Cards Representing the Site -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 max-w-5xl mx-auto">
      
      <!-- Feature 1: Roadmaps -->
      <a 
        href="/roadmaps" 
        class="group relative flex flex-col justify-between p-6 bg-white rounded-2xl border border-zinc-200 shadow-sm hover:border-[#FE6019] hover:shadow-xl hover:-translate-y-1 transition-all duration-200 no-underline"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 border border-orange-100 flex items-center justify-center text-[#FE6019] group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#FE6019] bg-orange-50 px-2.5 py-1 rounded-full border border-orange-200">
              Roadmaps
            </span>
          </div>
          <h3 class="text-xl font-bold font-secondary text-zinc-900 group-hover:text-[#FE6019] transition-colors mb-2">
            Structured Skill Trees
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Follow dependency-linked tracks across Core CS, DSA, Fullstack, and System Design to learn in the right order.
          </p>
        </div>
        <div class="mt-5 pt-4 border-t border-zinc-100 flex items-center gap-1.5 text-sm font-bold text-[#FE6019]">
          <span>Explore Roadmaps</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- Feature 2: Deep Dive Courses -->
      <a 
        href="/courses" 
        class="group relative flex flex-col justify-between p-6 bg-white rounded-2xl border border-zinc-200 shadow-sm hover:border-[#FE6019] hover:shadow-xl hover:-translate-y-1 transition-all duration-200 no-underline"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-pink-50 border border-pink-100 flex items-center justify-center text-pink-600 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-pink-600 bg-pink-50 px-2.5 py-1 rounded-full border border-pink-200">
              Series
            </span>
          </div>
          <h3 class="text-xl font-bold font-secondary text-zinc-900 group-hover:text-[#FE6019] transition-colors mb-2">
            In-Depth Video Series
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Multi-part courses with accompanying articles, code repos, and deep conceptual breakdowns from the ground up.
          </p>
        </div>
        <div class="mt-5 pt-4 border-t border-zinc-100 flex items-center gap-1.5 text-sm font-bold text-[#FE6019]">
          <span>Browse Courses</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- Feature 3: Interview Bytes -->
      <a 
        href="/interview-bytes" 
        class="group relative flex flex-col justify-between p-6 bg-white rounded-2xl border border-zinc-200 shadow-sm hover:border-[#FE6019] hover:shadow-xl hover:-translate-y-1 transition-all duration-200 no-underline"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
              Interview Bytes
            </span>
          </div>
          <h3 class="text-xl font-bold font-secondary text-zinc-900 group-hover:text-[#FE6019] transition-colors mb-2">
            Interview Preparation
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Targeted Q&A bytes and active-recall flashcards so you can explain concepts clearly without getting caught off guard.
          </p>
        </div>
        <div class="mt-5 pt-4 border-t border-zinc-100 flex items-center gap-1.5 text-sm font-bold text-[#FE6019]">
          <span>Practice Interview Bytes</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

    </div>
  </div>
</section>
