---
import { markdownify } from "@/lib/utils/textConverter";
---
<h2 class="text-center mt-8 mb-2 text-3xl font-bold">About CSPrimer</h2>
     
<section class="video-showcase py-6 relative overflow-hidden">
  <div class="container mx-auto px-4">
    
    <!-- Platform description card -->
    <div class="platform-info absolute top-0 left-12 max-w-xs bg-white/95 backdrop-blur-md p-5 rounded-lg shadow-lg z-20 border-l-4 border-primary-500">
      <h4 class="text-lg font-semibold text-primary-700 mb-2">About the Platform</h4>
      <p class="text-sm text-gray-700 leading-relaxed">CS-Primer helps developers bridge the gap of development, core cs, interview prep, all into a structured roadmap.</p>
    </div>
    
    <div class="video-wrapper relative mx-auto max-w-3xl mt-8">
      <!-- Main video container with enhanced shadow -->
      <div class="video-container relative rounded-xl overflow-hidden">
        <div class="aspect-video relative z-10">
          <iframe 
            class="absolute inset-0 w-full h-full"
            src={`https://www.youtube.com/embed/CrQ-oSLW10A?rel=0&showinfo=0`}
            title="What is this platform about ?"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        
        <!-- Enhanced shadow effect -->
        <div class="video-shadow absolute -bottom-12 left-0 right-0 h-36 bg-gradient-to-t from-black/40 to-transparent blur-3xl z-0"></div>
      </div>
      
      <!-- Multiple feature cards - repositioned to be fully visible -->
      <div class="feature-cards grid grid-cols-1 md:grid-cols-3 gap-4 mt-20 relative z-20">
        <!-- Feature Card 1 -->
        <div class="feature-card bg-white/90 backdrop-blur-sm px-5 py-4 rounded-lg shadow-xl transform rotate-[-2deg] hover:rotate-0 transition-transform">
          <div class="flex items-center mb-2">
            <span class="w-8 h-8 flex items-center justify-center bg-primary-100 rounded-full text-primary-600 mr-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <h5 class="text-sm font-semibold text-gray-800">Roadmap</h5>
          </div>
          <p class="text-xs text-gray-700" set:html={markdownify("Checkout **Roadmap** to becoming a complete engineer")} />
        </div>
        
        <!-- Feature Card 2 -->
        <div class="feature-card bg-white/90 backdrop-blur-sm px-5 py-4 rounded-lg shadow-xl transform rotate-[1deg] hover:rotate-0 transition-transform">
          <div class="flex items-center mb-2">
            <span class="w-8 h-8 flex items-center justify-center bg-primary-100 rounded-full text-primary-600 mr-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </span>
            <h5 class="text-sm font-semibold text-gray-800">Series</h5>
          </div>
          <p class="text-xs text-gray-700">Checkout written articles and corresponding <b>video series</b>.</p>
        </div>
        
        <!-- Feature Card 3 -->
        <div class="feature-card bg-white/90 backdrop-blur-sm px-5 py-4 rounded-lg shadow-xl transform rotate-[3deg] hover:rotate-0 transition-transform">
          <div class="flex items-center mb-2">
            <span class="w-8 h-8 flex items-center justify-center bg-primary-100 rounded-full text-primary-600 mr-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </span>
            <h5 class="text-sm font-semibold text-gray-800">Interview Bytes</h5>
          </div>
          <p class="text-xs text-gray-700">Quick <b>question & answers</b> so you dont fumble in your dev interviews.</p>
        </div>
      </div>
      
      <!-- Decorative dots -->
      <div class="decorative-dots absolute -left-12 top-1/3 flex flex-col gap-2 opacity-60">
        <span class="w-2 h-2 rounded-full bg-primary-500"></span>
        <span class="w-2 h-2 rounded-full bg-primary-500"></span>
        <span class="w-2 h-2 rounded-full bg-primary-500"></span>
      </div>
    </div>
  </div>
  
  <!-- Enhanced background decorative elements -->
  <div class="absolute -z-10 top-1/4 right-0 w-64 h-64 bg-gradient-radial from-primary-100 to-transparent opacity-50 blur-3xl"></div>
  <div class="absolute -z-10 bottom-1/4 left-0 w-48 h-48 bg-gradient-radial from-secondary-100 to-transparent opacity-40 blur-2xl"></div>
</section>

<style>
  .video-showcase {
    --primary-100: rgba(59, 130, 246, 0.1);
    --primary-500: rgba(59, 130, 246, 1);
    --primary-600: rgba(37, 99, 235, 1);
    --primary-700: rgba(29, 78, 216, 1);
    --secondary-100: rgba(249, 168, 212, 0.1);
    padding-bottom: 4rem; /* Added extra padding at bottom to ensure cards are visible */
  }
  
  .video-container {
    box-shadow: 0 40px 70px -20px rgba(0, 0, 0, 0.5), 
                0 25px 40px -15px rgba(0, 0, 0, 0.4),
                0 10px 20px -5px rgba(0, 0, 0, 0.3);
    transform: perspective(1000px) rotateX(1deg);
  }
  
  .platform-info {
    transform: translateY(-5px);
    animation: float 6s ease-in-out infinite;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 
                0 5px 10px -5px rgba(0, 0, 0, 0.05);
  }
  
  .feature-card {
    transition: all 0.3s ease;
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.2), 
                0 5px 15px -5px rgba(0, 0, 0, 0.1);
  }
  
  .feature-card:hover {
    transform: translateY(-5px) rotate(0);
    box-shadow: 0 25px 35px -12px rgba(0, 0, 0, 0.25), 
                0 15px 20px -10px rgba(0, 0, 0, 0.15);
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(-5px); }
    50% { transform: translateY(0); }
  }
  
  @media (max-width: 768px) {
    .platform-info {
      position: relative;
      top: 0;
      left: 0;
      margin: 0 auto 1.5rem;
      max-width: 100%;
    }
    
    .feature-cards {
      margin-top: 1.5rem;
      gap: 1rem;
    }
    
    .decorative-dots {
      display: none;
    }
    
    .video-wrapper {
      max-width: 90%;
      margin-top: 1rem;
    }
    
    .video-showcase {
      padding-bottom: 2rem;
    }
  }
  
  /* For browsers that support it */
  @supports (background: radial-gradient(circle, var(--primary-100), transparent)) {
    .bg-gradient-radial {
      background: radial-gradient(circle, var(--primary-100), transparent);
    }
  }
</style>