---
import config from "@/config/config.json";
import { Image } from "astro:assets";
import defaultLogo from "@/assets/images/logo.png";

const { src } = Astro.props;
const {
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const widthNum = Number(String(logo_width).replace("px", "")) || 80;
const heightNum = Number(String(logo_height).replace("px", "")) || 80;
---

<a href="/" class="navbar-brand block">
  {
    src ? (
      <img
        src={src}
        alt={title}
        width={widthNum * 2}
        height={heightNum * 2}
        style={{
          height: `${heightNum}px`,
          width: `${widthNum}px`,
        }}
        loading="lazy"
        decoding="async"
      />
    ) : defaultLogo ? (
      <Image
        width={widthNum * 2}
        height={heightNum * 2}
        src={defaultLogo}
        alt={title}
        style={{
          height: `${heightNum}px`,
          width: `${widthNum}px`,
        }}
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
