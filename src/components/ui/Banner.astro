---
import { Image } from "astro:assets";
import bannerImg from "@/assets/images/banner-img.png";
import bannerShapeImg from "@/assets/images/banner-shape.png";
---

<section class="section banner relative pt-8 md:pt-12 pb-12 overflow-hidden">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="row items-center">
      <div class="lg:col-6 mb-10 lg:mb-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold tracking-wider mb-4 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          CS Fundamentals to Production Systems
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-black font-secondary text-zinc-900 leading-[1.18] tracking-tight">
          Become a <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE6019] via-orange-500 to-amber-500">Complete</span> Software Engineer
        </h1>
        <p class="mt-5 text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl">
          Master the full spectrum of modern engineering - from foundational CS and system design to AI Engineering.
        </p>
        
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary shadow-md hover:shadow-lg transition-all" href="/roadmaps">
            Explore Roadmaps
          </a>
          <a class="btn btn-outline-primary transition-all" href="/courses">
            Browse Courses
          </a>
        </div>
      </div>

      <div class="lg:col-6">
        <Image
          class="w-full object-contain drop-shadow-md"
          alt="CSPrimer Software Engineer Learning Tracks"
          src={bannerImg}
          fetchpriority="high"
          loading="eager"
          width={603}
          height={396}
        />
      </div>
    </div>
  </div>

  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%] pointer-events-none"
    alt="banner background shape"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>
