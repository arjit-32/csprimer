---
import RoadmapNode from "./RoadmapNode.astro";

interface Props {
  roadmap?: any;
  title: string;
}

const { roadmap, title } = Astro.props;
const layout = roadmap?.layout || "linear";
const normalizedPaths = Array.isArray(roadmap?.paths) && roadmap.paths.length > 0
  ? roadmap.paths
  : [{ id: `${title}-default`, title: "Learning path", courses: roadmap?.courses || [] }];
---

<div class="interactive-roadmap-wrapper w-full max-w-5xl mx-auto py-12 px-4 animate-in fade-in duration-700">
  <div class="flex flex-col md:flex-row justify-between items-center mb-16 gap-6 bg-white/80 backdrop-blur-md p-6 md:p-8 rounded-3xl border border-blue-50/50 shadow-xl shadow-blue-900/5">
    <div class="flex flex-col items-center md:items-start gap-2 text-center md:text-left">
      <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.24em] text-blue-700">Roadmap</span>
      <h3 class="text-2xl md:text-3xl font-black text-zinc-900 tracking-tight leading-tight">{title}</h3>
    </div>

    <div class="progress-stats flex items-center gap-6">
      <div class="relative w-28 h-28 flex items-center justify-center">
        <svg class="w-full h-full transform -rotate-90 filter drop-shadow-sm">
          <circle cx="56" cy="56" r="50" stroke="currentColor" stroke-width="8" fill="transparent" class="text-zinc-100" />
          <circle
            id={`roadmap-progress-circle-${title.replace(/\s+/g, '-')}`}
            cx="56"
            cy="56"
            r="50"
            stroke="currentColor"
            stroke-width="8"
            stroke-dasharray="314"
            stroke-dashoffset="314"
            fill="transparent"
            stroke-linecap="round"
            class="text-blue-600 transition-all duration-1000 ease-out category-progress-circle"
          />
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span id={`roadmap-progress-percent-${title.replace(/\s+/g, '-')}`} class="text-2xl font-black text-zinc-900 leading-none category-progress-text">0%</span>
          <span class="text-[9px] text-zinc-400 uppercase font-black tracking-widest mt-1">Done</span>
        </div>
      </div>
    </div>
  </div>

  {layout === "linear" && (
    <div class="roadmap-path relative flex flex-col items-center gap-12 roadmap-track" data-roadmap-layout="linear" data-roadmap-id={normalizedPaths[0]?.id || `${title}-default`}>
      <div class="absolute left-1/2 top-0 bottom-0 w-1.5 bg-zinc-100 transform -translate-x-1/2 hidden md:block rounded-full z-0">
        <div class="path-progress-fill w-full bg-blue-500 rounded-full transition-all duration-1000 origin-top h-0"></div>
      </div>

      {(normalizedPaths[0]?.courses || []).map((course: any, idx: number) => (
        <div class="w-full relative flex justify-center pb-8 last:pb-0 z-10" data-course-container={course.id}>
          <div class="w-full max-w-md flex justify-center">
            <RoadmapNode course={course} />
          </div>
          {idx < (normalizedPaths[0]?.courses || []).length - 1 && (
            <div class="absolute left-1/2 bottom-[-16px] w-4 h-4 rounded-full bg-zinc-200 border-4 border-white shadow-sm transform -translate-x-1/2 z-10 hidden md:block"></div>
          )}
        </div>
      ))}

      {!(normalizedPaths[0]?.courses || []).length && (
        <div class="w-full rounded-2xl border border-dashed border-zinc-200 bg-zinc-50 px-6 py-12 text-center text-zinc-500">
          No courses are available in this roadmap yet.
        </div>
      )}
    </div>
  )}

  {layout === "branching" && (
    <div class="roadmap-branch-board-wrapper rounded-3xl border border-zinc-200/80 bg-gradient-to-br from-zinc-50 via-white to-blue-50/40 p-3">
      <div class="roadmap-branch-board relative min-h-[360px]" style="height: 420px;">
        {normalizedPaths.map((path: any, index: number) => {
          const isSinglePath = normalizedPaths.length === 1;

          return (
            <div
              class="roadmap-branch-card absolute rounded-2xl border border-zinc-200 bg-white/90 p-4 shadow-sm transition-transform duration-200 ease-out"
              data-roadmap-layout="branching"
              data-path-id={path.id}
              data-path-index={index}
              style={isSinglePath ? "left: 16px; top: 16px; width: calc(100% - 32px);" : ""}
            >
              <div class="mb-3 flex items-center justify-between gap-3">
                <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.18em] text-blue-700 break-words">{path.title}</span>
              </div>

              <div class="relative flex flex-col gap-3 pb-1">
                {(path.courses || []).map((course: any, courseIndex: number) => (
                  <div class="relative z-10" data-course-container={course.id}>
                    <RoadmapNode course={course} />
                    {courseIndex < (path.courses || []).length - 1 && (
                      <div class="mx-auto mt-2 h-4 w-px bg-zinc-200"></div>
                    )}
                  </div>
                ))}

                {!(path.courses || []).length && (
                  <div class="rounded-xl border border-dashed border-zinc-200 bg-zinc-50 px-3 py-6 text-center text-sm text-zinc-500">
                    No courses in this path yet.
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}
</div>

<script>
  function calculateProgressForTrack(track: Element, savedProgress: Record<string, boolean>) {
    let totalLessons = 0;
    let completedLessons = 0;

    track.querySelectorAll('[data-course-container]').forEach(container => {
      const btn = container.querySelector('.course-node-btn') as HTMLButtonElement | null;
      if (!btn) return;

      const courseData = JSON.parse(btn.dataset.course || '{}');
      let courseLessons = 0;
      let courseCompleted = 0;

      courseData.sections?.forEach((section: any) => {
        section.lessons?.forEach((lesson: any) => {
          courseLessons += 1;
          if (savedProgress[lesson.id]) {
            courseCompleted += 1;
          }
        });
      });

      totalLessons += courseLessons;
      completedLessons += courseCompleted;

      if (courseLessons > 0 && courseLessons === courseCompleted) {
        btn.classList.add('completed');
      } else {
        btn.classList.remove('completed');
      }
    });

    return { totalLessons, completedLessons };
  }

  function calculateGlobalProgress() {
    const savedProgress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}');

    document.querySelectorAll('.interactive-roadmap-wrapper').forEach(wrapper => {
      let totalLessons = 0;
      let completedLessons = 0;

      wrapper.querySelectorAll('.roadmap-track').forEach(track => {
        const { totalLessons: trackLessons, completedLessons: trackCompleted } = calculateProgressForTrack(track, savedProgress);
        totalLessons += trackLessons;
        completedLessons += trackCompleted;

        const lineFill = track.querySelector('.path-progress-fill') as HTMLDivElement | null;
        if (!lineFill) return;

        const pathPercent = trackLessons > 0 ? Math.round((trackCompleted / trackLessons) * 100) : 0;
        lineFill.style.height = `${pathPercent}%`;
      });

      const percent = totalLessons > 0 ? Math.round((completedLessons / totalLessons) * 100) : 0;
      const circle = wrapper.querySelector('.category-progress-circle') as SVGCircleElement | null;
      const text = wrapper.querySelector('.category-progress-text') as HTMLSpanElement | null;

      if (circle) {
        const circumference = 314;
        const offset = circumference - (percent / 100) * circumference;
        circle.style.strokeDashoffset = offset.toString();
      }
      if (text) text.textContent = `${percent}%`;
    });
  }

  function arrangeBranchBoard() {
    const board = document.querySelector('.roadmap-branch-board');
    if (!board) return;

    const cards = [...board.querySelectorAll('.roadmap-branch-card')];
    if (cards.length <= 1) {
      cards.forEach(card => {
        const element = card as HTMLElement;
        element.style.left = '16px';
        element.style.top = '16px';
        element.style.width = 'calc(100% - 32px)';
      });
      board.style.height = '260px';
      return;
    }

    const gap = 20;
    const padding = 16;
    const columns = Math.min(Math.max(Math.floor((board.clientWidth || 760) / 280), 2), 3);
    const cardWidth = (board.clientWidth - padding * 2 - gap * (columns - 1)) / columns;
    const columnHeights = Array(columns).fill(padding);

    cards.forEach((card) => {
      const element = card as HTMLElement;
      const columnIndex = columnHeights.indexOf(Math.min(...columnHeights));
      const height = element.offsetHeight || 220;

      element.style.width = `${cardWidth}px`;
      element.style.left = `${padding + columnIndex * (cardWidth + gap)}px`;
      element.style.top = `${columnHeights[columnIndex]}px`;
      columnHeights[columnIndex] += height + gap;
    });

    board.style.height = `${Math.max(...columnHeights) + 20}px`;
  }

  function initBranchBoardDragging() {
    const board = document.querySelector('.roadmap-branch-board');
    if (!board) return;

    const cards = board.querySelectorAll('.roadmap-branch-card');
    cards.forEach((card) => {
      const element = card as HTMLElement;
      if (cards.length === 1) {
        element.style.cursor = 'default';
        return;
      }

      const parsePx = (value: string | null, fallback: number) => {
        if (!value) return fallback;
        const parsed = Number.parseFloat(value);
        return Number.isFinite(parsed) ? parsed : fallback;
      };

      const left = parsePx(element.style.left, 0);
      const top = parsePx(element.style.top, 0);
      element.dataset.left = String(left);
      element.dataset.top = String(top);
      element.style.cursor = 'grab';
      element.style.touchAction = 'none';

      element.addEventListener('pointerdown', (event) => {
        const pointer = event as PointerEvent;
        const cardRect = element.getBoundingClientRect();
        const boardRect = board.getBoundingClientRect();

        const offsetX = pointer.clientX - cardRect.left;
        const offsetY = pointer.clientY - cardRect.top;

        const move = (moveEvent: PointerEvent) => {
          const nextLeft = Math.min(
            Math.max((moveEvent.clientX - boardRect.left) - offsetX, 16),
            Math.max(16, boardRect.width - cardRect.width - 16)
          );
          const nextTop = Math.min(
            Math.max((moveEvent.clientY - boardRect.top) - offsetY, 16),
            Math.max(16, boardRect.height - cardRect.height - 16)
          );

          element.style.left = `${nextLeft}px`;
          element.style.top = `${nextTop}px`;
          element.dataset.left = String(nextLeft);
          element.dataset.top = String(nextTop);
        };

        const up = () => {
          window.removeEventListener('pointermove', move);
          window.removeEventListener('pointerup', up);
          element.style.cursor = 'grab';
        };

        element.setPointerCapture(pointer.pointerId);
        element.style.cursor = 'grabbing';
        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
      });
    });
  }

  function initInteractiveRoadmap() {
    document.querySelectorAll('.course-node-btn').forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        const courseData = JSON.parse(newBtn.dataset.course || '{}');
        window.dispatchEvent(new CustomEvent('openCourseDrawer', { detail: { course: courseData } }));
      });
    });

    arrangeBranchBoard();
    initBranchBoardDragging();
    calculateGlobalProgress();
  }

  window.addEventListener('roadmapProgressUpdated', () => {
    calculateGlobalProgress();
  });
  window.addEventListener('resize', () => {
    arrangeBranchBoard();
  });

  document.addEventListener('astro:page-load', initInteractiveRoadmap);
  initInteractiveRoadmap();
</script>
