---
// CourseDrawer.astro
---
<div id="course-drawer-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[100] hidden transition-opacity duration-300 opacity-0"></div>

<div id="course-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[400px] bg-white shadow-2xl z-[101] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
  
  <!-- Drawer Header -->
  <div class="p-6 border-b border-zinc-200 bg-zinc-50 flex items-center justify-between sticky top-0 z-10">
    <div class="flex flex-col">
      <h3 id="drawer-course-title" class="text-xl font-bold text-zinc-900 leading-tight">Course Title</h3>
      <p id="drawer-course-desc" class="text-xs text-zinc-500 mt-1 line-clamp-2">Course description goes here.</p>
    </div>
    <button id="close-drawer-btn" class="p-2 -mr-2 text-zinc-400 hover:text-zinc-700 bg-zinc-100 hover:bg-zinc-200 rounded-full transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Content / Lessons -->
  <div id="drawer-content" class="flex-grow overflow-y-auto p-6 space-y-8 bg-white">
    <!-- Populated by JS -->
  </div>
</div>

<script>
  const drawer = document.getElementById('course-drawer');
  const backdrop = document.getElementById('course-drawer-backdrop');
  const closeBtn = document.getElementById('close-drawer-btn');
  const drawerTitle = document.getElementById('drawer-course-title');
  const drawerDesc = document.getElementById('drawer-course-desc');
  const drawerContent = document.getElementById('drawer-content');

  function openDrawer(courseData) {
    if (!drawer || !backdrop) return;
    
    // Populate Data
    if (drawerTitle) drawerTitle.textContent = courseData.title;
    if (drawerDesc) drawerDesc.textContent = courseData.description;
    
    if (drawerContent) {
      drawerContent.innerHTML = ''; // Clear old content
      
      const savedProgress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}');
      
      courseData.sections.forEach((section, index) => {
        const sectionEl = document.createElement('div');
        
        let lessonsHtml = section.lessons.map(lesson => {
          const isChecked = savedProgress[lesson.id] ? 'checked' : '';
          const checkedClass = isChecked ? 'line-through text-zinc-400' : 'text-zinc-700';
          
          return `
            <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-zinc-50 border border-transparent hover:border-zinc-100 transition-colors group">
              <div class="relative flex items-center justify-center mt-0.5">
                <input 
                  type="checkbox" 
                  class="lesson-checkbox shrink-0 appearance-none w-5 h-5 rounded border-2 border-zinc-300 checked:bg-blue-600 checked:border-blue-600 cursor-pointer transition-all duration-200"
                  data-lesson-id="${lesson.id}"
                  data-course-id="${courseData.id}"
                  ${isChecked}
                />
                <svg class="absolute w-3 h-3 text-white pointer-events-none opacity-0 check-mark pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <a href="${lesson.url}" class="flex-1 text-sm font-medium leading-snug group-hover:text-blue-600 transition-colors ${checkedClass} lesson-link" target="${lesson.type !== 'articles' ? '_blank' : '_self'}">
                ${lesson.title}
              </a>
            </div>
          `;
        }).join('');

        sectionEl.innerHTML = `
          <div class="mb-3 flex items-center gap-2">
            <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-600 text-xs font-bold">
              ${index + 1}
            </span>
            <h4 class="font-bold text-zinc-800 text-sm tracking-wide uppercase">${section.subheading}</h4>
          </div>
          <div class="space-y-1 ml-3 border-l-2 border-zinc-100 pl-4">
            ${lessonsHtml}
          </div>
        `;
        drawerContent.appendChild(sectionEl);
      });
      
      // Bind checkbox events
      const checkboxes = drawerContent.querySelectorAll('.lesson-checkbox');
      checkboxes.forEach(cb => {
        cb.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          const lessonId = target.dataset.lessonId;
          const courseId = target.dataset.courseId;
          const isChecked = target.checked;
          
          // Update link styling
          const link = target.parentElement?.nextElementSibling;
          if (link) {
            if (isChecked) {
              link.classList.add('line-through', 'text-zinc-400');
              link.classList.remove('text-zinc-700');
            } else {
              link.classList.remove('line-through', 'text-zinc-400');
              link.classList.add('text-zinc-700');
            }
          }
          
          if (lessonId) {
            const currentProgress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}');
            currentProgress[lessonId] = isChecked;
            localStorage.setItem('roadmap_progress', JSON.stringify(currentProgress));
            
            // Dispatch custom event to notify InteractiveRoadmap to update node and global stats
            window.dispatchEvent(new CustomEvent('roadmapProgressUpdated', { 
              detail: { lessonId, courseId, isChecked }
            }));
          }
        });
      });
    }

    // Show Drawer
    backdrop.classList.remove('hidden');
    // small delay for transition
    setTimeout(() => {
      backdrop.classList.remove('opacity-0');
      drawer.classList.remove('translate-x-full');
    }, 10);
    
    document.body.style.overflow = 'hidden'; // prevent bg scroll
  }

  function closeDrawer() {
    if (!drawer || !backdrop) return;
    
    drawer.classList.add('translate-x-full');
    backdrop.classList.add('opacity-0');
    
    setTimeout(() => {
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  // Listen for open events from nodes
  window.addEventListener('openCourseDrawer', ((e: CustomEvent) => {
    openDrawer(e.detail.course);
  }) as EventListener);
</script>

<style>
  .lesson-checkbox:checked + .check-mark {
    opacity: 1 !important;
  }
</style>
