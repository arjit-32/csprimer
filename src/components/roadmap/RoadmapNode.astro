---
export interface Props {
  course: any;
}
const { course } = Astro.props;
---

<button 
  class="course-node-btn roadmap-node relative group z-10 w-full max-w-[280px] text-left appearance-none focus:outline-none"
  data-course={JSON.stringify(course)}
  data-course-id={course.id}
>
  <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl opacity-0 group-hover:opacity-20 blur-md transition duration-500 rounded-2xl"></div>
  
  <div class="relative flex items-center gap-3 bg-white border border-zinc-200 rounded-2xl px-4 py-3.5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300 transform group-hover:-translate-y-0.5">
    <div class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-200 bg-zinc-50 text-zinc-400 group-hover:border-blue-200 group-hover:bg-blue-50 group-hover:text-blue-600 transition-all duration-300 shrink-0">
      <svg class="course-completed-icon h-4 w-4 text-blue-600 opacity-0 transition-opacity duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-7.5 7.5a1 1 0 01-1.414 0l-3.5-3.5a1 1 0 111.414-1.414L8.5 11.586l6.793-6.793a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
    </div>
    
    <div class="flex-grow flex flex-col justify-center min-w-0">
      <span class="text-zinc-900 font-bold text-sm md:text-base group-hover:text-blue-700 transition-colors leading-snug mb-0.5 break-words">
        {course.title}
      </span>
      <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-[0.14em]">
        {course.sections.length} Module{course.sections.length !== 1 ? 's' : ''}
      </span>
    </div>
    
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-300 group-hover:text-blue-500 ml-1 transition-all duration-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</button>

<style>
  .roadmap-node.completed .course-completed-icon {
    opacity: 1 !important;
  }
</style>
