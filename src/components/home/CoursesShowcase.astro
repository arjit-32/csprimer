---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allSeries = await getCollection("series");

// Sort active courses first
const sortedSeries = allSeries.sort((a, b) => {
  const weightA = a.data.weight ?? 100;
  const weightB = b.data.weight ?? 100;
  if (weightA !== weightB) return weightA - weightB;
  return a.data.title.localeCompare(b.data.title);
});

// Select top featured courses across categories
const featuredCourseIds = [
  "os",
  "cn",
  "dbms",
  "high-level-system-design",
  "api",
  "distributed",
  "nodejs",
  "express",
  "sql",
  "javascript",
  "java",
  "dsa-for-interviews"
];

const categoryTagMap: Record<string, { label: string; badge: string }> = {
  "Core-CS": { label: "Core CS", badge: "bg-sky-50 text-sky-700 border-sky-200" },
  "System-Design": { label: "System Design", badge: "bg-purple-50 text-purple-700 border-purple-200" },
  "Development": { label: "Fullstack", badge: "bg-emerald-50 text-emerald-700 border-emerald-200" },
  "DSA": { label: "DSA", badge: "bg-red-50 text-red-700 border-red-200" },
};

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/thumbnails/*.webp");

const showcasedCourses = sortedSeries
  .filter((s) => featuredCourseIds.includes(s.id))
  .map((entry) => {
    const data = entry.data;
    let totalLessons = 0;
    if (data.navbar) {
      data.navbar.forEach((section: any) => {
        if (section.link) {
          totalLessons += section.link.filter((l: any) => l.type === "articles").length;
        }
      });
    }

    let imagePath = data.image || "../../assets/images/collaboration.webp";
    if (imagePath.startsWith("../../assets")) {
      imagePath = imagePath.replace("../../assets", "/src/assets");
    } else if (imagePath.startsWith("/images/")) {
      imagePath = `/src/assets${imagePath}`;
    }

    if (!images[imagePath]) {
      const lowercasePath = imagePath.toLowerCase();
      const matchedKey = Object.keys(images).find((key) => key.toLowerCase() === lowercasePath);
      if (matchedKey) imagePath = matchedKey;
    }

    const catMeta = categoryTagMap[data.category] || { label: data.category || "General", badge: "bg-zinc-100 text-zinc-700 border-zinc-200" };

    return {
      id: entry.id,
      title: data.title,
      description: data.description,
      category: data.category || "Core-CS",
      status: data.status,
      imagePath,
      catMeta,
      ongoing: data.ongoing,
      totalLessons,
      url: `/courses/${entry.id}`,
    };
  });

const categories = [
  { id: "all", label: "All Tracks", dotColor: "bg-zinc-400" },
  { id: "Core-CS", label: "Core CS", dotColor: "bg-sky-500" },
  { id: "System-Design", label: "System Design", dotColor: "bg-purple-500" },
  { id: "Development", label: "Full-Stack Dev", dotColor: "bg-emerald-500" },
  { id: "DSA", label: "DSA", dotColor: "bg-red-500" },
];
---

<section class="section courses-showcase-section py-14 md:py-20 bg-white relative overflow-hidden border-t border-zinc-200/80" id="courses-showcase">
  <div class="container mx-auto px-4 max-w-7xl">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-5 border-b border-zinc-200 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold uppercase tracking-wider mb-3 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
          Comprehensive Courses
        </div>
        <h2 class="text-3xl md:text-4xl font-black font-secondary text-zinc-900 tracking-tight leading-tight">
          Structured Course Library
        </h2>
        <p class="text-zinc-600 text-sm md:text-base mt-2 max-w-2xl leading-relaxed">
          In-depth, zero-fluff courses built for mastery. Each curriculum includes architectural diagrams, code implementations, and lesson-by-lesson progression.
        </p>
      </div>

      <a 
        href="/courses" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-zinc-200 text-sm font-bold text-zinc-800 hover:text-[#FE6019] hover:border-[#FE6019] shadow-sm hover:shadow-md transition-all self-start md:self-auto shrink-0 group"
      >
        <span>Browse All Courses</span>
        <svg class="w-4 h-4 text-[#FE6019] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none mb-8" id="courseFilterTabs">
      {categories.map((cat, i) => (
        <button
          type="button"
          class={`course-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all cursor-pointer border flex items-center gap-2 select-none ${
            i === 0
              ? "active bg-zinc-900 text-white border-zinc-900 shadow-sm"
              : "bg-zinc-50 text-zinc-600 border-zinc-200 hover:bg-zinc-100 hover:text-zinc-900"
          }`}
          data-category={cat.id}
        >
          <span class={`w-2 h-2 rounded-full ${cat.dotColor}`}></span>
          <span>{cat.label}</span>
        </button>
      ))}
    </div>

    <!-- Course Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="homeCourseGrid">
      {showcasedCourses.map((course) => (
        <div
          class="course-card-item flex flex-col justify-between bg-white rounded-2xl border border-zinc-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden group"
          data-course-category={course.category}
        >
          <!-- Card Thumbnail -->
          <a href={course.url} class="block relative aspect-[16/9] bg-zinc-100 overflow-hidden no-underline">
            {images[course.imagePath] ? (
              <Image
                src={images[course.imagePath]()}
                alt={course.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={400}
                height={225}
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-zinc-100 to-zinc-200 text-zinc-400 font-bold text-xs">
                {course.title}
              </div>
            )}
            {course.ongoing && (
              <span class="absolute top-2.5 right-2.5 bg-orange-500/90 text-white font-mono text-[9px] font-bold px-2 py-0.5 rounded shadow">
                Active
              </span>
            )}
          </a>

          <!-- Card Body -->
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class={`text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded border ${course.catMeta.badge}`}>
                  {course.catMeta.label}
                </span>
                {course.totalLessons > 0 && (
                  <span class="text-[11px] font-mono font-medium text-zinc-400">
                    {course.totalLessons} lessons
                  </span>
                )}
              </div>

              <a href={course.url} class="block no-underline">
                <h3 class="text-base font-bold font-secondary text-zinc-900 group-hover:text-[#FE6019] transition-colors leading-snug line-clamp-1">
                  {course.title}
                </h3>
              </a>

              <p class="text-xs text-zinc-500 mt-2 line-clamp-2 leading-relaxed">
                {course.description}
              </p>
            </div>

            <!-- Card Footer -->
            <div class="mt-4 pt-3 border-t border-zinc-100 flex items-center justify-between">
              <a
                href={course.url}
                class="text-xs font-bold text-[#FE6019] group-hover:translate-x-0.5 transition-transform flex items-center gap-1 no-underline"
              >
                <span>Start Course</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <a
                href={`/roadmaps?category=${course.category}`}
                class="text-[11px] text-zinc-400 hover:text-zinc-700 transition-colors"
                title="View on Roadmap"
              >
                Roadmap →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Banner CTA -->
    <div class="mt-10 p-6 rounded-2xl bg-gradient-to-r from-zinc-50 to-orange-50/50 border border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-orange-500/10 text-[#FE6019] flex items-center justify-center font-bold text-lg shrink-0">
          📚
        </div>
        <div>
          <h4 class="text-sm font-bold text-zinc-900 font-secondary">Want to browse all courses with custom filters?</h4>
          <p class="text-xs text-zinc-500 mt-0.5">Filter by prerequisites, completion status, or view high-resolution curriculum roadmaps.</p>
        </div>
      </div>
      <a
        href="/courses"
        class="px-5 py-2.5 rounded-full bg-zinc-900 hover:bg-[#FE6019] text-white text-xs font-bold shadow transition-all whitespace-nowrap no-underline shrink-0"
      >
        View All 20+ Courses
      </a>
    </div>

  </div>
</section>

<script>
  function initCourseFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".course-filter-btn");
    const courseCards = document.querySelectorAll<HTMLElement>(".course-card-item");

    if (!filterButtons.length || !courseCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-category") || "all";

        // Update active button state
        filterButtons.forEach((b) => {
          if (b === btn) {
            b.classList.add("bg-zinc-900", "text-white", "border-zinc-900", "shadow-sm");
            b.classList.remove("bg-zinc-50", "text-zinc-600", "border-zinc-200");
          } else {
            b.classList.remove("bg-zinc-900", "text-white", "border-zinc-900", "shadow-sm");
            b.classList.add("bg-zinc-50", "text-zinc-600", "border-zinc-200");
          }
        });

        // Filter cards
        courseCards.forEach((card) => {
          const cardCat = card.getAttribute("data-course-category");
          if (cat === "all" || cardCat === cat) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initCourseFilters);
</script>
