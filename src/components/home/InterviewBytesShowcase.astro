---
// InterviewBytesShowcase.astro - Interactive Card-Deck Transition with Real Interview Questions
import { getCollection } from "astro:content";
import AnkiRevisionModal from "@/components/interview/AnkiRevisionModal.astro";

const allTopicsData = await getCollection("interview-questions");

// Flatten all real questions and clean up titles/emojis
const allRealQuestions = allTopicsData.flatMap((topic) =>
  topic.data.questions.map((q) => {
    const rawTag = (q.tags && q.tags[0]) || "general";
    const tagDisplayMap: Record<string, { label: string; badge: string; color: string }> = {
      nodejs: { label: "Node.js", badge: "bg-emerald-50 text-emerald-700 border-emerald-200", color: "#10b981" },
      expressjs: { label: "Express.js", badge: "bg-amber-50 text-amber-700 border-amber-200", color: "#f59e0b" },
      javascript: { label: "JavaScript", badge: "bg-red-50 text-red-700 border-red-200", color: "#ef4444" },
      general: { label: "General CS", badge: "bg-sky-50 text-sky-700 border-sky-200", color: "#08bdea" },
    };

    const cleanQuestion = q.question.replace(/^[\u{1F300}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{FE00}-\u{FE0F}\u{1F900}-\u{1F9FF}\s?❓📦🚀🔔🧭🙋🔍]+/gu, "").trim();

    return {
      id: q.id,
      tag: rawTag,
      tagMeta: tagDisplayMap[rawTag] || { label: rawTag, badge: "bg-zinc-100 text-zinc-700 border-zinc-200", color: "#71717a" },
      question: cleanQuestion,
      answers: q.answer || [],
      code: q.code || "",
    };
  })
);

// Group topics for filter tabs
const topicTabs = [
  { id: "all", label: "All Questions", count: allRealQuestions.length },
  { id: "nodejs", label: "Node.js", count: allRealQuestions.filter((q) => q.tag === "nodejs").length },
  { id: "expressjs", label: "Express.js", count: allRealQuestions.filter((q) => q.tag === "expressjs").length },
  { id: "javascript", label: "JavaScript", count: allRealQuestions.filter((q) => q.tag === "javascript").length },
  { id: "general", label: "General CS", count: allRealQuestions.filter((q) => q.tag === "general").length },
];
---

<section class="section interview-bytes-showcase py-14 md:py-20 bg-[#fafafa] relative overflow-hidden border-t border-zinc-200/80" id="interview-bytes-section">
  <div class="container mx-auto px-4 max-w-5xl">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold tracking-wider mb-3 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
        Interview Prep
      </div>
      <h2 class="text-3xl md:text-4xl font-black font-secondary text-zinc-900 tracking-tight leading-tight">
        Interview Bytes
      </h2>
      <p class="text-zinc-600 text-sm md:text-base mt-2 leading-relaxed">
        High-yield technical interview questions distilled into flashcards. Cycle through one card after another with instant answer reveals and code breakdowns.
      </p>
    </div>

    <!-- Hidden Raw Data -->
    <div id="realQuestionsDataStore" class="hidden">
      {JSON.stringify(allRealQuestions)}
    </div>

    <!-- Topic Tabs -->
    <div class="flex items-center justify-center gap-2 overflow-x-auto pb-3 scrollbar-none mb-6" id="interviewTopicTabs">
      {topicTabs.map((tab, idx) => (
        <button
          type="button"
          class={`iq-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all cursor-pointer border select-none ${
            idx === 0
              ? "active bg-white text-[#FE6019] border-[#FE6019] shadow-sm font-bold"
              : "bg-white text-zinc-600 border-zinc-200 hover:bg-zinc-50 hover:text-zinc-900"
          }`}
          data-topic={tab.id}
        >
          <span>{tab.label}</span>
          <span class="ml-1.5 px-1.5 py-0.2 rounded-full text-[10px] bg-zinc-100 text-zinc-500 font-mono">
            {tab.count}
          </span>
        </button>
      ))}
    </div>

    <!-- Animated Stacked Card Deck -->
    <div class="iq-deck-container max-w-3xl mx-auto relative pb-4">
      
      <!-- Under-Card 2 (Farthest depth layer) -->
      <div class="iq-under-card-2 absolute inset-0 rounded-2xl bg-zinc-100 border border-zinc-200 pointer-events-none"></div>

      <!-- Under-Card 1 (Middle depth layer) -->
      <div id="iqUnderCard" class="iq-under-card absolute inset-0 rounded-2xl bg-white border border-zinc-200/80 shadow-xs pointer-events-none p-6 sm:p-8 flex items-center justify-between opacity-70">
        <div class="h-4 w-24 bg-zinc-200 rounded"></div>
        <div class="h-4 w-12 bg-zinc-200 rounded"></div>
      </div>

      <!-- Main Active Question Card (Front Layer) -->
      <div
        id="iqCardWrapper"
        class="iq-main-card bg-white rounded-2xl border border-zinc-200/90 shadow-lg p-6 sm:p-8 relative select-none"
      >
        <!-- Top Card Header -->
        <div class="flex items-center justify-between pb-4 border-b border-zinc-100 mb-5">
          <div class="flex items-center gap-2.5">
            <span id="iqCardBadge" class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded border bg-emerald-50 text-emerald-700 border-emerald-200">
              Node.js
            </span>
            <span class="text-xs text-zinc-400 font-mono">
              Card <span id="iqCardCurrentNum" class="font-bold text-zinc-800">1</span> of <span id="iqCardTotalNum">10</span>
            </span>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              data-open-anki
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-orange-200 bg-orange-50 text-[#FE6019] hover:bg-[#FE6019] hover:text-white text-xs font-bold transition-all shadow-xs cursor-pointer"
              title="Practice in Anki Flashcard Mode"
            >
              <span>⚡</span>
              <span>Revise with Anki</span>
            </button>
          </div>
        </div>

        <!-- Question Prompt Area -->
        <div class="min-h-[64px] flex items-center">
          <h3 id="iqQuestionPrompt" class="text-lg sm:text-xl font-bold text-zinc-900 font-secondary leading-snug">
            {allRealQuestions[0]?.question}
          </h3>
        </div>

        <!-- Expandable Answer Drawer -->
        <div id="iqAnswerDrawer" class="hidden mt-6 pt-5 border-t border-zinc-100 transition-all duration-300">
          <div class="text-xs font-mono font-bold text-zinc-400 uppercase tracking-wider mb-2">
            Key Concepts:
          </div>
          <ul id="iqAnswerBullets" class="space-y-2 text-xs sm:text-sm text-zinc-700 leading-relaxed list-disc list-inside">
            <!-- Populated by JS -->
          </ul>

          <!-- Optional Code Snippet -->
          <div id="iqCodeWrapper" class="mt-4 bg-zinc-900 text-zinc-200 rounded-xl p-3.5 text-xs font-mono leading-relaxed overflow-x-auto border border-zinc-800 hidden">
            <pre id="iqCodeBlock" class="whitespace-pre overflow-x-auto scrollbar-none text-zinc-300"></pre>
          </div>
        </div>

        <!-- Card Footprint & Controls -->
        <div class="mt-6 pt-5 border-t border-zinc-100 flex flex-col sm:flex-row items-center justify-between gap-4">
          <button
            type="button"
            id="iqToggleAnswerBtn"
            class="w-full sm:w-auto px-5 py-2.5 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-800 font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="iqToggleText">💡 Reveal Answer</span>
          </button>

          <!-- Card Animation Controls -->
          <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
            <button
              type="button"
              id="iqPrevBtn"
              class="px-4 py-2 rounded-xl border border-zinc-200 hover:bg-zinc-50 text-xs font-bold text-zinc-600 transition-all flex items-center gap-1 cursor-pointer"
              title="Previous Question Card"
            >
              <span>←</span>
              <span>Prev</span>
            </button>
            <button
              type="button"
              id="iqNextBtn"
              class="px-5 py-2 rounded-xl bg-[#FE6019] hover:bg-orange-600 text-white text-xs font-bold shadow-xs hover:shadow transition-all flex items-center gap-1.5 cursor-pointer"
              title="Next Question Card"
            >
              <span>Next Card</span>
              <span>→</span>
            </button>
          </div>
        </div>

      </div>

    </div>

    <!-- Quick Footer Links -->
    <div class="mt-8 text-center flex flex-wrap items-center justify-center gap-6 text-xs text-zinc-500">
      <span>Swipe or click Next Card to cycle through questions with instant transitions.</span>
      <a
        href="/interview-bytes"
        class="text-[#FE6019] hover:underline font-bold flex items-center gap-1 no-underline"
      >
        <span>Open Complete Interview Bytes Library ({allRealQuestions.length}+ Questions)</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>

  <AnkiRevisionModal />
</section>

<style>
  /* Stack Depth Visuals */
  .iq-under-card-2 {
    transform: translateY(16px) scale(0.94);
    z-index: 5;
    opacity: 0.5;
  }
  .iq-under-card {
    transform: translateY(8px) scale(0.97);
    z-index: 10;
  }
  .iq-main-card {
    z-index: 20;
    transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.22s ease;
  }

  /* Smooth Card-after-another Slide Animations */
  .card-slide-out-left {
    transform: translateX(-90px) rotate(-3deg) !important;
    opacity: 0 !important;
  }
  .card-slide-out-right {
    transform: translateX(90px) rotate(3deg) !important;
    opacity: 0 !important;
  }

  .card-enter-right {
    animation: cardSlideInRight 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .card-enter-left {
    animation: cardSlideInLeft 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes cardSlideInRight {
    from {
      transform: translateX(70px) scale(0.96);
      opacity: 0;
    }
    to {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes cardSlideInLeft {
    from {
      transform: translateX(-70px) scale(0.96);
      opacity: 0;
    }
    to {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  function initInterviewShowcase() {
    const dataStore = document.getElementById("realQuestionsDataStore");
    const topicTabs = document.querySelectorAll<HTMLButtonElement>(".iq-tab-btn");
    const cardWrapper = document.getElementById("iqCardWrapper");
    const badgeEl = document.getElementById("iqCardBadge");
    const currentNumEl = document.getElementById("iqCardCurrentNum");
    const totalNumEl = document.getElementById("iqCardTotalNum");
    const promptEl = document.getElementById("iqQuestionPrompt");
    const answerDrawer = document.getElementById("iqAnswerDrawer");
    const answerBullets = document.getElementById("iqAnswerBullets");
    const codeWrapper = document.getElementById("iqCodeWrapper");
    const codeBlock = document.getElementById("iqCodeBlock");
    const toggleAnswerBtn = document.getElementById("iqToggleAnswerBtn");
    const toggleText = document.getElementById("iqToggleText");
    const prevBtn = document.getElementById("iqPrevBtn");
    const nextBtn = document.getElementById("iqNextBtn");

    if (!dataStore || !promptEl || !cardWrapper) return;

    let allQuestions: any[] = [];
    try {
      allQuestions = JSON.parse(dataStore.textContent || "[]");
    } catch (e) {
      return;
    }

    if (!allQuestions.length) return;

    let currentTopic = "all";
    let filteredList = allQuestions;
    let currentIndex = 0;
    let isAnswerOpen = false;
    let isTransitioning = false;

    function renderQuestion(index: number) {
      const q = filteredList[index];
      if (!q) return;

      if (badgeEl) {
        badgeEl.textContent = q.tagMeta?.label || q.tag;
        badgeEl.className = `text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded border ${q.tagMeta?.badge || "bg-zinc-100 text-zinc-700"}`;
      }

      if (currentNumEl) currentNumEl.textContent = String(index + 1);
      if (totalNumEl) totalNumEl.textContent = String(filteredList.length);
      promptEl.textContent = q.question;

      // Reset Answer Drawer
      isAnswerOpen = false;
      answerDrawer?.classList.add("hidden");
      if (toggleText) toggleText.textContent = "💡 Reveal Answer";

      // Render Bullets
      if (answerBullets) {
        answerBullets.innerHTML = (q.answers || [])
          .map((bullet: string) => `<li class="pl-1">${bullet}</li>`)
          .join("");
      }

      // Render Code if available
      if (codeWrapper && codeBlock) {
        if (q.code && q.code.trim().length > 0) {
          codeBlock.textContent = q.code;
          codeWrapper.classList.remove("hidden");
        } else {
          codeWrapper.classList.add("hidden");
          codeBlock.textContent = "";
        }
      }
    }

    // Card-after-another Animated Transition
    function transitionToNextCard(direction: "next" | "prev") {
      if (isTransitioning) return;
      isTransitioning = true;

      // Slide out active card
      cardWrapper.classList.remove("card-enter-right", "card-enter-left");
      cardWrapper.classList.add(direction === "next" ? "card-slide-out-left" : "card-slide-out-right");

      setTimeout(() => {
        cardWrapper.classList.remove("card-slide-out-left", "card-slide-out-right");

        if (direction === "next") {
          currentIndex = (currentIndex + 1) % filteredList.length;
        } else {
          currentIndex = (currentIndex - 1 + filteredList.length) % filteredList.length;
        }

        renderQuestion(currentIndex);

        // Slide in new card smoothly
        cardWrapper.classList.add(direction === "next" ? "card-enter-right" : "card-enter-left");

        setTimeout(() => {
          isTransitioning = false;
        }, 300);
      }, 200);
    }

    // Toggle Answer
    toggleAnswerBtn?.addEventListener("click", () => {
      isAnswerOpen = !isAnswerOpen;
      if (isAnswerOpen) {
        answerDrawer?.classList.remove("hidden");
        if (toggleText) toggleText.textContent = "✕ Hide Answer";
      } else {
        answerDrawer?.classList.add("hidden");
        if (toggleText) toggleText.textContent = "💡 Reveal Answer";
      }
    });

    nextBtn?.addEventListener("click", () => transitionToNextCard("next"));
    prevBtn?.addEventListener("click", () => transitionToNextCard("prev"));

    // Swipe / Drag Gesture Support
    let touchStartX = 0;
    cardWrapper.addEventListener("touchstart", (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    cardWrapper.addEventListener("touchend", (e) => {
      const diffX = e.changedTouches[0].clientX - touchStartX;
      if (diffX < -50) {
        transitionToNextCard("next");
      } else if (diffX > 50) {
        transitionToNextCard("prev");
      }
    }, { passive: true });

    // Topic Filter Switching
    topicTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const topic = tab.getAttribute("data-topic") || "all";
        if (topic === currentTopic) return;
        currentTopic = topic;

        // Update tab active styling
        topicTabs.forEach((t) => {
          if (t === tab) {
            t.classList.add("active", "text-[#FE6019]", "border-[#FE6019]", "shadow-sm", "font-bold");
            t.classList.remove("text-zinc-600", "border-zinc-200");
          } else {
            t.classList.remove("active", "text-[#FE6019]", "border-[#FE6019]", "shadow-sm", "font-bold");
            t.classList.add("text-zinc-600", "border-zinc-200");
          }
        });

        // Filter list
        if (currentTopic === "all") {
          filteredList = allQuestions;
        } else {
          filteredList = allQuestions.filter((q) => q.tag === currentTopic);
        }

        currentIndex = 0;
        transitionToNextCard("next");
      });
    });

    // Initial render
    renderQuestion(currentIndex);
  }

  document.addEventListener("astro:page-load", initInterviewShowcase);
</script>
