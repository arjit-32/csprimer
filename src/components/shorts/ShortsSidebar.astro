---
interface ShortItem {
  id: string;
  title?: string;
}

interface Series {
  slug: string;
  name: string;
  count: number;
}

interface Props {
  activeSeriesId?: string;
  activeSeriesName?: string;
  items: ShortItem[];
  activeShortId?: string;
}

const { activeSeriesId, activeSeriesName, items, activeShortId } = Astro.props;
---

<aside class="shorts-sidebar">
  <div class="sidebar-section active-series-section">
    <div class="mb-4">
      <a href="/shorts" class="text-sm font-medium text-gray-400 hover:text-primary transition-colors">← All Series</a>
    </div>
    <h3 class="sidebar-title">{activeSeriesName}</h3>
    <nav class="video-nav">
      {items.map((item) => (
        <a 
          href={`/shorts/${activeSeriesId}/${item.id}`} 
          class={`video-link ${activeShortId === item.id ? 'active' : ''}`}
          data-short-id={item.id}
        >
          <span class="video-title">{item.title}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>


<style lang="scss">
  .shorts-sidebar {
    width: 320px;
    height: calc(100vh - 64px);
    background: #fff;
    border-right: 1px solid #eee;
    padding: 30px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    position: sticky;
    top: 64px;

    @media (max-width: 1024px) {
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid #eee;
      padding: 15px;
      position: relative;
      top: 0;
    }
  }

  .sidebar-section {
    margin-bottom: 30px;
  }

  .sidebar-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #222;
    margin-bottom: 15px;
  }

  .sidebar-subtitle {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    margin-bottom: 15px;
  }

  .video-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .video-link {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    color: #666;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;

    &:hover {
      background: #f8f8f8;
      color: #FE6019;
    }

    &.active {
      background: #fff5f0;
      color: #FE6019;
      border-left-color: #FE6019;
      font-weight: 600;
    }
  }

  .series-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .series-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    color: #888;
    font-size: 0.85rem;

    &:hover {
      background: #f8f8f8;
      color: #333;
    }

    &.active {
      display: none; /* Hide active series from 'Other' list */
    }
  }

  .series-count {
    background: #eee;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.75rem;
  }
</style>

<script>
  // On page load, highlight the active link and ensure it's in view
  document.addEventListener("astro:page-load", () => {
    const activeLink = document.querySelector('.video-link.active');
    if (activeLink) {
      activeLink.scrollIntoView({ behavior: 'auto', block: 'nearest' });
    }
  });
</script>
