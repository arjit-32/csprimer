---
interface Props {
  id: string;
  youtubeId: string;
  title?: string;
  Content: any; // Rendered Astro component
  isSinglePage?: boolean;
}

const { id, youtubeId, title, Content, isSinglePage = false } = Astro.props;
---


<div class={`short-card ${isSinglePage ? 'single-page' : ''}`} id={`short-${id}`} data-short-id={id} data-youtube-id={youtubeId}>

  <div class="short-container">
    <!-- Video Section -->
    <div class="video-wrapper">
      <div class="video-ratio">
        <iframe
          src={`https://www.youtube.com/embed/${youtubeId}?controls=1&modestbranding=1&rel=0&enablejsapi=1`}
          title={title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="youtube-iframe"
          loading="lazy"
        ></iframe>
      </div>
    </div>

    <!-- Info Section -->
    <div class="info-wrapper">
      <div class="info-content">
        <div class="header-group">
          {title && <h2 class="short-title">{title}</h2>}
          <div class="actions">
            <button class="share-btn" data-id={id} title="Copy Link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-share-2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.41" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            </button>
          </div>
        </div>
        
        <div class="markdown-content mt-6">
          <Content />
        </div>
      </div>
    </div>
  </div>
</div>

<style lang="scss" is:global>
  /* Global styles for nested markdown content */
  .markdown-content {
    color: #666;
    line-height: 1.6;
    font-size: 1.05rem;

    h1, h2, h3, h4 {
      color: #222;
      margin-top: 24px;
      margin-bottom: 12px;
      font-weight: 700;
    }
    h3 { font-size: 1.25rem; }
    
    p { margin-bottom: 16px; }

    ul, ol {
      margin-bottom: 16px;
      padding-left: 20px;
      li { margin-bottom: 8px; }
    }

    pre {
      background: #1a202c !important;
      padding: 16px;
      border-radius: 8px;
      margin: 20px 0;
      font-size: 0.9rem;
      overflow-x: auto;
    }

    code:not(pre code) {
      background: #f0f0f0;
      padding: 2px 6px;
      border-radius: 4px;
      color: #FE6019;
      font-size: 0.9em;
    }
  }
</style>

<style lang="scss">
  .short-card {
    height: calc(100vh - 80px);
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    scroll-snap-align: start;
    background: #fafafa;
    border-bottom: 1px solid #eee;

    @media (max-width: 1024px) {
      height: auto;
      padding: 60px 20px;
    }

    &.single-page {
      height: auto;
      padding: 40px 0;
      background: transparent;
      border-bottom: none;
      
      .short-container {
        height: auto;
        grid-template-columns: 1fr;
        max-width: 800px;
      }
      
      .video-ratio {
        aspect-ratio: 16/9; /* Standard for single page maybe? */
      }
    }
  }


  .short-container {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 60px;
    max-width: 1100px;
    width: 100%;
    height: 80%;

    @media (max-width: 1024px) {
      display: flex;
      flex-direction: column;
      height: auto;
      gap: 30px;
    }
  }

  .video-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .video-ratio {
    width: 100%;
    aspect-ratio: 9/16;
    max-height: 100%;
    
    iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
  }

  .info-wrapper {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding-right: 15px;
    /* Custom scrollbar */
    &::-webkit-scrollbar { width: 4px; }
    &::-webkit-scrollbar-thumb { background: #eee; border-radius: 10px; }
  }

  .header-group {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }

  .short-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: #222;
    line-height: 1.1;
  }

  .share-btn {
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: all 0.2s;
    &:hover { background: #eee; color: #FE6019; }
  }
</style>

<script>
  // Simple copy share link logic
  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const url = window.location.origin + window.location.pathname + '#short-' + (btn as HTMLElement).dataset.id;
      navigator.clipboard.writeText(url);
      alert('Link copied to clipboard!');
    });
  });
</script>
