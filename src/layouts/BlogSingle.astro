---
import readingTime from "@/lib/utils/readingTime";
import { getEntry } from "astro:content";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { STATUS_CONFIG, isLocked } from "@/lib/statusConfig";
import {
  FaRegClock,
  FaRegFolder,
  FaRegUserCircle,
} from "react-icons/fa";
import { Image } from "astro:assets";
import ActionButtons from "@/components/ActionButtons.astro";
import config from "@/config/config.json";

const { post, series } = Astro.props;
const { Content } = await post.render();
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');

const seriesEntry = series ? await getEntry("series", series) : null;
const courseData = seriesEntry ? seriesEntry.data : null;

const siteBaseUrl = config.site.base_url;

// Helper to get navigation link URL
function getCourseLinkHref(link: any): string {
  return link.type === 'articles' ? `/articles/${link.url}` : link.url;
}

// Helper to determine if current article matches this link
function isCurrentArticle(link: any, currentSlug: string): boolean {
  return link.type === 'articles' && link.url === currentSlug;
}

// Helper to check if section contains current article
function sectionContainsCurrentArticle(section: any, currentSlug: string): boolean {
  return section.link.some((link: any) => isCurrentArticle(link, currentSlug));
}

// Get Previous/Next link objects with full data
function getPreviousNextLinks(navbar: any[], currentSlug: string) {
  const courseArticles = navbar
    .flatMap(section => section.link)
    .filter(link => link.type === 'articles' && !isLocked(link.status));
  
  const currentIndex = courseArticles.findIndex(link => link.url === currentSlug);
  
  return {
    previous: currentIndex > 0 ? courseArticles[currentIndex - 1] : null,
    next: currentIndex < courseArticles.length - 1 ? courseArticles[currentIndex + 1] : null,
  };
}

---


<section class="section blog-single py-4 bg-white border-b pb-20">
  <div class="container max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col lg:flex-row gap-8">
      
      <!-- Navigation Sidebar - Hidden on mobile, visible on lg screens -->
      {courseData && courseData.navbar.length > 0 && (
        <div class="hidden lg:block w-64 shrink-0">
          <div class="sticky top-20 space-y-3">
            {courseData.navbar.map((section, index) => {
              const currentSlug = post.slug || post.data.slug || "";
              const sectionActive = sectionContainsCurrentArticle(section, currentSlug);
              
              return (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
                  <button
                    class="w-full flex items-center justify-between p-3 hover:bg-gray-50 transition-colors cursor-pointer group"
                    id={`nav-button-${index}`}
                    data-expanded={sectionActive}
                  >
                    <div class="flex items-center gap-2">
                      <span class="flex items-center justify-center w-7 h-7 rounded-full bg-[#fb7299]/10 text-[#fb7299] font-medium text-sm">
                        {index + 1}
                      </span>
                      <span class="font-semibold text-gray-900 text-sm group-hover:text-[#fb7299] transition-colors">
                        {section.subheading}
                      </span>
                    </div>
                    <svg 
                      class={`w-4 h-4 text-gray-400 transform transition-transform duration-200 ${sectionActive ? 'rotate-180' : ''}`}
                      fill="none" 
                      viewBox="0 0 24 24" 
                      stroke="currentColor"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  
                  <div
                    class={`border-t border-gray-100 ${!sectionActive ? 'hidden' : ''}`}
                    id={`nav-content-${index}`}
                  >
                    <div class="p-3 space-y-1">
                      {section.link.map((link) => {
                        const currentSlug = post.slug || post.data.slug || "";
                        const locked = isLocked(link.status);
                        const isActive = isCurrentArticle(link, currentSlug);
                        const articleStatusCfg = link.status ? STATUS_CONFIG[link.status] : null;
                        const href = getCourseLinkHref(link);
                        const target = link.type === 'articles' ? '_self' : '_blank';
                        const rel = link.type === 'articles' ? undefined : 'noopener noreferrer';

                        return locked ? (
                          <span class="nav-link-locked flex items-center gap-2 p-2 rounded-md text-sm">
                            <svg class="w-4 h-4 shrink-0 text-gray-300" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M17 11V7A5 5 0 0 0 7 7v4H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1h-2zm-5 6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-6H9V7a3 3 0 1 1 6 0v4z"/>
                            </svg>
                            <span class="text-gray-400 italic truncate">
                              {link.title}
                            </span>
                            {articleStatusCfg && (
                              <span class={`sidebar-status-pill ${articleStatusCfg.cls} ml-auto shrink-0`}>
                                {articleStatusCfg.label}
                              </span>
                            )}
                          </span>
                        ) : (
                          <a
                            href={href}
                            target={target}
                            rel={rel}
                            class={`flex items-center gap-2 p-2 rounded-md transition-colors group text-sm ${
                              isActive 
                                ? 'bg-[#fb7299]/10 text-[#fb7299] font-medium' 
                                : 'text-gray-700 hover:bg-gray-50 hover:text-[#fb7299]'
                            }`}
                          >
                            {link.type === 'articles' && (
                              <svg class="w-4 h-4 shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                              </svg>
                            )}
                            {link.type === 'external' && (
                              <svg class="w-4 h-4 shrink-0 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                            <span class="truncate">
                              {link.title}
                            </span>
                            {articleStatusCfg && (
                              <span class={`sidebar-status-pill ${articleStatusCfg.cls} ml-auto shrink-0`}>
                                {articleStatusCfg.label}
                              </span>
                            )}
                            {link.type === 'external' && (
                              <svg class="w-3 h-3 shrink-0 text-gray-400 ml-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                          </a>
                        );
                      })}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
      
      <!-- Main Content -->
      <div class="flex-1 min-w-0">
        <div class={`${courseData ? '' : 'flex justify-center'}`}>
          <div class={`${courseData ? 'w-full' : 'max-w-[720px]'}`}>
            {(() => {
              if(!post.data.image) return null;
              let imagePath = post.data.image;
              if (imagePath.startsWith("../../assets")) {
                imagePath = imagePath.replace("../../assets", "/src/assets");
              } else if (imagePath.startsWith("/images/")) {
                imagePath = `/src/assets${imagePath}`;
              }

              return images[imagePath] ? (
                <div class="mb-6 overflow-hidden rounded-lg">
                  <Image
                    class="w-full h-full"
                    src={images[imagePath]()}
                    alt={post.data.title || "Blog post image"}
                    width={800}
                    height={450}
                    loading="eager"
                  />
                </div>
              ) : null;
            })()}

            <h1 class="text-3xl font-bold leading-tight mb-4">{post.data.title}</h1>
            
            <div class="mb-6 flex flex-wrap items-center text-sm text-gray-600">
              {courseData && courseData.navbar.length > 0 && (
              <div class="flex items-center mr-4 mb-2">
                <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <a
                  href={`/courses/${series}`}
                  class="text-sm text-[#fb7299] font-semibold hover:underline"
                >
                  Back to {humanize(courseData?.title || series)}
                </a>
              </div>
              )}

              <div class="flex items-center mr-4 mb-2">
                <FaRegUserCircle className={"mr-1"} />
                <a 
                  href="https://arjit-32.github.io" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-gray-700 hover:text-[#fb7299] transition-colors"
                >
                  {humanize(post.data.author)}
                </a>
              </div>

              
              <div class="flex items-center mr-4 mb-2">
                <FaRegClock className={"mr-1"} />
                <span>{readingTime(post.body)}</span>
              </div>
              
              <div class="flex items-center mb-2">
                <ActionButtons 
                  id={`article-${post.slug}`} 
                  shareTitle={post.data.title}
                  shareUrl={`${siteBaseUrl}/articles/${post.slug}`}
                />
              </div>
            </div>
            
            <div class="content max-w-none prose-headings:text-2xl prose-th:text-sm prose-h3:text-lg overflow-x-hidden">
              <Content />
            </div>
          
            <div class="mt-12 mb-8 flex justify-center">
              <button 
                id="article-complete-btn" 
                class="flex items-center gap-2 px-8 py-3 rounded-xl font-bold transition-all duration-300 shadow-sm border-2 group"
                data-lesson-id={post.slug}
              >
                <div class="status-icon w-5 h-5 flex items-center justify-center rounded-full border-2 border-gray-300 transition-all duration-300">
                   <svg class="check-svg w-3 h-3 opacity-0 text-white transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                     <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                   </svg>
                </div>
                <span class="btn-text text-gray-500 group-hover:text-gray-700 transition-colors">Mark as Completed</span>
              </button>
            </div>

            {courseData && courseData.navbar.length > 0 && (() => {
              const currentSlug = post.slug || post.data.slug || "";
              const { previous, next } = getPreviousNextLinks(courseData.navbar, currentSlug);
            
              return (
                <div class="mt-6 flex justify-between pt-6 text-sm font-medium border-t border-gray-100">
                  <div class="text-[#fb7299]">
                    {previous && (
                      <a
                        href={`/articles/${previous.url}`}
                        class="inline-flex items-center gap-2 hover:underline"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        <div class="text-left">
                          <div class="text-xs text-gray-500">Previous</div>
                          <div>{previous.title}</div>
                        </div>
                      </a>
                    )}
                  </div>
                  <div class="ml-auto text-[#fb7299]">
                    {next && (
                      <a
                        href={`/articles/${next.url}`}
                        class="inline-flex items-center gap-2 hover:underline"
                      >
                        <div class="text-right">
                          <div class="text-xs text-gray-500">Next</div>
                          <div>{next.title}</div>
                        </div>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              );
            })()}

            
            
            
            
          </div>
        </div>
      </div>
    </div>
  </div>
</section>



<script>
  function initNavHandlers() {
    // Handle expand/collapse button clicks
    document.querySelectorAll('[id^="nav-button-"]').forEach((button) => {
      button.removeEventListener("click", handleToggle);
      button.addEventListener("click", handleToggle);
    });
  }

  function handleToggle(event: Event) {
    const button = event.currentTarget as HTMLElement;
    const index = button.id.split("-").pop();
    const content = document.getElementById(`nav-content-${index}`);
    const icon = button.querySelector(".transform");

    if (content) {
      content.classList.toggle("hidden");
    }
    if (icon) {
      icon.classList.toggle("rotate-180");
    }
  }

  function initCompletionButton() {
    const btn = document.getElementById('article-complete-btn');
    if (!btn) return;

    const lessonId = btn.getAttribute('data-lesson-id');
    if (!lessonId) return;
    const btnText = btn.querySelector('.btn-text');
    
    function updateUI(isCompleted: boolean) {
      if (isCompleted) {
        btn?.classList.add('is-completed');
        if (btnText) btnText.textContent = 'Completed';
      } else {
        btn?.classList.remove('is-completed');
        if (btnText) btnText.textContent = 'Mark as Completed';
      }
    }

    // Load initial state
    let progress: Record<string, boolean> = {};
    try { progress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}'); } catch(e) {}
    updateUI(!!progress[lessonId]);

    // Handle click
    btn.removeEventListener('click', handleComplete);
    btn.addEventListener('click', handleComplete);

    function handleComplete() {
      let currentProgress: Record<string, boolean> = {};
      try { currentProgress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}'); } catch(e) {}
      
      const newState = !currentProgress[lessonId];
      currentProgress[lessonId] = newState;
      localStorage.setItem('roadmap_progress', JSON.stringify(currentProgress));
      
      updateUI(newState);
      
      window.dispatchEvent(new CustomEvent('roadmapProgressUpdated', {
        detail: { lessonId, isChecked: newState }
      }));
    }
  }

  function initAllFeatures() {
    initNavHandlers();
    initCompletionButton();
  }

  // Attach handlers on Astro events
  document.addEventListener("astro:page-load", initAllFeatures);
</script>

<style>
  #article-complete-btn {
    background: white;
    border-color: #efefef;
  }
  #article-complete-btn:hover {
    border-color: #e5e7eb;
    background: #f9fafb;
  }
  #article-complete-btn.is-completed {
    background: #f0fdf4;
    color: #16a34a;
    border-color: #bbf7d0;
  }
  #article-complete-btn.is-completed .status-icon {
    background: #16a34a;
    border-color: #16a34a;
  }
  #article-complete-btn.is-completed .check-svg {
    opacity: 1;
  }
  #article-complete-btn.is-completed .btn-text {
    color: #16a34a;
  }

  /* ── Locked sidebar nav links ── */
  .nav-link-locked {
    cursor: not-allowed;
    opacity: 0.6;
    user-select: none;
  }

  /* ── Sidebar status pills ── */
  .sidebar-status-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 2px 6px;
    border-radius: 999px;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .sidebar-status-pill.status-pill--completed {
    background: #dcfce7; color: #15803d; border-color: #86efac;
  }
  .sidebar-status-pill.status-pill--in-progress {
    background: #dbeafe; color: #1d4ed8; border-color: #93c5fd;
  }
  .sidebar-status-pill.status-pill--proofreading {
    background: #fef9c3; color: #a16207; border-color: #fde047;
  }
  .sidebar-status-pill.status-pill--planned {
    background: #f1f5f9; color: #64748b; border-color: #cbd5e1;
  }
  .sidebar-status-pill.status-pill--draft {
    background: #ffedd5; color: #c2410c; border-color: #fdba74;
  }
</style>