---
import readingTime from "@/lib/utils/readingTime";
import { getEntry } from "astro:content";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { STATUS_CONFIG, isLocked } from "@/lib/statusConfig";
import { Image } from "astro:assets";
import ActionButtons from "@/components/ui/ActionButtons.astro";
import TableOfContents from "@/components/features/blog/TableOfContents.astro";
import MobileTableOfContents from "@/components/features/blog/MobileTableOfContents.astro";
import ProjectSeriesNav from "@/components/features/blog/ProjectSeriesNav.astro";
import config from "@/config/config.json";

const { post, series } = Astro.props;
const { Content, headings = [] } = await post.render();
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/thumbnails/**/*.{jpeg,jpg,png,gif,webp}');

const seriesEntry = series ? await getEntry("series", series) : null;
const seriesData = seriesEntry ? seriesEntry.data : null;

// Determine whether this is a Course Series or a Project Series
const isProjectSeries = Boolean(seriesData && (seriesData.type === 'project' || seriesData.category === 'Project'));
const isCourseSeries = Boolean(seriesData && !isProjectSeries);
const courseData = isCourseSeries ? seriesData : null;
const projectSeriesData = isProjectSeries ? seriesData : null;

const siteBaseUrl = config.site.base_url;

// Helper to get navigation link URL
function getCourseLinkHref(link: any): string {
  return link.type === 'articles' ? `/articles/${link.url}` : link.url;
}

// Helper to determine if current article matches this link
function isCurrentArticle(link: any, currentSlug: string): boolean {
  return link.type === 'articles' && link.url === currentSlug;
}

// Helper to check if section contains current article
function sectionContainsCurrentArticle(section: any, currentSlug: string): boolean {
  return section.link.some((link: any) => isCurrentArticle(link, currentSlug));
}

// Get Previous/Next link objects with full data
function getPreviousNextLinks(navbar: any[], currentSlug: string) {
  const courseArticles = navbar
    .flatMap(section => section.link)
    .filter(link => link.type === 'articles' && !isLocked(link.status));
  
  const currentIndex = courseArticles.findIndex(link => link.url === currentSlug);
  
  return {
    previous: currentIndex > 0 ? courseArticles[currentIndex - 1] : null,
    next: currentIndex < courseArticles.length - 1 ? courseArticles[currentIndex + 1] : null,
  };
}

// Status checks for revision & development banners
const currentSlug = post.slug || post.data.slug || "";
const currentLinkInNavbar = courseData?.navbar
  ?.flatMap((sec: any) => sec.link || [])
  ?.find((link: any) => isCurrentArticle(link, currentSlug));

const isCourseRevisiting = courseData?.status === 're-visiting';
const isArticleRevisiting = post.data.status === 're-visiting' || currentLinkInNavbar?.status === 're-visiting';
const showRevisitingNotice = isCourseRevisiting || isArticleRevisiting;

const isCourseInProgress = courseData?.status === 'in-progress';
const isArticleInProgress = post.data.status === 'in-progress' || currentLinkInNavbar?.status === 'in-progress';
const showInProgressNotice = !showRevisitingNotice && (isCourseInProgress || isArticleInProgress);

---


<section class="section blog-single py-4 bg-white border-b pb-20">
  <div class={`container ${courseData ? 'max-w-[1360px]' : 'max-w-[1180px]'} mx-auto px-4 sm:px-6`}>
    <div class={`flex flex-col lg:flex-row gap-8 ${!courseData ? 'justify-center' : ''}`}>
      
      <!-- Navigation Sidebar - Hidden on mobile, visible on lg screens -->
      {courseData && courseData.navbar.length > 0 && (
        <div class="hidden lg:block w-64 shrink-0">
          <div class="sticky top-20 space-y-3">
            {courseData.navbar
              .filter((s: any) => !/further|resource|reference|additional/i.test(s.subheading || ""))
              .map((section, index) => {
              const currentSlug = post.slug || post.data.slug || "";
              const sectionActive = sectionContainsCurrentArticle(section, currentSlug);
              
              return (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
                  <button
                    class="w-full flex items-center justify-between p-3 hover:bg-gray-50 transition-colors cursor-pointer group"
                    id={`nav-button-${index}`}
                    data-expanded={sectionActive}
                  >
                    <div class="flex items-center gap-2">
                      <span class="flex items-center justify-center w-7 h-7 rounded-full bg-[#fb7299]/10 text-[#fb7299] font-medium text-sm">
                        {index + 1}
                      </span>
                      <span class="font-semibold text-gray-900 text-sm group-hover:text-[#fb7299] transition-colors">
                        {section.subheading}
                      </span>
                    </div>
                    <svg 
                      class={`w-4 h-4 text-gray-400 transform transition-transform duration-200 ${sectionActive ? 'rotate-180' : ''}`}
                      fill="none" 
                      viewBox="0 0 24 24" 
                      stroke="currentColor"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  
                  <div
                    class={`border-t border-gray-100 ${!sectionActive ? 'hidden' : ''}`}
                    id={`nav-content-${index}`}
                  >
                    <div class="p-3 space-y-1">
                      {section.link.map((link) => {
                        const currentSlug = post.slug || post.data.slug || "";
                        const locked = isLocked(link.status);
                        const isActive = isCurrentArticle(link, currentSlug);
                        const articleStatusCfg = link.status ? STATUS_CONFIG[link.status] : null;
                        const href = getCourseLinkHref(link);
                        const target = link.type === 'articles' ? '_self' : '_blank';
                        const rel = link.type === 'articles' ? undefined : 'noopener noreferrer';

                        return locked ? (
                          <span class="nav-link-locked flex items-center gap-2 p-2 rounded-md text-sm">
                            <svg class="w-4 h-4 shrink-0 text-gray-300" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M17 11V7A5 5 0 0 0 7 7v4H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1h-2zm-5 6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-6H9V7a3 3 0 1 1 6 0v4z"/>
                            </svg>
                            <span class="text-gray-400 italic truncate">
                              {link.title}
                            </span>
                            {articleStatusCfg && (
                              <span class={`sidebar-status-pill ${articleStatusCfg.cls} ml-auto shrink-0`}>
                                {articleStatusCfg.label}
                              </span>
                            )}
                          </span>
                        ) : (
                          <a
                            href={href}
                            target={target}
                            rel={rel}
                            class={`flex items-center gap-2 p-2 rounded-md transition-colors group text-sm ${
                              isActive 
                                ? 'bg-[#fb7299]/10 text-[#fb7299] font-medium' 
                                : 'text-gray-700 hover:bg-gray-50 hover:text-[#fb7299]'
                            }`}
                          >
                            {link.type === 'articles' && (
                              <svg class="w-4 h-4 shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                              </svg>
                            )}
                            {link.type === 'external' && (
                              <svg class="w-4 h-4 shrink-0 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                            <span class="truncate">
                              {link.title}
                            </span>
                            {articleStatusCfg && (
                              <span class={`sidebar-status-pill ${articleStatusCfg.cls} ml-auto shrink-0`}>
                                {articleStatusCfg.label}
                              </span>
                            )}
                            {link.type === 'external' && (
                              <svg class="w-3 h-3 shrink-0 text-gray-400 ml-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                          </a>
                        );
                      })}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
      
      <!-- Main Content -->
      <div class={`flex-1 min-w-0 ${!courseData ? 'max-w-3xl lg:max-w-4xl w-full mx-auto px-1 sm:px-4 md:px-6' : ''}`}>
        <div class="w-full">
          <div>
            {projectSeriesData && (
              <ProjectSeriesNav
                seriesData={projectSeriesData}
                seriesId={series}
                currentSlug={currentSlug}
              />
            )}

            {(() => {
              if(!post.data.image) return null;
              let imagePath = post.data.image;
              if (imagePath.startsWith("../../assets")) {
                imagePath = imagePath.replace("../../assets", "/src/assets");
              } else if (imagePath.startsWith("/images/")) {
                imagePath = `/src/assets${imagePath}`;
              }

              return images[imagePath] ? (
                <div class="mb-6 overflow-hidden rounded-lg">
                  <Image
                    class="w-full h-full"
                    src={images[imagePath]()}
                    alt={post.data.title || "Blog post image"}
                    width={800}
                    height={450}
                    loading="eager"
                  />
                </div>
              ) : null;
            })()}

            <h1 class="text-3xl font-bold leading-tight mb-4">{post.data.title}</h1>
            
            <div class="mb-6 flex flex-wrap items-center text-sm text-gray-600">
              {courseData && courseData.navbar.length > 0 && (
              <div class="flex items-center mr-4 mb-2">
                <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <a
                  href={`/courses/${series}`}
                  class="text-sm text-[#fb7299] font-semibold hover:underline"
                >
                  Back to {humanize(courseData?.title || series)}
                </a>
              </div>
              )}

              {projectSeriesData && (
              <div class="flex items-center mr-4 mb-2">
                <a
                  href="/articles"
                  class="text-sm text-[#FE6019] font-semibold hover:underline flex items-center gap-1.5"
                >
                  <span>🛠️</span>
                  <span>{projectSeriesData.title}</span>
                </a>
              </div>
              )}

              <div class="flex items-center mr-4 mb-2">
                <svg class="mr-1 inline-block w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <a 
                  href="https://arjit-32.github.io" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-gray-700 hover:text-[#fb7299] transition-colors"
                >
                  {humanize(post.data.author)}
                </a>
              </div>

              
              <div class="flex items-center mr-4 mb-2">
                <svg class="mr-1 inline-block w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><polyline points="12 6 12 12 16 14" stroke-width="2"/></svg>
                <span>{readingTime(post.body)}</span>
              </div>
              
              <div class="flex items-center mb-2">
                <ActionButtons 
                  id={`article-${post.slug}`} 
                  issueTitle={post.data.title}
                  issueUrl={`${siteBaseUrl}/articles/${post.slug}`}
                />
              </div>
            </div>

            {showRevisitingNotice && (
              <div class="mb-8 rounded-xl border border-amber-200/90 bg-gradient-to-r from-amber-50 to-orange-50/60 p-4 sm:p-5 shadow-xs">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-800 text-lg shadow-2xs">
                    🔁
                  </div>
                  <div class="flex-1 text-sm">
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                      <span class="font-bold text-amber-950">
                        {isArticleRevisiting ? "Lesson Under Active Revision" : "Course Under Active Revision"}
                      </span>
                      <span class="inline-flex items-center rounded-full bg-amber-200/90 px-2 py-0.5 text-[11px] font-bold text-amber-900 border border-amber-300">
                        Re-visiting
                      </span>
                    </div>
                    <p class="text-amber-900/85 leading-relaxed">
                      {isArticleRevisiting 
                        ? "This article is currently being revisited to update explanations, diagrams, and code examples. You are welcome to read and follow along as updates are actively rolled out."
                        : `This article belongs to the ${courseData?.title || humanize(series)} course, which is currently being revisited with updated architectural patterns and content. Content may be refined shortly.`
                      }
                    </p>
                  </div>
                </div>
              </div>
            )}

            {showInProgressNotice && (
              <div class="mb-8 rounded-xl border border-blue-200/90 bg-gradient-to-r from-blue-50 to-indigo-50/60 p-4 sm:p-5 shadow-xs">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-700 text-lg shadow-2xs">
                    🔄
                  </div>
                  <div class="flex-1 text-sm">
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                      <span class="font-bold text-blue-950">
                        {isArticleInProgress ? "Lesson In Active Development" : "Course In Progress"}
                      </span>
                      <span class="inline-flex items-center rounded-full bg-blue-200/90 px-2 py-0.5 text-[11px] font-bold text-blue-900 border border-blue-300">
                        In Progress
                      </span>
                    </div>
                    <p class="text-blue-900/85 leading-relaxed">
                      {isArticleInProgress 
                        ? "This lesson is currently being drafted and expanded with practical examples and diagrams. You can read the current draft as content is actively added."
                        : `This article belongs to the ${courseData?.title || humanize(series)} course, which is actively in development with new lessons rolling out regularly.`
                      }
                    </p>
                  </div>
                </div>
              </div>
            )}
            
            <MobileTableOfContents headings={headings} />

            <div class="content max-w-none prose-headings:text-2xl prose-th:text-sm prose-h3:text-lg overflow-x-hidden">
              <Content />
            </div>

            <!-- In-Article Substack Template (injected dynamically around ~50% of article body) -->
            <template id="in-article-substack-template">
              <div class="in-article-substack my-8 p-4 sm:p-5 rounded-2xl border border-orange-200/90 bg-gradient-to-r from-orange-50/70 via-white to-orange-50/40 flex flex-col sm:flex-row items-center justify-between gap-4 not-prose shadow-xs">
                <div class="text-center sm:text-left">
                  <div class="flex items-center justify-center sm:justify-start gap-2 mb-1">
                    <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
                    <span class="text-[11px] font-bold tracking-wider uppercase text-[#FE6019]">CSPrimer Newsletter</span>
                  </div>
                  <div class="text-sm font-bold text-zinc-900">Enjoying this lesson?</div>
                  <div class="text-xs text-zinc-600 mt-0.5">Subscribe on Substack for monthly real-world architecture teardowns, curated reads, and new curriculum releases. 100% free, zero spam.</div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <a
                    href="https://csprimer.substack.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2 text-xs font-semibold rounded-xl bg-[#FE6019] text-white hover:bg-orange-600 transition-colors shadow-2xs whitespace-nowrap"
                  >
                    Subscribe on Substack &nearr;
                  </a>
                </div>
              </div>
            </template>
          
            <div class="mt-12 mb-8 flex justify-center">
              <button 
                id="article-complete-btn" 
                class="flex items-center gap-2 px-8 py-3 rounded-xl font-bold transition-all duration-300 shadow-sm border-2 group"
                data-lesson-id={post.slug}
              >
                <div class="status-icon w-5 h-5 flex items-center justify-center rounded-full border-2 border-gray-300 transition-all duration-300">
                   <svg class="check-svg w-3 h-3 opacity-0 text-white transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                     <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                   </svg>
                </div>
                <span class="btn-text text-gray-500 group-hover:text-gray-700 transition-colors">Mark as Completed</span>
              </button>
            </div>

            {courseData && courseData.navbar.length > 0 && (() => {
              const currentSlug = post.slug || post.data.slug || "";
              const { previous, next } = getPreviousNextLinks(courseData.navbar, currentSlug);
            
              return (
                <div class="mt-6 flex justify-between pt-6 text-sm font-medium border-t border-gray-100">
                  <div class="text-[#fb7299]">
                    {previous && (
                      <a
                        href={`/articles/${previous.url}`}
                        class="inline-flex items-center gap-2 hover:underline"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        <div class="text-left">
                          <div class="text-xs text-gray-500">Previous</div>
                          <div>{previous.title}</div>
                        </div>
                      </a>
                    )}
                  </div>
                  <div class="ml-auto text-[#fb7299]">
                    {next && (
                      <a
                        href={`/articles/${next.url}`}
                        class="inline-flex items-center gap-2 hover:underline"
                      >
                        <div class="text-right">
                          <div class="text-xs text-gray-500">Next</div>
                          <div>{next.title}</div>
                        </div>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              );
            })()}

            {/* Project Series Step-by-Step Bottom Navigation */}
            {projectSeriesData && (() => {
              const allSeriesLinks = (projectSeriesData.navbar || [])
                .flatMap((sec: any) => sec.link || [])
                .filter((l: any) => l.type === 'articles');
              const currentIndex = allSeriesLinks.findIndex((l: any) => l.url === currentSlug);
              const previous = currentIndex > 0 ? allSeriesLinks[currentIndex - 1] : null;
              const next = currentIndex >= 0 && currentIndex < allSeriesLinks.length - 1 ? allSeriesLinks[currentIndex + 1] : null;
              const currentPart = currentIndex >= 0 ? currentIndex + 1 : 1;
              const totalParts = allSeriesLinks.length;

              return (
                <div class="project-series-bottom-nav mt-12 pt-8 border-t border-gray-200">
                  <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500">
                      <span>🛠️</span>
                      <span>Project Step {currentPart} of {totalParts}</span>
                    </span>
                    <a href="/articles" class="text-xs font-semibold text-[#FE6019] hover:underline">
                      {projectSeriesData.title}
                    </a>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {previous ? (
                      <a
                        href={`/articles/${previous.url}`}
                        class="flex flex-col p-4 rounded-xl border border-gray-200 bg-white hover:border-[#FE6019] hover:bg-orange-50/30 transition-all group"
                      >
                        <span class="text-[11px] font-bold text-gray-400 group-hover:text-[#FE6019] uppercase tracking-wider mb-1 flex items-center gap-1">
                          <span>←</span>
                          <span>Previous Step (Part {currentPart - 1})</span>
                        </span>
                        <span class="text-sm font-bold text-gray-800 group-hover:text-[#FE6019] transition-colors line-clamp-1">
                          {previous.title}
                        </span>
                      </a>
                    ) : <div class="hidden sm:block" />}

                    {next ? (
                      <a
                        href={`/articles/${next.url}`}
                        class="flex flex-col p-4 rounded-xl border border-orange-200 bg-orange-50/70 hover:bg-[#FE6019] hover:border-[#FE6019] transition-all group text-right ml-auto w-full shadow-xs hover:shadow-md"
                      >
                        <span class="text-[11px] font-bold text-[#FE6019] group-hover:text-white uppercase tracking-wider mb-1 flex items-center justify-end gap-1">
                          <span>Next Step (Part {currentPart + 1})</span>
                          <span>→</span>
                        </span>
                        <span class="text-sm font-bold text-gray-900 group-hover:text-white transition-colors line-clamp-1">
                          {next.title}
                        </span>
                      </a>
                    ) : (
                      <div class="flex flex-col justify-center p-4 rounded-xl bg-gradient-to-r from-emerald-50 to-green-50 border border-green-200 text-green-900 text-xs font-semibold text-center sm:col-span-2">
                        🎉 You've reached the final part of the {projectSeriesData.title} series!
                      </div>
                    )}
                  </div>
                </div>
              );
            })()}

          </div>
        </div>
      </div>

      <!-- Table of Contents Sidebar (sticky on side, travels down page with reader) -->
      {headings && headings.length > 0 && (
        <aside id="toc-sidebar-wrapper" class="toc-sidebar-container hidden xl:block w-72 shrink-0 self-stretch transition-all duration-300">
          <TableOfContents
            headings={headings}
            title={isProjectSeries ? "Article Blueprint" : (isCourseSeries ? "On This Page" : "Table of Contents")}
          />
        </aside>
      )}
    </div>
  </div>

  <!-- Floating Burger Button to Restore TOC -->
  {headings && headings.length > 0 && (
    <button
      id="floating-toc-burger"
      class="fixed right-0 top-32 sm:top-36 z-40 hidden items-center gap-2 px-3.5 py-2.5 bg-white/95 backdrop-blur-xs border border-gray-200 border-r-0 rounded-l-xl shadow-lg text-gray-700 hover:text-primary hover:border-primary/40 hover:bg-orange-50 transition-all cursor-pointer group"
      title="Show Table of Contents (Outline)"
      aria-label="Show Table of Contents"
    >
      <svg class="w-4 h-4 text-primary group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <span class="text-xs font-bold text-gray-700 group-hover:text-primary">Outline</span>
    </button>
  )}
</section>



<script>
  function initNavHandlers() {
    // Handle expand/collapse button clicks
    document.querySelectorAll('[id^="nav-button-"]').forEach((button) => {
      button.removeEventListener("click", handleToggle);
      button.addEventListener("click", handleToggle);
    });
  }

  function handleToggle(event: Event) {
    const button = event.currentTarget as HTMLElement;
    const index = button.id.split("-").pop();
    const content = document.getElementById(`nav-content-${index}`);
    const icon = button.querySelector(".transform");

    if (content) {
      content.classList.toggle("hidden");
    }
    if (icon) {
      icon.classList.toggle("rotate-180");
    }
  }

  function initCompletionButton() {
    const btn = document.getElementById('article-complete-btn');
    if (!btn) return;

    const lessonId = btn.getAttribute('data-lesson-id');
    if (!lessonId) return;
    const btnText = btn.querySelector('.btn-text');
    
    function updateUI(isCompleted: boolean) {
      if (isCompleted) {
        btn?.classList.add('is-completed');
        if (btnText) btnText.textContent = 'Completed';
      } else {
        btn?.classList.remove('is-completed');
        if (btnText) btnText.textContent = 'Mark as Completed';
      }
    }

    // Load initial state
    let progress: Record<string, boolean> = {};
    try { progress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}'); } catch(e) {}
    updateUI(!!progress[lessonId]);

    // Handle click
    btn.removeEventListener('click', handleComplete);
    btn.addEventListener('click', handleComplete);

    function handleComplete() {
      let currentProgress: Record<string, boolean> = {};
      try { currentProgress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}'); } catch(e) {}
      
      const newState = !currentProgress[lessonId];
      currentProgress[lessonId] = newState;
      localStorage.setItem('roadmap_progress', JSON.stringify(currentProgress));
      
      updateUI(newState);
      
      window.dispatchEvent(new CustomEvent('roadmapProgressUpdated', {
        detail: { lessonId, isChecked: newState }
      }));
    }
  }

  function initAllFeatures() {
    initNavHandlers();
    initCompletionButton();
    initTocBurger();
    initInArticleSubstack();
  }

  function initInArticleSubstack() {
    const contentEl = document.querySelector('.blog-single .content');
    if (!contentEl) return;
    if (contentEl.querySelector('.in-article-substack')) return;

    const template = document.getElementById('in-article-substack-template') as HTMLTemplateElement | null;
    if (!template) return;

    // Filter for direct top-level content blocks
    const children = Array.from(contentEl.children).filter(
      (el) => !el.classList.contains('in-article-substack') && el.tagName !== 'SCRIPT' && el.tagName !== 'STYLE'
    );

    // Only inject if the article has enough substance (at least 4 blocks)
    if (children.length < 4) return;

    // Target ~50% depth through the article (with small natural variance)
    const midpoint = Math.floor(children.length * 0.5);

    // Prefer inserting after a paragraph at or shortly after midpoint
    let targetEl = children[midpoint];
    for (let i = midpoint; i < Math.min(midpoint + 4, children.length - 1); i++) {
      if (children[i].tagName === 'P') {
        targetEl = children[i];
        break;
      }
    }

    const clone = template.content.cloneNode(true) as DocumentFragment;
    targetEl.insertAdjacentElement('afterend', clone.firstElementChild as Element);
  }

  function initTocBurger() {
    const toc = document.getElementById('toc-sidebar-wrapper');
    const collapseBtn = document.getElementById('collapse-toc-btn');
    const floatingBurger = document.getElementById('floating-toc-burger');

    if (!toc) return;

    const isTocCollapsed = localStorage.getItem('csprimer_toc_collapsed') === 'true';

    function setTocState(collapsed: boolean) {
      if (!toc) return;
      if (collapsed) {
        toc.classList.add('is-collapsed');
        floatingBurger?.classList.remove('hidden');
        floatingBurger?.classList.add('flex');
      } else {
        toc.classList.remove('is-collapsed');
        floatingBurger?.classList.add('hidden');
        floatingBurger?.classList.remove('flex');
      }
      localStorage.setItem('csprimer_toc_collapsed', String(collapsed));
    }

    if (window.innerWidth >= 1280) {
      setTocState(isTocCollapsed);
    }

    collapseBtn?.addEventListener('click', () => setTocState(true));
    floatingBurger?.addEventListener('click', () => setTocState(false));
  }

  // Attach handlers on Astro events
  document.addEventListener("astro:page-load", initAllFeatures);
</script>

