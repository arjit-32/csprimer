---
import { Image } from "astro:assets";
---

<section class="section banner relative">
  <div class="container">
    <div class="row items-center">
      <div class="lg:col-6">
        <h1 class="banner-title">Become a Better Developer</h1>

        <p class="mt-6">From fundamentals to fullstack development - A structured journey through computer science.</p>
          <a class="btn btn-white mt-8" href="/series">
              Browse Series
          </a>
      </div>
      <div class="lg:col-6">
        <Image
          class="w-full object-contain"
          alt="banner"
          src="/images/banner-img.png"
          width={603}
          height={396}
        />
      </div>
    </div>
  </div>

  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%]"
    alt="banner"
    src="/images/banner-shape.png"
    width={496}
    height={466}
  />
</section>
