---
import { Image } from "astro:assets";
import bannerImg from "@/assets/images/banner-img.png";
import bannerShapeImg from "@/assets/images/banner-shape.png";
---

<section class="section banner relative">
  <div class="container">
    <div class="row items-center">
      <div class="lg:col-6">
        <h1 class="banner-title">Become a <i>Complete</i> Software Engineer</h1>
        <p class="mt-6">Go from fundamentals in Computer Science to Fullstack Development and System Design.</p>
          <a class="btn btn-white mt-8" href="/courses">
              Browse Courses
          </a>
      </div>
      <div class="lg:col-6">
        <Image
          class="w-full object-contain"
          alt="banner"
          src={bannerImg}
          fetchpriority="high"
          loading="eager"
          width={603}
          height={396}
        />
      </div>
    </div>
  </div>

  <Image
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%]"
    alt="banner"
    src={bannerShapeImg}
    width={496}
    height={466}
    loading="lazy"
    decoding="async"
  />
</section>
