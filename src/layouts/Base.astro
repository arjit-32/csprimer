---
import TwSizeIndicator from "@/components/ui/TwSizeIndicator.astro";
import config from "@/config/config.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import "@/styles/main.scss";
import "nprogress/nprogress.css";
import { ViewTransitions } from "astro:transitions";

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

// destructure frontmatters
const { title, meta_title, description, image, noindex, canonical } =
  Astro.props;

const GA_TRACKING_ID = import.meta.env.PUBLIC_GA_TRACKING_ID;
const isProd = import.meta.env.PROD && Boolean(GA_TRACKING_ID);

const scriptContent = `
  (function() {
    try {
      var params = new URLSearchParams(window.location.search);
      if (params.get('admin') === 'disable_ga') {
        localStorage.setItem('admin_disable_ga', 'true');
        alert('Google Analytics tracking disabled for this browser.');
      } else if (params.get('admin') === 'enable_ga') {
        localStorage.removeItem('admin_disable_ga');
        alert('Google Analytics tracking re-enabled for this browser.');
      }
    } catch (e) {}

    var isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    var isDisabled = isLocal || localStorage.getItem('admin_disable_ga') === 'true';

    if (isDisabled) {
      window['ga-disable-${GA_TRACKING_ID}'] = true;
      return;
    }

    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '${GA_TRACKING_ID}');
  })();
`;

const imgStr = image || config.metadata.meta_image;
let finalOgImage = `${config.site.base_url}/images/og-image.jpg`;

if (imgStr) {
  if (imgStr.startsWith('http://') || imgStr.startsWith('https://')) {
    finalOgImage = imgStr;
  } else {
    const cleanPath = imgStr.startsWith('/') ? imgStr : `/${imgStr}`;
    finalOgImage = `${config.site.base_url}${cleanPath}`;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <!-- favicon -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    
    <!-- Resource Hints -->
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="dns-prefetch" href="https://drive.google.com" />

    <!-- Google Analytics (Production Only) -->
    {isProd && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACKING_ID}`}></script>
        <script is:inline set:html={scriptContent}></script>
      </>
    )}

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonical || `${config.site.base_url}${Astro.url.pathname}`} item-prop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ViewTransitions />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta property="og:image" content={finalOgImage} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={finalOgImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script>
      import NProgress from "nprogress";
      
      NProgress.configure({ showSpinner: false, speed: 400 });

      document.addEventListener("astro:before-preparation", () => {
        NProgress.start();
      });
      let isFirstLoad = true;
      document.addEventListener("astro:page-load", () => {
        NProgress.done();
        if (isFirstLoad) {
          isFirstLoad = false;
          return;
        }
        const isLocalHost = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
        const isAdminDisabled = localStorage.getItem("admin_disable_ga") === "true";
        if (typeof (window as any).gtag === "function" && !isLocalHost && !isAdminDisabled) {
          (window as any).gtag("event", "page_view", {
            page_location: window.location.href,
            page_title: document.title,
          });
        }
      });
    </script>
  </head>
  <body>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="overflow-x-clip">
      <slot />
    </main>
    <Footer />
  </body>
</html>
