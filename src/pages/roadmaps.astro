---
import Base from "@/layouts/Base.astro";
import Cta from "@/components/layout/Cta.astro";
import { getImage } from "astro:assets";
import InteractiveRoadmap from "@/components/roadmap/InteractiveRoadmap.astro";
import { getAllRoadmapCourses } from "@/lib/roadmapParser";
import CourseDrawer from "@/components/roadmap/CourseDrawer.astro";

import roadmapAllImg from "@/assets/images/categories/roadmap.webp";
import roadmapCoreCSImg from "@/assets/images/categories/1.webp";
import roadmapDSAImg from "@/assets/images/categories/2.webp";
import roadmapDevImg from "@/assets/images/categories/3.webp";
import roadmapSysDesignImg from "@/assets/images/categories/4.webp";

// Pre-resolve roadmap images for the static view
const resolvedRoadmaps = {
  all: await getImage({ src: roadmapAllImg, width: 1400 }),
  'Core-CS': await getImage({ src: roadmapCoreCSImg, width: 1400 }),
  'DSA': await getImage({ src: roadmapDSAImg, width: 1400 }),
  'Development': await getImage({ src: roadmapDevImg, width: 1400 }),
  'System-Design': await getImage({ src: roadmapSysDesignImg, width: 1400 }),
  'AI-Engineering': await getImage({ src: roadmapSysDesignImg, width: 1400 }),
};

const dynamicRoadmapData = await getAllRoadmapCourses();

const categories = [
  { category: "Core-CS", label: "Core CS", fullLabel: "Core Computer Science", color: "blue" },
  { category: "DSA", label: "DSA", fullLabel: "Data Structures & Algorithms", color: "red" },
  { category: "Development", label: "Full-Stack Dev", fullLabel: "Development", color: "green" },
  { category: "System-Design", label: "System Design", fullLabel: "System Design & Cloud", color: "purple" },
  { category: "AI-Engineering", label: "AI Engineering", fullLabel: "AI Engineering", color: "pink" },
];
---

<Base
  title="Learning Roadmaps"
  description="Interactive, node-based Computer Science and Software Engineering roadmaps inspired by NeetCode."
>
  <section class="py-10 md:py-14 bg-[#fafafa] text-zinc-900 min-h-screen">
    <div class="container mx-auto px-4 max-w-7xl">
      
      <!-- Top Title & Controls Header (Consistent with CS Primer Theme) -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-8 gap-6 pb-6 border-b border-zinc-200">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FE6019] text-xs font-bold tracking-wider mb-3 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#FE6019] animate-pulse"></span>
            Structured Learning Paths
          </div>
          <h1 class="text-3xl md:text-5xl font-black text-zinc-900 font-secondary tracking-tight leading-none">
            Learning Roadmaps
          </h1>
          <p class="text-zinc-600 text-sm md:text-base mt-2 max-w-2xl leading-relaxed">
            A comprehensive, node-based skill tree to master computer science fundamentals, DSA, and modern systems architecture.
          </p>
        </div>

        <!-- Mode Toggle (Interactive Tree vs Static Infographic) -->
        <div class="flex items-center self-start lg:self-auto bg-zinc-100 p-1 rounded-xl border border-zinc-200 shadow-inner">
          <button 
            id="interactiveModeBtn" 
            class="flex items-center gap-2 px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all duration-200 bg-white text-zinc-900 shadow-sm border border-zinc-200/50"
            type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#FE6019]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
            </svg>
            Interactive Tree
          </button>

          <button 
            id="visualModeBtn" 
            class="flex items-center gap-2 px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all duration-200 text-zinc-500 hover:text-zinc-900"
            type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Static Poster
          </button>
        </div>
      </div>

      <!-- Category Navigation Tabs -->
      <div class="mb-6 flex items-center justify-between gap-4">
        <div id="categoryTabs" class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none w-full">
          {categories.map(({ category, label, color }) => (
            <button
              type="button"
              data-category={category}
              class="category-tab-btn flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-xs md:text-sm font-bold tracking-tight whitespace-nowrap transition-all duration-200 border border-zinc-200 bg-white text-zinc-700 hover:text-zinc-900 hover:border-zinc-300 hover:shadow-sm shadow-sm select-none"
            >
              <span class="category-dot w-2 h-2 rounded-full transition-all" style={`background-color: var(--theme-${color}, #FE6019)`}></span>
              <span>{label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Main Roadmap Display Area -->
      <div id="roadmapDisplayArea" class="w-full">
        <!-- Interactive Mode View -->
        <div id="interactiveContent" class="transition-opacity duration-300">
          {categories.map(cat => (
            <div id={`interactive-${cat.category}`} class="interactive-container hidden">
              <InteractiveRoadmap
                roadmap={dynamicRoadmapData[cat.category] || {
                  category: cat.category,
                  layout: "branching",
                  paths: [{ id: `${cat.category}-default`, title: cat.fullLabel, courses: [] }],
                  courses: [],
                  edges: []
                }}
                title={cat.fullLabel}
                categoryId={cat.category}
              />
            </div>
          ))}
        </div>

        <!-- Static Image View -->
        <div id="visualContent" class="hidden transition-opacity duration-300 bg-white p-4 md:p-8 rounded-2xl border border-zinc-200 text-center shadow-sm">
          <div class="mb-4 flex items-center justify-between text-xs text-zinc-500 px-2">
            <span>High Resolution Infographic Preview</span>
            <a id="downloadPosterBtn" href={resolvedRoadmaps['Core-CS'].src} target="_blank" class="text-[#FE6019] hover:underline flex items-center gap-1 font-semibold">
              Open Full Size
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
          <img
            id="roadmapImage"
            src={resolvedRoadmaps['Core-CS'].src}
            data-roadmaps={JSON.stringify({
              all: resolvedRoadmaps.all.src,
              'Core-CS': resolvedRoadmaps['Core-CS'].src,
              'DSA': resolvedRoadmaps['DSA'].src,
              'Development': resolvedRoadmaps['Development'].src,
              'System-Design': resolvedRoadmaps['System-Design'].src,
              'AI-Engineering': resolvedRoadmaps['AI-Engineering'].src
            })}
            alt="Roadmap Infographic"
            class="max-w-full h-auto rounded-xl shadow-lg mx-auto border border-zinc-200"
          />
        </div>
      </div>
    </div>
  </section>

  <CourseDrawer />
  <Cta />
</Base>

<style>
  :root {
    --theme-gray: #71717a;
    --theme-purple: #a855f7;
    --theme-red: #ef4444;
    --theme-green: #10b981;
    --theme-blue: #08bdea;
    --theme-orange: #FE6019;
    --theme-pink: #ec4899;
  }

  .category-tab-btn.active {
    background-color: #ffffff !important;
    color: #18181b !important;
    border-color: #FE6019 !important;
    box-shadow: 0 4px 12px rgba(254, 96, 25, 0.15) !important;
  }
  .category-tab-btn.active .category-dot {
    transform: scale(1.3);
    box-shadow: 0 0 8px rgba(254, 96, 25, 0.5) !important;
  }
</style>

<script>
  function initRoadmapsPage() {
    const categoryTabs = document.getElementById("categoryTabs");
    const roadmapImage = document.getElementById("roadmapImage") as HTMLImageElement | null;
    const downloadPosterBtn = document.getElementById("downloadPosterBtn") as HTMLAnchorElement | null;
    const visualContent = document.getElementById("visualContent");
    const interactiveContent = document.getElementById("interactiveContent");
    const visualModeBtn = document.getElementById("visualModeBtn");
    const interactiveModeBtn = document.getElementById("interactiveModeBtn");

    if (!categoryTabs || !visualContent || !interactiveContent || !visualModeBtn || !interactiveModeBtn) return;

    let currentCategory = "Core-CS";
    let currentMode = "interactive"; // default to interactive

    function updateDisplay() {
      // Toggle mode buttons
      if (currentMode === "visual") {
        visualContent?.classList.remove("hidden");
        interactiveContent?.classList.add("hidden");

        visualModeBtn?.classList.add("bg-white", "text-zinc-900", "shadow-sm", "border", "border-zinc-200/50");
        visualModeBtn?.classList.remove("text-zinc-500");
        interactiveModeBtn?.classList.remove("bg-white", "text-zinc-900", "shadow-sm", "border", "border-zinc-200/50");
        interactiveModeBtn?.classList.add("text-zinc-500");

        // Update image src
        if (roadmapImage) {
          const imagesMap = JSON.parse(roadmapImage.dataset.roadmaps || "{}");
          const src = imagesMap[currentCategory] || imagesMap['Core-CS'] || imagesMap.all;
          roadmapImage.src = src;
          if (downloadPosterBtn) downloadPosterBtn.href = src;
        }
      } else {
        visualContent?.classList.add("hidden");
        interactiveContent?.classList.remove("hidden");

        interactiveModeBtn?.classList.add("bg-white", "text-zinc-900", "shadow-sm", "border", "border-zinc-200/50");
        interactiveModeBtn?.classList.remove("text-zinc-500");
        visualModeBtn?.classList.remove("bg-white", "text-zinc-900", "shadow-sm", "border", "border-zinc-200/50");
        visualModeBtn?.classList.add("text-zinc-500");

        // Show active category interactive container
        document.querySelectorAll(".interactive-container").forEach(el => el.classList.add("hidden"));
        const activeContainer = document.getElementById(`interactive-${currentCategory}`);
        if (activeContainer) {
          activeContainer.classList.remove("hidden");
          // Trigger redraw of SVG edges for the newly visible container
          const wrapper = activeContainer.querySelector(".neetcode-roadmap-wrapper") as any;
          if (wrapper && typeof wrapper.__redrawRoadmap === "function") {
            wrapper.__redrawRoadmap();
          }
        }
      }

      // Update active tab styling
      document.querySelectorAll(".category-tab-btn").forEach(btn => {
        const catBtn = btn as HTMLElement;
        if (catBtn.dataset.category === currentCategory) {
          catBtn.classList.add("active");
        } else {
          catBtn.classList.remove("active");
        }
      });
    }

    // Category click handler
    categoryTabs.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest(".category-tab-btn") as HTMLElement | null;
      if (!button) return;

      currentCategory = button.dataset.category || "Core-CS";
      updateDisplay();

      // Update URL query param
      const url = new URL(window.location.href);
      url.searchParams.set("category", currentCategory);
      window.history.replaceState({}, "", url.toString());
      localStorage.setItem("roadmap_category", currentCategory);
    });

    // Mode toggles
    visualModeBtn.addEventListener("click", () => {
      currentMode = "visual";
      localStorage.setItem("roadmap_mode", "visual");
      updateDisplay();
    });

    interactiveModeBtn.addEventListener("click", () => {
      currentMode = "interactive";
      localStorage.setItem("roadmap_mode", "interactive");
      updateDisplay();
    });

    // Initialize from URL or localStorage
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get("category");
    if (categoryParam && document.getElementById(`interactive-${categoryParam}`)) {
      currentCategory = categoryParam;
    } else {
      currentCategory = localStorage.getItem("roadmap_category") || "Core-CS";
    }

    currentMode = localStorage.getItem("roadmap_mode") || "interactive";

    updateDisplay();
  }

  document.addEventListener("astro:page-load", initRoadmapsPage);
</script>
