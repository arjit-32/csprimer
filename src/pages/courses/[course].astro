---
import { getCollection } from 'astro:content';
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";

// Dynamically import all images from the assets folder
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');

export async function getStaticPaths() {
  const seriesEntries = await getCollection("series");
  return seriesEntries.map((entry) => ({
    params: { course: entry.id },
    props: { seriesData: entry.data },
  }));
}

const { course } = Astro.params;
const { seriesData } = Astro.props;

// Reconstruct the full path
let imagePath = seriesData.image || "../../assets/images/collaboration.png";
if (imagePath.startsWith("../../assets")) {
  imagePath = imagePath.replace("../../assets", "/src/assets");
} else if (imagePath.startsWith("/images/")) {
  imagePath = `/src/assets${imagePath}`;
}

if (!images[imagePath]) {
  throw new Error(`"${imagePath}" does not exist in glob: "src/assets/images/**"`);
}
---

<Base title={seriesData.title || (course as string)} description={seriesData.description}>
  
  <!-- Hero Section with Gradient Overlay -->
  <section class="relative min-h-[500px] flex items-center py-20">
    <div class="absolute inset-0 overflow-hidden">
      <Image 
        src={images[imagePath]()} 
        alt={seriesData.title} 
        class="w-full h-full object-cover"
        width={1200}
        height={600}
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 to-black/40"></div>
    </div>
    
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <span class="inline-block px-4 py-1 bg-[#fb7299] rounded-full text-sm font-medium mb-4">
          {seriesData.category || "Course"}
        </span>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          {seriesData.title}
        </h1>
        <p class="text-lg text-gray-200 mb-8">
          {seriesData.subtitle}
        </p>
       
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="container max-w-4xl">
      <h2 class="text-3xl font-bold text-center mb-12">Course Content</h2>
      <p class="text-lg mb-12">
        {seriesData.description}
      </p>
     
      <div class="space-y-4">
        {seriesData.navbar.map((section: any, index: number) => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button
              class="w-full flex items-center justify-between p-4 hover:bg-gray-50 transition-colors cursor-pointer group"
              data-toggle={`section-${index}`}
            >
              <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-8 h-8 rounded-full bg-[#fb7299]/10 text-[#fb7299] font-medium">
                  {index + 1}
                </span>
                <h3 class="font-semibold text-gray-900 group-hover:text-[#fb7299] transition-colors">
                  {section.subheading}
                </h3>
              </div>
              <svg 
                class="w-5 h-5 text-gray-400 transform transition-transform duration-200" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div id={`section-${index}`} class="border-t border-gray-100">
              <div class="p-4 space-y-2">
                {section.link.map((link: any) => {
                  return (
                    <a 
                      href={ link.type != "articles" ? link.url : `/articles/${link.url}` }
                      target={link.type != "articles" ? "_blank" : "_self"}
                      class="flex items-center gap-3 p-1 rounded-md hover:bg-gray-50 transition-colors group"
                    >
                      {link.type === "youtube" ? (
                        <svg class="w-5 h-5 text-red-600" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
                        </svg>
                      ) : link.type === "book" ? (
                      <svg class="w-5 h-5 text-blue-700" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
  <path d="M6 2C4.895 2 4 2.895 4 4V20C4 21.105 4.895 22 6 22H18C19.105 22 20 21.105 20 20V4C20 2.895 19.105 2 18 2H6ZM6 4H18V20H6V4ZM8 6H16V8H8V6ZM8 10H16V12H8V10ZM8 14H13V16H8V14Z"/>
</svg>

                      ) : link.type === "external" ? (
                        <svg class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      ) : link.type === "assignment" ? (
                        <svg class="w-5 h-5 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                      ) : link.type === "github" ? (
                        <svg class="w-5 h-5 text-gray-900" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                      ) : (
                        <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                      )}
                      <span class="text-gray-700 group-hover:text-[#fb7299] transition-colors flex-1 lesson-title">
                        {link.title}
                      </span>
                      
                      <!-- Action Indicators on Right -->
                      <div class="flex items-center gap-3 ml-auto pr-2">
                        <svg class="w-4 h-4 text-yellow-400 opacity-0 transition-opacity star-indicator" viewBox="0 0 24 24" fill="currentColor" data-star-id={link.type === "articles" ? `article-${link.url}` : ""}>
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                        
                        <div class="relative flex items-center justify-center w-5 h-5 completion-indicator opacity-0 transition-opacity" data-lesson-id={link.url}>
                          <div class="w-full h-full rounded-full bg-green-500 flex items-center justify-center">
                            <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                              <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </div>
                        </div>

                        {( link.type != "articles") && (
                          <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        )}
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    function initCoursePage() {
      // 1. Toggle section visibility
      document.querySelectorAll('[data-toggle]').forEach(button => {
        button.removeEventListener('click', toggleSection);
        button.addEventListener('click', toggleSection);
      });

      // 2. Sync progress and stars
      syncProgress();
    }

    function toggleSection(event) {
      const button = event.currentTarget;
      const sectionId = button.getAttribute('data-toggle');
      const content = document.getElementById(sectionId);
      const icon = button.querySelector('svg');
      
      if (content) {
        content.classList.toggle('hidden');
        if (icon) icon.classList.toggle('rotate-180');
      }
    }

    function syncProgress() {
      // Stars
      let starred = [];
      try { starred = JSON.parse(localStorage.getItem('ib_starred') || '[]'); } catch(e) {}
      
      document.querySelectorAll('.star-indicator').forEach(icon => {
        const starId = icon.getAttribute('data-star-id');
        if (starId && starred.includes(starId)) {
          icon.classList.remove('opacity-0');
        } else {
          icon.classList.add('opacity-0');
        }
      });

      // Completion
      let progress = {};
      try { progress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}'); } catch(e) {}
      
      document.querySelectorAll('.completion-indicator').forEach(indicator => {
        const lessonId = indicator.getAttribute('data-lesson-id');
        const lessonRow = indicator.closest('.group');
        const titleSpan = lessonRow?.querySelector('.lesson-title');

        if (lessonId && progress[lessonId]) {
          indicator.classList.remove('opacity-0');
          if (titleSpan) {
            titleSpan.classList.add('line-through', 'text-gray-400');
            titleSpan.classList.remove('text-gray-700');
          }
        } else {
          indicator.classList.add('opacity-0');
          if (titleSpan) {
            titleSpan.classList.remove('line-through', 'text-gray-400');
            titleSpan.classList.add('text-gray-700');
          }
        }
      });
    }

    // Initialize on page load and after Astro navigation
    document.addEventListener('astro:page-load', initCoursePage);
    document.addEventListener('astro:after-swap', initCoursePage);
    
    // Initial call for the very first load
    initCoursePage();
  </script>
</Base>
