---
import { getCollection } from 'astro:content';
import Base from "@/layouts/Base.astro";
import { STATUS_CONFIG , isLocked } from "@/lib/statusConfig";
import { Image } from "astro:assets";

// Dynamically import all images from the assets folder
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/thumbnails/*.webp');

export async function getStaticPaths() {
  const seriesEntries = await getCollection("series");
  return seriesEntries.map((entry) => ({
    params: { course: entry.id },
    props: { seriesData: entry.data },
  }));
}

const { course } = Astro.params;
const { seriesData } = Astro.props;

// Reconstruct the full path
let imagePath = seriesData.image || "../../assets/images/collaboration.webp";
if (imagePath.startsWith("../../assets")) {
  imagePath = imagePath.replace("../../assets", "/src/assets");
} else if (imagePath.startsWith("/images/")) {
  imagePath = `/src/assets${imagePath}`;
}

if (!images[imagePath]) {
  const lowercasePath = imagePath.toLowerCase();
  const matchedKey = Object.keys(images).find(key => key.toLowerCase() === lowercasePath);
  if (matchedKey) {
    imagePath = matchedKey;
  } else {
    throw new Error(`"${imagePath}" does not exist in glob: "src/assets/images/**"`);
  }
}

const courseStatusCfg = seriesData.status ? STATUS_CONFIG[seriesData.status] : null;

// Filter syllabus sections for actual course lessons (excluding resources/further learnings)
const courseSections = (seriesData.navbar || []).filter((section: any) => {
  const sub = (section.subheading || "").toLowerCase();
  return !sub.includes("further") && !sub.includes("resource") && !sub.includes("reference");
});

// Compile resources: dedicated resources array with fallback to legacy navbar section
const legacyResourceSection = (seriesData.navbar || []).find((section: any) => {
  const sub = (section.subheading || "").toLowerCase();
  return sub.includes("further") || sub.includes("resource") || sub.includes("reference");
});

const legacyResources = legacyResourceSection 
  ? legacyResourceSection.link.map((l: any) => ({
      title: l.title,
      url: l.type === 'articles' ? `/articles/${l.url}` : l.url,
      description: undefined,
    }))
  : [];

const allResources = (seriesData.resources && seriesData.resources.length > 0)
  ? seriesData.resources
  : legacyResources;

// Helper to get navigation link URL
function getCourseLinkHref(link: any): string {
  return link.type === 'articles' ? `/articles/${link.url}` : link.url;
}

---

<Base title={seriesData.title || (course as string)} description={seriesData.description}>
  
  <!-- Hero Section with Gradient Overlay -->
  <section class="relative min-h-[500px] flex items-center py-20">
    <div class="absolute inset-0 overflow-hidden">
      <Image 
        src={images[imagePath]()} 
        alt={seriesData.title} 
        class="w-full h-full object-cover"
        width={1200}
        height={600}
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 to-black/40"></div>
    </div>
    
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <div class="flex flex-wrap items-center justify-center gap-2 mb-4">
          <span class="inline-block px-4 py-1 bg-[#fb7299] rounded-full text-sm font-medium">
            {seriesData.category || "Course"}
          </span>
          {courseStatusCfg && (
            <span class={`status-pill ${courseStatusCfg.cls}`}>
              {courseStatusCfg.label}
            </span>
          )}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          {seriesData.title}
        </h1>
        <p class="text-lg text-gray-200 mb-8">
          {seriesData.subtitle}
        </p>
       
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="container max-w-4xl">
      <h2 class="text-3xl font-bold text-center mb-12">Course Content</h2>
      <p class="text-lg mb-12">
        {seriesData.description}
      </p>
     
      <div class="space-y-4">
        {courseSections.map((section: any, index: number) => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button
              class="w-full flex items-center justify-between p-4 hover:bg-gray-50 transition-colors cursor-pointer group"
              data-toggle={`section-${index}`}
            >
              <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-8 h-8 rounded-full bg-[#fb7299]/10 text-[#fb7299] font-medium">
                  {index + 1}
                </span>
                <h3 class="font-semibold text-gray-900 group-hover:text-[#fb7299] transition-colors">
                  {section.subheading}
                </h3>
              </div>
              <svg 
                class="w-5 h-5 text-gray-400 transform transition-transform duration-200" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div id={`section-${index}`} class="border-t border-gray-100">
              <div class="p-4 space-y-2">
                {section.link.map((link: any) => {
                  const isCourseLocked = isLocked(seriesData.status);
                  const effectiveStatus = link.status || (isCourseLocked ? 'planned' : undefined);
                  const articleStatusCfg = effectiveStatus ? STATUS_CONFIG[effectiveStatus] : null;
                  const locked = isCourseLocked || isLocked(link.status);
                  const isArticle = link.type === 'articles';
                  const href = getCourseLinkHref(link);
                  const target = isArticle ? '_self' : '_blank';
                  const rel = isArticle ? undefined : 'noopener noreferrer';

                  const linkContent = (
                    <>
                      {isArticle && (
                        <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                      )}
                      {!isArticle && (
                        <svg class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      )}
                      <span class={`flex-1 lesson-title transition-colors ${locked ? 'text-gray-400 italic' : 'text-gray-700 group-hover:text-[#fb7299]'}`}>
                        {link.title}
                      </span>
                      <div class="flex items-center gap-2 ml-auto pr-2">
                        {articleStatusCfg && (
                          <span class={`status-pill ${articleStatusCfg.cls}`}>
                            {articleStatusCfg.label}
                          </span>
                        )}
                        {!locked && (
                          <>
                            <svg class="w-4 h-4 text-yellow-400 opacity-0 transition-opacity star-indicator" viewBox="0 0 24 24" fill="currentColor" data-star-id={isArticle ? `article-${link.url}` : ""}>
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                            </svg>
                            <div class="relative flex items-center justify-center w-5 h-5 completion-indicator opacity-0 transition-opacity" data-lesson-id={link.url}>
                              <div class="w-full h-full rounded-full bg-green-500 flex items-center justify-center">
                                <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                              </div>
                            </div>
                            {!isArticle && (
                              <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                          </>
                        )}
                        {locked && (
                          <svg class="w-4 h-4 text-gray-300" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17 11V7A5 5 0 0 0 7 7v4H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1h-2zm-5 6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-6H9V7a3 3 0 1 1 6 0v4z"/>
                          </svg>
                        )}
                      </div>
                    </>
                  );

                  return locked ? (
                    <span class="article-locked flex items-center gap-3 p-1 rounded-md">
                      {linkContent}
                    </span>
                  ) : (
                    <a 
                      href={href}
                      target={target}
                      rel={rel}
                      class="flex items-center gap-3 p-1 rounded-md hover:bg-gray-50 transition-colors group"
                    >
                      {linkContent}
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dedicated Further Learnings & Resources Section (Course Page Only) -->
  {allResources && allResources.length > 0 && (
    <section class="py-16 bg-white border-t border-gray-200/70">
      <div class="container max-w-4xl">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-9 h-9 rounded-xl bg-orange-50 border border-orange-200 text-[#FE6019] flex items-center justify-center font-bold text-lg shadow-2xs">
            📚
          </div>
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">
              Further Learnings & Resources
            </h2>
          </div>
        </div>
        <p class="text-sm md:text-base text-gray-500 mb-8 ml-12 leading-relaxed">
          Curated books, documentation, external courses, and notes recommended to supplement this course series.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {allResources.map((res: any) => {
            const isExternal = res.url.startsWith('http://') || res.url.startsWith('https://');
            const href = isExternal ? res.url : (res.url.startsWith('/') ? res.url : `/articles/${res.url}`);
            const target = isExternal ? '_blank' : '_self';
            const rel = isExternal ? 'noopener noreferrer' : undefined;
            
            let domain = '';
            if (isExternal) {
              try {
                domain = new URL(res.url).hostname.replace('www.', '');
              } catch (e) {
                domain = 'External Resource';
              }
            }

            return (
              <a
                href={href}
                target={target}
                rel={rel}
                class="group relative flex flex-col justify-between p-5 bg-gradient-to-br from-gray-50 to-white hover:from-orange-50/40 hover:to-white rounded-2xl border border-gray-200 hover:border-orange-300 transition-all duration-200 shadow-xs hover:shadow-md"
              >
                <div>
                  <div class="flex items-start justify-between gap-3 mb-2.5">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider bg-white border border-gray-200 text-gray-600 group-hover:border-orange-200 group-hover:text-[#FE6019] shadow-2xs">
                      {isExternal ? (
                        <>
                          <svg class="w-3 h-3 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                          <span>{domain}</span>
                        </>
                      ) : (
                        <>
                          <svg class="w-3 h-3 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                          </svg>
                          <span>Article / Notes</span>
                        </>
                      )}
                    </span>
                    
                    <span class="flex items-center justify-center w-7 h-7 rounded-full bg-gray-100 text-gray-400 group-hover:bg-orange-100 group-hover:text-[#FE6019] transition-all text-xs">
                      ↗
                    </span>
                  </div>

                  <h3 class="font-bold text-gray-900 group-hover:text-[#FE6019] transition-colors leading-snug text-base">
                    {res.title}
                  </h3>

                  {res.description && (
                    <p class="text-xs text-gray-500 mt-2 line-clamp-2 leading-relaxed">
                      {res.description}
                    </p>
                  )}
                </div>

                <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                  <span class="truncate max-w-[200px] font-mono text-[11px] text-gray-400">
                    {href}
                  </span>
                  <span class="font-semibold text-[#FE6019] group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
                    Open &rarr;
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
    </div>
  </section>

  <script>
    function initCoursePage() {
      // 1. Toggle section visibility
      document.querySelectorAll('[data-toggle]').forEach(button => {
        button.removeEventListener('click', toggleSection);
        button.addEventListener('click', toggleSection);
      });

      // 2. Sync progress and stars
      syncProgress();
    }

    function toggleSection(event: Event) {
      const button = event.currentTarget as HTMLElement;
      const sectionId = button.getAttribute('data-toggle');
      if (!sectionId) return;
      const content = document.getElementById(sectionId);
      const icon = button.querySelector('svg');
      
      if (content) {
        content.classList.toggle('hidden');
        if (icon) icon.classList.toggle('rotate-180');
      }
    }

    function syncProgress() {
      // Stars
      let starred: string[] = [];
      try { starred = JSON.parse(localStorage.getItem('ib_starred') || '[]'); } catch(e) {}
      
      document.querySelectorAll('.star-indicator').forEach(icon => {
        const starId = icon.getAttribute('data-star-id');
        if (starId && starred.includes(starId)) {
          icon.classList.remove('opacity-0');
        } else {
          icon.classList.add('opacity-0');
        }
      });

      // Completion
      let progress: Record<string, boolean> = {};
      try { progress = JSON.parse(localStorage.getItem('roadmap_progress') || '{}'); } catch(e) {}
      
      document.querySelectorAll('.completion-indicator').forEach(indicator => {
        const lessonId = indicator.getAttribute('data-lesson-id');
        const lessonRow = indicator.closest('.group');
        const titleSpan = lessonRow?.querySelector('.lesson-title');

        if (lessonId && progress[lessonId]) {
          indicator.classList.remove('opacity-0');
          if (titleSpan) {
            titleSpan.classList.add('line-through', 'text-gray-400');
            titleSpan.classList.remove('text-gray-700');
          }
        } else {
          indicator.classList.add('opacity-0');
          if (titleSpan) {
            titleSpan.classList.remove('line-through', 'text-gray-400');
            titleSpan.classList.add('text-gray-700');
          }
        }
      });
    }

    // Initialize on page load and after Astro navigation
    document.addEventListener('astro:page-load', initCoursePage);
  </script>

  <style>
    /* ── Status Pills (course detail page) ── */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      padding: 3px 10px;
      border-radius: 999px;
      white-space: nowrap;
      border: 1px solid transparent;
    }

    .status-pill--completed {
      background: #dcfce7;
      color: #15803d;
      border-color: #86efac;
    }

    .status-pill--in-progress {
      background: #dbeafe;
      color: #1d4ed8;
      border-color: #93c5fd;
    }

    .status-pill--proofreading {
      background: #fef9c3;
      color: #a16207;
      border-color: #fde047;
    }

    .status-pill--planned {
      background: #f1f5f9;
      color: #64748b;
      border-color: #cbd5e1;
    }

    .status-pill--draft {
      background: #ffedd5;
      color: #c2410c;
      border-color: #fdba74;
    }

    /* ── Locked article rows ── */
    .article-locked {
      cursor: not-allowed;
      opacity: 0.6;
      user-select: none;
    }

    /* Hero status pill contrast override (dark bg) */
    .status-pill--completed[data-hero] {
      background: rgba(220,252,231,0.18);
      color: #86efac;
      border-color: rgba(134,239,172,0.4);
    }
  </style>
</Base>
