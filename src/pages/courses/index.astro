---
import Shape from "@/components/ui/Shape.astro";
import Base from "@/layouts/Base.astro";
import Cta from "@/components/layout/Cta.astro";
import { STATUS_CONFIG } from "@/lib/statusConfig";
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";

const seriesCollection = (await getCollection("series")).sort((a, b) => {
  const weightA = a.data.weight ?? 100;
  const weightB = b.data.weight ?? 100;
  if (weightA !== weightB) return weightA - weightB;
  return a.data.title.localeCompare(b.data.title);
});
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.webp');

// Pre-resolve roadmap images for the client-side switcher
const roadmaps = {
  all: await getImage({ src: (await images['/src/assets/images/categories/roadmap.webp']()).default, width: 800 }),
  'Core-CS': await getImage({ src: (await images['/src/assets/images/categories/1.webp']()).default, width: 800 }),
  DSA: await getImage({ src: (await images['/src/assets/images/categories/2.webp']()).default, width: 800 }),
  Development: await getImage({ src: (await images['/src/assets/images/categories/3.webp']()).default, width: 800 }),
  'System-Design': await getImage({ src: (await images['/src/assets/images/categories/4.webp']()).default, width: 800 }),
   'Extras': await getImage({ src: (await images['/src/assets/images/categories/4.webp']()).default, width: 1200 }),
};

---
<Base title="Courses" description="Master computer science with CSPrimer's comprehensive course series – Core CS, DSA, Web Development, and System Design.">
  <!-- Hero Banner -->
  <div class="series-hero-section">
    <div class="series-hero-glow"></div>
    <div class="container series-hero-inner">
      <div class="series-hero-badge">🎓 LEARNING PATHS</div>
<h1 class="series-hero-title">Courses</h1>

<p class="series-hero-sub">
  Everything you need to become a complete software engineer,
from Computer Science fundamentals to real-world systems.
</p>

<div class="series-hero-stats">
  <div class="series-stat">
    <span class="series-stat-num">50+</span>
    <span class="series-stat-label">Courses</span>
  </div>

  <div class="series-stat-divider"></div>

  <div class="series-stat">
    <span class="series-stat-num">Practical</span>
    <span class="series-stat-label">Assignments</span>
  </div>

  <div class="series-stat-divider"></div>

  <div class="series-stat">
    <span class="series-stat-num">Structured</span>
    <span class="series-stat-label">Roadmaps</span>
  </div>
</div>
    </div>
  </div>

  <section class="py-12 bg-[#fafafa]">
    <div class="container mx-auto px-4">

      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-4 space-y-6"> 
          <div id="categoryButtons" class="space-y-3">
            {[
              { category: "all", label: "Show All Courses", color: "gray" },
              { category: "Core-CS", label: "Core Computer Science", color: "blue" },
              { category: "DSA", label: "Data Structures & Algorithms", color: "red" },
              { category: "Development", label: "Development", color: "green" },
              { category: "System-Design", label: "System Design", color: "purple" },
              { category: "Extras", label: "Extras", color: "orange" },
            ].map(({ category, label, color }) => {
              const bgColor = {
                gray: "bg-gray-50 hover:bg-gray-100 text-gray-500",
                blue: "bg-blue-50 hover:bg-blue-100 text-blue-500",
                green: "bg-green-50 hover:bg-green-100 text-green-500",
                red: "bg-red-50 hover:bg-red-100 text-red-500",
                purple: "bg-purple-50 hover:bg-purple-100 text-purple-500",
                orange: "bg-orange-50 hover:bg-orange-100 text-orange-500"
              }[color];
            
              return (
                <button
                  data-category={category}
                  class={`category-btn w-full flex items-center rounded-lg p-3 text-left transition border ${bgColor}`}
                >
                  <span class="mr-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                    </svg>
                  </span>
                  <span class="font-medium text-gray-700">{label}</span>
                </button>
              );
            })}
          </div>

          <div id="roadmapContent" class="hidden md:block">
            <a href="/roadmaps">
            <p class="text-sm text-gray-500 mb-2 font-semibold">Checkout Roadmap</p>
            
            <img
              id="roadmapImage"
              src={roadmaps.all.src}
              data-roadmaps={JSON.stringify({
                all: roadmaps.all.src,
                'Core-CS': roadmaps['Core-CS'].src,
                DSA: roadmaps.DSA.src,
                Development: roadmaps.Development.src,
                'System-Design': roadmaps['System-Design'].src
              })}
              alt="Roadmap"
              class="max-w-full h-auto rounded-lg shadow-md object-contain"
            />
            </a>
          </div>
        </div>

  
      <div class="md:col-span-8">
        <div id="courseGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {seriesCollection.map((entry) => {
            const series = entry.data;
            const slug = entry.id;
            const categoryColorMap = {
              all: "bg-gray-50 text-gray-50 text-gray-500",
              DSA: "bg-green-100 text-gray-600",
              Development: "bg-purple-100 text-gray-600",
              'Core-CS': "bg-blue-50 text-blue-500",
              'System-Design': "bg-red-50 text-red-500",
              'Extras': "bg-orange-50 text-orange-500"
            };
            const categoryColor = categoryColorMap[series.category] || "bg-gray-50 text-gray-500"; 

            const statusCfg = series.status ? STATUS_CONFIG[series.status] : null;
            const isPlanned = series.status === 'planned';

            const cardInner = (
              <>
                {series.ongoing && (
                  <p class="py-1 bg-slate-200 text-zinc-900 text-center text-xs">On-going</p>
                )}
                <div class="p-4">
                  {(() => {
                    let imagePath = series.image || "../../assets/images/collaboration.webp";
                    if (imagePath.startsWith("../../assets")) {
                      imagePath = imagePath.replace("../../assets", "/src/assets");
                    } else if (imagePath.startsWith("/images/")) {
                      imagePath = `/src/assets${imagePath}`;
                    }

                    if (!images[imagePath]) {
                      const lowercasePath = imagePath.toLowerCase();
                      const matchedKey = Object.keys(images).find(key => key.toLowerCase() === lowercasePath);
                      if (matchedKey) imagePath = matchedKey;
                    }

                    return images[imagePath] ? (
                      <Image
                        src={images[imagePath]()}
                        alt={series.title}
                        width={400}
                        height={200}
                        class="w-full h-48 object-cover rounded-lg mb-4 group-hover:scale-105 transition-transform duration-300"
                      />
                    ) : null;
                  })()}
                  <div class="space-x-2 mb-3 flex flex-wrap gap-y-2 items-center">
                    <span class={`inline-block ${categoryColor} text-xs font-semibold py-1 px-3 rounded-full`}>
                      {series.category}
                    </span>
                    {statusCfg && (
                      <span class={`status-pill ${statusCfg.cls}`}>
                        {statusCfg.label}
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-semibold text-gray-800 group-hover:text-pink-500 transition-colors">
                    {series.title}
                  </h3>
                  <p class="text-gray-600 mt-2 text-sm">{series.subtitle}</p>
                </div>
                <div class="absolute inset-0 bg-gradient-to-br from-pink-400 to-yellow-300 opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
                {isPlanned && (
                  <div class="course-card-locked-overlay">
                    <span class="course-card-locked-icon">🔒</span>
                  </div>
                )}
              </>
            );

            return isPlanned ? (
              <div
                class="course-card course-card--planned group relative bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden"
                data-category={series.category}
                title="This course is not yet available"
              >
                {cardInner}
              </div>
            ) : (
              <a
                href={`/courses/${slug}`}
                class="course-card group relative bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
                data-category={series.category}
              >
                {cardInner}
              </a>
            );
          })}
        </div>
      </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<script>
  function initCategoryButtons() {
    const categoryButtons = document.getElementById("categoryButtons");
    const courseGrid = document.getElementById("courseGrid");
    const courseCards = document.querySelectorAll(".course-card");
    const roadmapImage = document.getElementById("roadmapImage") as HTMLImageElement;

    if (!categoryButtons || !courseGrid || !roadmapImage) return;

    function filterSeries(category: string) {
      const existingNoResults = document.getElementById("no-results");
      if (existingNoResults) existingNoResults.remove();

      courseCards.forEach(card => {
        const c = card as HTMLElement;
        c.classList.add("opacity-0", "scale-95");
        c.style.transition = "opacity 0.3s ease, transform 0.3s ease";
      });

      setTimeout(() => {
        let visibleCount = 0;
        if (category === "all") {
          courseCards.forEach(card => {
            const c = card as HTMLElement;
            c.style.display = "";
            void c.offsetWidth;
            c.classList.remove("opacity-0", "scale-95");
            visibleCount++;
          });
        } else {
          courseCards.forEach(card => {
            const c = card as HTMLElement;
            if (c.dataset.category === category) {
              c.style.display = "";
              void c.offsetWidth;
              c.classList.remove("opacity-0", "scale-95");
              visibleCount++;
            } else {
              c.style.display = "none";
            }
          });
        }

        const existingNoResultsAfter = document.getElementById("no-results");
        if (existingNoResultsAfter) existingNoResultsAfter.remove();

        if (visibleCount === 0) {
          const noResults = document.createElement("div");
          noResults.id = "no-results";
          noResults.className = "col-span-1 sm:col-span-2 lg:col-span-3 text-center py-10";
          noResults.innerHTML = `
            <p class="text-lg text-gray-600">No courses found in the "${category}" category.</p>
            <button id="showAllBtn" class="mt-3 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition">
              Show All Courses
            </button>`;
          courseGrid.appendChild(noResults);

          const showAllBtn = document.getElementById("showAllBtn");
          showAllBtn?.addEventListener("click", () => {
            const allButton = document.querySelector('[data-category="all"]') as HTMLButtonElement;
            if (allButton) allButton.click();
          });
        }
        const dataRoadmaps = roadmapImage.dataset.roadmaps;
        if (dataRoadmaps) {
          const imagesMap = JSON.parse(dataRoadmaps);
          roadmapImage.src = imagesMap[category] || imagesMap.all;
        }
        
        // Update the URL with the selected category
        const url = new URL(window.location.href);
        if (category === "all") {
          url.searchParams.delete("category");
        } else {
          url.searchParams.set("category", category);
        }
        window.history.replaceState({}, "", url.toString());
      }, 300);
    }

    categoryButtons.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest(".category-btn") as HTMLElement;
      if (!button) return;

      document.querySelectorAll(".category-btn").forEach(btn => {
        btn.classList.remove("border-2", "border-blue-500");
      });

      button.classList.add("border-2", "border-blue-500");

      const category = button.dataset.category || "all";
      filterSeries(category);
    });

    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get("category");
    if (categoryParam) {
      const categoryButton = document.querySelector(`[data-category="${categoryParam}"]`) as HTMLButtonElement;
      if (categoryButton) {
        categoryButton.click();
      } else {
        const defaultButton = document.querySelector('[data-category="all"]') as HTMLButtonElement;
        defaultButton?.click();
      }
    } else {
      const defaultButton = document.querySelector('[data-category="all"]') as HTMLButtonElement;
      defaultButton?.click();
    }
  }

  document.addEventListener("astro:page-load", initCategoryButtons);
</script>

<style lang="scss">
  .series-hero-section {
    position: relative;
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    padding: 100px 0 90px;
    overflow: hidden;
    text-align: center;
  }

  .series-hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 70% at 50% 0%, rgba(254, 96, 25, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .series-hero-inner {
    position: relative;
    z-index: 10;
  }

  .series-hero-badge {
    display: inline-block;
    background: rgba(254, 96, 25, 0.15);
    color: #FE6019;
    border: 1px solid rgba(254, 96, 25, 0.4);
    border-radius: 999px;
    padding: 6px 18px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .series-hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: #fff;
    margin-bottom: 20px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .series-hero-sub {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.6);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .series-hero-stats {
  display: inline-flex;
  align-items: center;
  gap: 0;
  margin-top: 36px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 16px;
  padding: 16px 32px;
  backdrop-filter: blur(8px);
}

.series-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28px;
}

.series-stat-num {
  font-size: 1.4rem;
  font-weight: 900;
  color: white;
}

.series-stat-label {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.55);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.series-stat-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.12);
}

  .category-btn {
    border: 1px solid #efefef;
    background: white;
    transition: all 0.2s ease;
    
    &:hover {
      border-color: #FE6019;
      transform: translateX(4px);
    }

    &.border-blue-500 {
      border-color: #FE6019 !important;
      background: #fff5f0 !important;
      color: #FE6019 !important;
      
      span.font-medium {
        color: #FE6019 !important;
      }
    }
  }

  /* ── Status Pills ── */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .status-pill--completed {
    background: #dcfce7;
    color: #15803d;
    border-color: #86efac;
  }

  .status-pill--in-progress {
    background: #dbeafe;
    color: #1d4ed8;
    border-color: #93c5fd;
  }

  .status-pill--proofreading {
    background: #fef9c3;
    color: #a16207;
    border-color: #fde047;
  }

  .status-pill--planned {
    background: #f1f5f9;
    color: #64748b;
    border-color: #cbd5e1;
  }

  .status-pill--draft {
    background: #ffedd5;
    color: #c2410c;
    border-color: #fdba74;
  }

  /* ── Planned (locked) course card ── */
  .course-card--planned {
    cursor: not-allowed;
    opacity: 0.72;
    filter: grayscale(35%);
  }

  .course-card-locked-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .course-card--planned:hover .course-card-locked-overlay {
    opacity: 1;
  }

  .course-card-locked-icon {
    font-size: 2rem;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.18));
  }
</style>
