---
import ProjectSeriesCard from "@/components/features/blog/ProjectSeriesCard.astro";
import ProjectCard from "@/components/features/blog/ProjectCard.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import ProjectsBanner from "@/components/banners/ProjectsBanner.astro";
import Cta from "@/components/layout/Cta.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import type { TIndexData } from "@/types";
import { getCollection, getEntryBySlug } from "astro:content";
import readingTime from "@/lib/utils/readingTime";
import { humanize, plainify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";

const { blog_folder } = config.settings;
const blogIndex = (await getEntryBySlug<any, string>(
  blog_folder,
  "-index",
)) as TIndexData;

// 1. Fetch all series to separate Project Series from Course Series
const allSeries = await getCollection("series");
const projectSeries = allSeries
  .filter((s) => s.data.type === 'project' || s.data.category === 'Project')
  .sort((a, b) => (a.data.weight ?? 100) - (b.data.weight ?? 100));

const courseSeriesIds = new Set(
  allSeries
    .filter((s) => s.data.type !== 'project' && s.data.category !== 'Project')
    .map((s) => s.id)
);
const projectSeriesIds = new Set(projectSeries.map((s) => s.id));

// 2. Fetch all articles (.md and .mdx)
const posts = await getSinglePage(blog_folder);
const sortedPosts = sortByDate(posts);

// 3. Standalone articles:
// Articles that do NOT belong to any series (no series specified, or series is empty)
const standaloneArticles = sortedPosts.filter((item) => {
  return !item.data.series || item.data.series.trim() === '';
});

// 4. Featured items: can be individual standalone articles OR project series
type FeaturedItem =
  | { kind: 'series'; id: string; data: any }
  | { kind: 'standalone'; id: string; data: any };

const featuredSeries = projectSeries.filter((s) => s.data.featured);
const featuredStandalone = standaloneArticles.filter((p) => p.data.featured);

const featuredItems: FeaturedItem[] = [
  ...featuredSeries.map((s) => ({ kind: 'series' as const, id: s.id, data: s })),
  ...featuredStandalone.map((p) => ({ kind: 'standalone' as const, id: p.slug, data: p })),
];

// 5. Remaining items (below featured section)
const remainingSeries = projectSeries.filter((s) => !s.data.featured);
const remainingStandalone = standaloneArticles.filter((p) => !p.data.featured);

type ProjectGridItem =
  | { kind: 'series'; id: string; data: any; weight: number }
  | { kind: 'standalone'; id: string; data: any; weight: number };

const remainingProjects: ProjectGridItem[] = [
  ...remainingSeries.map((s) => ({
    kind: 'series' as const,
    id: s.id,
    data: s,
    weight: s.data.weight ?? 10,
  })),
  ...remainingStandalone.map((p) => ({
    kind: 'standalone' as const,
    id: p.slug,
    data: p,
    weight: p.data.weight ?? 50,
  })),
];

const totalProjects = projectSeries.length + standaloneArticles.length;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/thumbnails/**/*.{jpeg,jpg,png,gif,webp}');
---

<Base
  title={blogIndex?.data?.title || "Projects & Software Engineering Builds"}
  meta_title={blogIndex?.data?.meta_title || "Projects | CS Primer"}
  description={blogIndex?.data?.description || "Explore hands-on software engineering projects, multi-part build series, and standalone deep dives from first principles."}
  image={blogIndex?.data?.image}
>
  <div class="projects-index-container">
    <ProjectsBanner totalProjects={totalProjects} />

    <div class="container mx-auto px-4 sm:px-6 py-12 max-w-7xl">
      
      <!-- TOP SECTION: FEATURED SHOWCASE (Standalone Project or Series) -->
      {featuredItems.length > 0 && (
        <section class="featured-section mb-14" id="section-featured-projects">
          <div class="flex items-center justify-between mb-6 pb-2 border-b border-gray-200/80">
            <div class="flex items-center gap-2">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FE6019] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#FE6019]"></span>
              </span>
              <span class="text-xs font-bold uppercase tracking-wider text-[#FE6019] bg-orange-50 border border-orange-200/80 px-3 py-1 rounded-full">
                ⭐ Featured Projects
              </span>
            </div>
            <span class="text-xs text-gray-500 font-mono hidden sm:inline-block">
              Flagship Hands-on Builds
            </span>
          </div>

          <div class={`grid grid-cols-1 ${featuredItems.length > 1 ? 'md:grid-cols-2' : ''} gap-8`}>
            {featuredItems.map((item) => {
              if (item.kind === 'series') {
                return (
                  <div class="featured-item-wrapper" data-featured-type="series">
                    <ProjectSeriesCard series={item.data} articles={posts} />
                  </div>
                );
              }

              const article = item.data;
              let imagePath = article.data.image || "/images/thumbnails/shell.webp";
              if (imagePath.startsWith("../../assets")) {
                imagePath = imagePath.replace("../../assets", "/src/assets");
              } else if (imagePath.startsWith("/images/")) {
                imagePath = `/src/assets${imagePath}`;
              }
              if (!images[imagePath]) {
                const lower = imagePath.toLowerCase();
                const matchedKey = Object.keys(images).find((k) => k.toLowerCase() === lower);
                if (matchedKey) imagePath = matchedKey;
              }
              const hasImage = Boolean(imagePath && images[imagePath]);

              return (
                <div
                  class="featured-item-wrapper featured-standalone-card flex flex-col justify-between bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden group"
                  data-featured-type="standalone"
                >
                  <!-- Article Image -->
                  <a href={`/articles/${article.slug}`} class="block relative aspect-[16/9] bg-zinc-100 overflow-hidden no-underline">
                    {hasImage ? (
                      <Image
                        src={images[imagePath]()}
                        alt={article.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        width={600}
                        height={338}
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center bg-zinc-200 text-zinc-400 font-bold text-xs">
                        {article.data.title}
                      </div>
                    )}
                    <span class="absolute top-3 left-3 bg-[#FE6019] text-white font-mono text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md flex items-center gap-1">
                      <span>⭐</span>
                      <span>Featured Build</span>
                    </span>
                  </a>

                  <!-- Article Body -->
                  <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
                    <div>
                      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <div class="flex flex-wrap items-center gap-1.5">
                          {(article.data.categories || []).map((cat: string) => (
                            <span class="text-[11px] font-mono font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-zinc-100 text-zinc-700 border border-zinc-200">
                              {cat}
                            </span>
                          ))}
                          {article.data.year && (
                            <span class="text-[11px] font-mono text-zinc-400">
                              {article.data.year}
                            </span>
                          )}
                        </div>

                        <span class="inline-flex items-center text-xs text-gray-500 font-medium">
                          <svg class="mr-1 w-3.5 h-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="10" stroke-width="2"/>
                            <polyline points="12 6 12 12 16 14" stroke-width="2"/>
                          </svg>
                          {readingTime(article.body)}
                        </span>
                      </div>

                      <a href={`/articles/${article.slug}`} class="block no-underline">
                        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 group-hover:text-[#FE6019] transition-colors leading-snug">
                          {article.data.title}
                        </h3>
                      </a>

                      <p class="text-xs sm:text-sm text-zinc-600 mt-2.5 line-clamp-3 leading-relaxed">
                        {article.data.subtitle || article.data.description}
                      </p>
                    </div>

                    <!-- Footer -->
                    <div class="mt-6 pt-4 border-t border-zinc-100 flex items-center justify-between">
                      <a
                        href={`/articles/${article.slug}`}
                        class="text-xs font-bold text-[#FE6019] group-hover:translate-x-0.5 transition-transform flex items-center gap-1 no-underline"
                      >
                        <span>Explore Blueprint</span>
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>

                      {article.data.author && (
                        <span class="text-[11px] font-medium text-zinc-400">
                          By {humanize(article.data.author)}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- Filter / Category Pills Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-6 border-b border-gray-200">
        <div class="flex flex-wrap items-center gap-2" id="projectFilterButtons">
          <button
            data-filter="all"
            class="filter-pill active px-4 py-2 rounded-xl text-xs font-bold transition-all border"
          >
            <span>All</span>
            <span class="ml-1.5 px-1.5 py-0.5 rounded-full bg-white/20 text-[10px] font-mono">{totalProjects}</span>
          </button>
          {projectSeries.length > 0 && (
            <button
              data-filter="series"
              class="filter-pill px-4 py-2 rounded-xl text-xs font-bold transition-all border"
            >
              <span>📚 Project Series</span>
              <span class="ml-1.5 px-1.5 py-0.5 rounded-full bg-gray-100 text-gray-700 text-[10px] font-mono">{projectSeries.length}</span>
            </button>
          )}
          {standaloneArticles.length > 0 && (
            <button
              data-filter="standalone"
              class="filter-pill px-4 py-2 rounded-xl text-xs font-bold transition-all border"
            >
              <span>📄 Standalone Articles</span>
              <span class="ml-1.5 px-1.5 py-0.5 rounded-full bg-gray-100 text-gray-700 text-[10px] font-mono">{standaloneArticles.length}</span>
            </button>
          )}
        </div>

        <div class="text-xs text-gray-500 font-medium" id="projectCountDisplay">
          Showing <span class="font-bold text-gray-900">{totalProjects}</span> articles & projects
        </div>
      </div>

      <!-- SECTION BELOW: ALL ARTICLES & PROJECT SERIES -->
      <section class="combined-projects-section" id="section-combined-projects">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
              Articles & Multi-Part Series
            </h2>
            <p class="text-sm text-gray-600 mt-1 max-w-2xl">
              Explore standalone technical articles and hands-on multi-part series constructed from first principles.
            </p>
          </div>
        </div>

        <!-- Unified Card Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10" id="projectsGrid">
          {remainingProjects.map((item) => (
            <div
              class="project-grid-item transition-all duration-300"
              data-type={item.kind}
            >
              {item.kind === 'series' ? (
                <ProjectSeriesCard series={item.data} articles={posts} />
              ) : (
                <ProjectCard post={item.data} />
              )}
            </div>
          ))}
        </div>

        <!-- Empty State if filter matches 0 remaining items -->
        <div id="noProjectsMatch" class="hidden py-16 text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center text-2xl">
            🔍
          </div>
          <h3 class="text-lg font-bold text-gray-800 mb-1">No additional projects found in this category</h3>
          <p class="text-sm text-gray-500">Check the featured showcase above or select another filter.</p>
        </div>

        <!-- Interactive Pagination Component (for future case when project count scales) -->
        <div id="projectsPaginationContainer" class="mt-14 pt-8 border-t border-gray-200">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <span class="text-xs text-gray-500 font-mono" id="paginationStatus">
              Page 1 of 1
            </span>

            <nav class="flex items-center gap-1.5" aria-label="Projects pagination" id="paginationControls">
              <button
                type="button"
                id="paginationPrevBtn"
                class="px-3.5 py-1.5 rounded-lg border border-gray-200 bg-white text-xs font-semibold text-gray-400 cursor-not-allowed hover:bg-gray-50 transition-all flex items-center gap-1"
                disabled
              >
                <span>←</span>
                <span>Previous</span>
              </button>

              <div id="paginationPageNumbers" class="flex items-center gap-1">
                <button
                  type="button"
                  class="page-num-btn active w-8 h-8 rounded-lg text-xs font-bold flex items-center justify-center border transition-all bg-[#FE6019] text-white border-[#FE6019]"
                  data-page="1"
                >
                  1
                </button>
              </div>

              <button
                type="button"
                id="paginationNextBtn"
                class="px-3.5 py-1.5 rounded-lg border border-gray-200 bg-white text-xs font-semibold text-gray-400 cursor-not-allowed hover:bg-gray-50 transition-all flex items-center gap-1"
                disabled
              >
                <span>Next</span>
                <span>→</span>
              </button>
            </nav>
          </div>
        </div>
      </section>

    </div>
  </div>

  <Cta />
</Base>

<script>
  function initProjectsPage() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("#projectFilterButtons .filter-pill");
    const featuredSection = document.getElementById("section-featured-projects");
    const featuredItems = document.querySelectorAll<HTMLElement>(".featured-item-wrapper");
    const gridItems = document.querySelectorAll<HTMLElement>(".project-grid-item");
    const countDisplay = document.getElementById("projectCountDisplay");
    const emptyState = document.getElementById("noProjectsMatch");
    const prevBtn = document.getElementById("paginationPrevBtn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("paginationNextBtn") as HTMLButtonElement | null;
    const pageNumbersContainer = document.getElementById("paginationPageNumbers");
    const paginationStatus = document.getElementById("paginationStatus");

    const PAGE_SIZE = 6;
    let currentFilter = "all";
    let currentPage = 1;

    function getVisibleItems() {
      const visible: HTMLElement[] = [];
      gridItems.forEach((item) => {
        const type = item.getAttribute("data-type");
        if (currentFilter === "all" || currentFilter === type) {
          visible.push(item);
        }
      });
      return visible;
    }

    function renderPagination() {
      const visibleItems = getVisibleItems();
      const totalItems = visibleItems.length;
      const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // Update visibility of grid items according to page
      const startIndex = (currentPage - 1) * PAGE_SIZE;
      const endIndex = startIndex + PAGE_SIZE;

      gridItems.forEach((item) => {
        item.style.display = "none";
      });

      visibleItems.forEach((item, index) => {
        if (index >= startIndex && index < endIndex) {
          item.style.display = "";
        }
      });

      // Update buttons state
      if (prevBtn) {
        prevBtn.disabled = currentPage <= 1;
        if (currentPage <= 1) {
          prevBtn.classList.add("text-gray-400", "cursor-not-allowed");
          prevBtn.classList.remove("text-gray-700", "hover:border-[#FE6019]");
        } else {
          prevBtn.classList.remove("text-gray-400", "cursor-not-allowed");
          prevBtn.classList.add("text-gray-700", "hover:border-[#FE6019]");
        }
      }

      if (nextBtn) {
        nextBtn.disabled = currentPage >= totalPages;
        if (currentPage >= totalPages) {
          nextBtn.classList.add("text-gray-400", "cursor-not-allowed");
          nextBtn.classList.remove("text-gray-700", "hover:border-[#FE6019]");
        } else {
          nextBtn.classList.remove("text-gray-400", "cursor-not-allowed");
          nextBtn.classList.add("text-gray-700", "hover:border-[#FE6019]");
        }
      }

      // Render page numbers
      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = "";
        for (let p = 1; p <= totalPages; p++) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold flex items-center justify-center border transition-all ${
            p === currentPage
              ? "bg-[#FE6019] text-white border-[#FE6019] shadow-xs"
              : "bg-white text-gray-700 border-gray-200 hover:border-[#FE6019]"
          }`;
          btn.textContent = String(p);
          btn.addEventListener("click", () => {
            currentPage = p;
            renderPagination();
          });
          pageNumbersContainer.appendChild(btn);
        }
      }

      // Update status text
      if (paginationStatus) {
        if (totalItems === 0) {
          paginationStatus.textContent = "0 items";
        } else {
          const shownEnd = Math.min(endIndex, totalItems);
          paginationStatus.textContent = `Showing ${startIndex + 1}–${shownEnd} of ${totalItems} • Page ${currentPage} of ${totalPages}`;
        }
      }

      // Empty state
      if (emptyState) {
        if (totalItems === 0) {
          emptyState.classList.remove("hidden");
        } else {
          emptyState.classList.add("hidden");
        }
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage--;
          renderPagination();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        currentPage++;
        renderPagination();
      });
    }

    // Filter pill click handler
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        currentFilter = btn.getAttribute("data-filter") || "all";
        currentPage = 1;

        // Toggle featured section items based on filter
        let visibleFeaturedCount = 0;
        featuredItems.forEach((fItem) => {
          const fType = fItem.getAttribute("data-featured-type");
          if (currentFilter === "all" || currentFilter === fType) {
            fItem.style.display = "";
            visibleFeaturedCount++;
          } else {
            fItem.style.display = "none";
          }
        });

        if (featuredSection) {
          featuredSection.style.display = visibleFeaturedCount > 0 ? "" : "none";
        }

        renderPagination();

        // Update overall counter display
        if (countDisplay) {
          const visibleGrid = getVisibleItems().length;
          const totalShown = visibleGrid + visibleFeaturedCount;
          if (currentFilter === "all") {
            countDisplay.innerHTML = `Showing <span class="font-bold text-gray-900">${totalShown}</span> articles & projects`;
          } else if (currentFilter === "series") {
            countDisplay.innerHTML = `Showing <span class="font-bold text-gray-900">${totalShown}</span> project series`;
          } else if (currentFilter === "standalone") {
            countDisplay.innerHTML = `Showing <span class="font-bold text-gray-900">${totalShown}</span> standalone articles`;
          }
        }
      });
    });

    renderPagination();
  }

  document.addEventListener("astro:page-load", initProjectsPage);
</script>

<style lang="scss">
  .projects-index-container {
    min-height: 100vh;
    background: #fafafa;
  }

  .filter-pill {
    background: #ffffff;
    color: #4b5563;
    border-color: #e5e7eb;

    &:hover {
      border-color: #FE6019;
      color: #FE6019;
      background: #fffaf7;
    }

    &.active {
      background: #FE6019 !important;
      border-color: #FE6019 !important;
      color: #ffffff !important;
      box-shadow: 0 4px 12px rgba(254, 96, 25, 0.25);
    }
  }
</style>
