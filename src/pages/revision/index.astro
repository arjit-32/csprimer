---
import Base from "@/layouts/Base.astro";
import RevisionBanner from "@/components/banners/RevisionBanner.astro";
import RevisionPlanner from "@/components/revision/RevisionPlanner.astro";
---

<Base
  title="Revision Center | CS Primer"
  description="Master computer science with active recall and automated 1-3-7-14 day spaced repetition. Plan your revision, track daily goals, and reinforce learning."
>
  <RevisionBanner />

  <main class="py-10 md:py-14 bg-[#fafafa] min-h-screen text-gray-800" id="planner">
    <div class="container mx-auto px-4 max-w-6xl">
      <RevisionPlanner />
    </div>
  </main>

  
</Base>
