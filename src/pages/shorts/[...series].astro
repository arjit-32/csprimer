---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import ShortsSidebar from "@/components/shorts/ShortsSidebar.astro";

export async function getStaticPaths() {
  const allShorts = await getCollection("shorts");
  const seriesGroups = {};
  
  allShorts.forEach(short => {
    const series = short.data.series;
    if (!seriesGroups[series]) {
      seriesGroups[series] = {
        id: series,
        name: short.data.seriesName,
        items: []
      };
    }
    seriesGroups[series].items.push(short);
  });

  const paths = Object.values(seriesGroups).map((group: any) => ({
    params: { series: group.id },
    props: { 
      isIndex: false,
      activeSeriesId: group.id, 
      activeSeriesName: group.name,
      allSeries: Object.values(seriesGroups),
      shorts: group.items.sort((a, b) => a.data.order - b.data.order)
    },
  }));

  // Dedicated Index path for /shorts
  paths.push({
    params: { series: undefined },
    props: {
      isIndex: true,
      allSeries: Object.values(seriesGroups),
      shorts: [],
      activeSeriesId: undefined,
      activeSeriesName: undefined
    }
  });

  return paths;
}

const { isIndex, activeSeriesId, activeSeriesName, allSeries, shorts } = Astro.props;

// Prepare data for rendering
const shortItems = shorts.map((short) => ({
  id: short.slug.split('/').pop() || '', 
  title: short.data.title,
}));
---

<Base 
  title={isIndex ? "Learning Shorts – All Series" : `Shorts - ${activeSeriesName}`} 
  description={isIndex ? "Browse all YouTube Shorts learning series." : `Learn ${activeSeriesName} with bite-sized videos.`}
>
  {isIndex ? (
    <div class="shorts-index-container">
      <div class="hero-section">
        <div class="hero-inner container">
          <div class="hero-badge">⚡ Bite-sized Learning</div>
          <h1 class="hero-title">Learning Shorts</h1>
          <p class="hero-sub">Master complex CS and system design concepts in 60 seconds or less.<br/>Pick a series below to get started.</p>
        </div>
        <div class="hero-glow"></div>
      </div>

      <div class="series-section container">
        <div class="series-grid">
          {allSeries.map((series: any, i: number) => (
            <a href={`/shorts/${series.id}`} class="series-card" style={`--accent: ${['#FE6019','#6C63FF','#00B4D8','#2EC4B6','#FF6B6B','#F7B731'][i % 6]}`}>
              <div class="card-number">{String(i + 1).padStart(2, '0')}</div>
              <div class="card-body">
                <div class="card-badge">Series</div>
                <h2 class="card-title">{series.name}</h2>
                <p class="card-meta">
                  <span class="dot"></span>
                  {series.items.length} lessons
                </p>
              </div>
              <div class="card-arrow">→</div>
              <div class="card-glow"></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <div class="shorts-page-container">
      <ShortsSidebar 
        activeSeriesId={activeSeriesId} 
        activeSeriesName={activeSeriesName}
        items={shortItems}
      />
      
      <main class="shorts-content">
        <div class="series-header mb-12">
          <h1 class="text-4xl font-extrabold text-gray-900 mb-2">{activeSeriesName}</h1>
          <p class="text-gray-500 text-lg">Select a lesson from the sidebar or choose below to start learning.</p>
        </div>

        <div class="shorts-grid">
          {shortItems.map((short) => (
            <a href={`/shorts/${activeSeriesId}/${short.id}`} class="short-list-item">
              <div class="item-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-play-circle"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
              </div>
              <div class="item-info">
                <h3 class="item-title">{short.title}</h3>
                <span class="item-link">Watch Lesson →</span>
              </div>
            </a>
          ))}
        </div>
      </main>
    </div>
  )}
</Base>

<style lang="scss">
  /* ── Index Page ────────────────────────────────── */
  .shorts-index-container {
    min-height: 100vh;
    background: #fafafa;
  }

  /* Hero */
  .hero-section {
    position: relative;
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    padding: 100px 0 90px;
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 70% at 50% 0%, rgba(254, 96, 25, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(254, 96, 25, 0.15);
    color: #FE6019;
    border: 1px solid rgba(254, 96, 25, 0.4);
    border-radius: 999px;
    padding: 6px 18px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: #fff;
    margin-bottom: 20px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.6);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Series Grid */
  .series-section {
    padding: 64px 16px 100px;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .series-card {
    position: relative;
    background: #fff;
    border-radius: 20px;
    padding: 36px 32px;
    border: 1.5px solid #eeeeee;
    text-decoration: none;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;

    &:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.08);
      border-color: var(--accent);

      .card-glow { opacity: 1; }
      .card-arrow { transform: translateX(4px); color: var(--accent); }
      .card-number { color: var(--accent); }
    }
  }

  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 0% 0%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .card-number {
    font-size: 2.5rem;
    font-weight: 900;
    color: #e5e5e5;
    line-height: 1;
    transition: color 0.3s ease;
    flex-shrink: 0;
    min-width: 52px;
  }

  .card-body { flex: 1; }

  .card-badge {
    display: inline-block;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.3;
    margin-bottom: 10px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: #999;
    font-weight: 600;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  .card-arrow {
    font-size: 1.3rem;
    color: #ccc;
    transition: transform 0.3s ease, color 0.3s ease;
    align-self: center;
    flex-shrink: 0;
  }

  /* ── Series Page with Sidebar ──────────────────── */
  .shorts-page-container {
    display: flex;
    min-height: calc(100vh - 80px);
    background: #fff;

    @media (max-width: 1024px) {
      flex-direction: column;
    }
  }

  .shorts-content {
    flex: 1;
    padding: 60px;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;

    @media (max-width: 1024px) {
      padding: 30px 20px;
    }
  }

  .shorts-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .short-list-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      border-color: #FE6019;
      transform: translateY(-2px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);

      .item-icon { color: #FE6019; }
      .item-link { color: #FE6019; }
    }
  }

  .item-icon {
    color: #999;
    transition: color 0.2s;
  }

  .item-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #222;
    margin-bottom: 4px;
  }

  .item-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: #888;
    transition: color 0.2s;
  }
</style>
