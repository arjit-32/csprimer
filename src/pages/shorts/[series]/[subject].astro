---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import ShortCard from "@/components/shorts/ShortCard.astro";
import ShortsSidebar from "@/components/shorts/ShortsSidebar.astro";

export async function getStaticPaths() {
  const allShorts = await getCollection("shorts");
  
  // Group by series for additional context
  const seriesGroups = {};
  allShorts.forEach(short => {
    const series = short.data.series;
    if (!seriesGroups[series]) {
      seriesGroups[series] = {
        id: series,
        name: short.data.seriesName,
        items: []
      };
    }
    seriesGroups[series].items.push(short);
  });

  return allShorts.flatMap((short) => {
    const seriesId = short.data.series;
    const group = seriesGroups[seriesId];
    
    // Sort items to find relative ones
    const sortedItems = group.items.sort((a, b) => a.data.order - b.data.order);
    const currentIndex = sortedItems.findIndex(item => item.id === short.id);
    
    const prevShort = currentIndex > 0 ? sortedItems[currentIndex - 1] : null;
    const nextShort = currentIndex < sortedItems.length - 1 ? sortedItems[currentIndex + 1] : null;
    
    return {
      params: { 
        series: seriesId,
        subject: short.slug.split('/').pop()
      },
      props: { 
        short,
        seriesItems: sortedItems,
        allSeries: Object.values(seriesGroups),
        prevShort,
        nextShort
      },
    };
  });
}

const { short, seriesItems, allSeries, prevShort, nextShort } = Astro.props;
const { Content } = await short.render();

const activeShortId = short.slug.split('/').pop() || '';
const renderedShort = {
  id: activeShortId,
  youtubeId: short.data.youtubeId,
  title: short.data.title,
  Content: Content,
};

// Map sidebar data
const sidebarItems = seriesItems.map(item => ({
  id: item.slug.split('/').pop() || '',
  title: item.data.title
}));

const sidebarSeries = allSeries.map(s => ({
  slug: (s as any).id,
  name: (s as any).name,
  count: (s as any).items.length
}));
---

<Base title={short.data.title} description={short.data.title}>
  <div class="shorts-page-container">
    <ShortsSidebar 
      activeSeriesId={short.data.series} 
      activeSeriesName={short.data.seriesName}
      items={sidebarItems}
      activeShortId={activeShortId}
    />
    
    <main class="shorts-content">
      <div class="navigation-top mb-6 flex justify-between items-center">
        <a href={`/shorts/${short.data.series}`} class="text-gray-400 hover:text-primary text-sm font-medium transition-colors">
          ← Back to {short.data.seriesName}
        </a>
      </div>

      <ShortCard {...renderedShort} isSinglePage={true} />

      <!-- Pagination Buttons -->
      <div class="navigation-bottom mt-16 py-10 border-t border-gray-100 flex flex-wrap gap-6 justify-between">
        {prevShort ? (
          <a href={`/shorts/${short.data.series}/${prevShort.slug.split('/').pop()}`} class="nav-btn prev group">
            <span class="nav-label">Previous Lesson</span>
            <span class="nav-title">← {prevShort.data.title}</span>
          </a>
        ) : <div class="flex-1"></div>}

        {nextShort ? (
          <a href={`/shorts/${short.data.series}/${nextShort.slug.split('/').pop()}`} class="nav-btn next group">
            <span class="nav-label text-right">Next Lesson</span>
            <span class="nav-title text-right">{nextShort.data.title} →</span>
          </a>
        ) : <div class="flex-1"></div>}
      </div>
    </main>
  </div>
</Base>

<style lang="scss">
  .shorts-page-container {
    display: flex;
    min-height: calc(100vh - 80px);
    background: #fff;

    @media (max-width: 1024px) {
      flex-direction: column;
    }
  }

  .shorts-content {
    flex: 1;
    padding: 60px;
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;

    @media (max-width: 1024px) {
      padding: 30px 20px;
    }
  }

  /* Navigation Buttons */
  .nav-btn {
    flex: 1;
    min-width: 280px;
    padding: 24px;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;

    &:hover {
      border-color: #FE6019;
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
      
      .nav-title {
        color: #FE6019;
      }
    }

    &.next {
      text-align: right;
      align-items: flex-end;
    }
  }

  .nav-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #999;
    margin-bottom: 8px;
  }

  .nav-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #222;
    transition: color 0.3s;
    line-height: 1.4;
  }
</style>
