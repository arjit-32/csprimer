---
import { getCollection } from 'astro:content';
import Code from 'astro/components/Code.astro';
import Base from '@/layouts/Base.astro';
import { markdownify } from "@/lib/utils/textConverter";

// Fetch questions from Content Collection (Data type now)
const allTopics = await getCollection('interview-questions');

// Flatten all questions from all topics
const allQuestions = allTopics.flatMap(topic => topic.data.questions);

// Sort by ID
const questions = allQuestions.sort((a, b) => {
  return Number(a.id) - Number(b.id);
});

const allQuestionTags = questions.reduce((tags, question) => {
  question.tags.forEach(tag => tags.add(tag));
  return tags;
}, new Set());

const uniqueQuestionTags = ['all', ...Array.from(allQuestionTags)];
---

<Base meta_title='Interview Questions' description='Web Development related interview questions'>
  <section class="py-4 bg-gradient-to-br from-white via-pink-50 to-yellow-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10 text-zinc-900">Interview Questions</h2>

      <!-- Question Filter Pills (Top) -->
      <div class="flex flex-wrap gap-2 justify-center mb-4">
        {uniqueQuestionTags.map((tag) => (
          <button 
            class="filter-btn px-4 py-2 bg-pink-100 rounded-full text-sm font-medium text-gray-700 hover:bg-pink-200 transition capitalize"
            onclick={`filterContent('question', '${tag}')`}
            data-type="question"
            data-tag={tag}>
            {tag === 'all' ? 'All Questions' : tag}
          </button>
        ))}
      </div>

     <div class="flex flex-wrap gap-2 justify-center mb-8">
      <a 
        href="https://youtube.com/playlist?list=PLNpQfWftj0-cQpKnc9077q0vTydClTUep&si=9zF33v83VXjnmUwx" 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-4 py-2 bg-blue-100 rounded-full text-sm font-medium text-gray-700 hover:bg-blue-200 transition">
        Oracle Cloud Shorts
      </a>
    </div>

      <!-- Content Area -->
      <div id="contentGrid" class="space-y-8">
        <!-- Question Cards -->
        {questions.map((question, index) => (
          <div 
            class="question-card bg-gradient-to-br from-white to-gray-50 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 border border-gray-100 transform hover:-translate-y-1"
            data-type="question"
            data-tags={question.tags.join(',')}>
            <div class="p-6 sm:p-6">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-r from-[#fa729a] to-[#fddc43] rounded-full flex items-center justify-center text-white font-semibold">
                  {index + 1}
                </div>
                <div class="flex-1">
                  <h2 class="text-lg font-semibold text-gray-900 mb-3 hover:text-[#fa729a] transition-colors duration-300">
                    {question.question}
                  </h2>

                  <div class="prose prose-sm max-w-none text-gray-600 mb-4">
                    {question.answer.map((ans) => (
                      <p set:html={markdownify(ans)} class="mb-2" />
                    ))}
                  </div>

                  {question.code && (
                    <div class="mt-4 mb-4 rounded-lg overflow-hidden border border-gray-200 bg-gray-50">
                       <Code code={question.code} lang="javascript" theme="github-dark" />
                    </div>
                  )}

                  {(question.related_images ?? []).length > 0 && (
                    <div class="mt-4 space-y-3">
                      {question.related_images.map((img: string) => (
                        <img 
                          src={img} 
                          alt="Question illustration" 
                          class="rounded-lg w-full h-auto object-cover shadow-sm transition-transform duration-300 hover:scale-[1.02]"
                        />
                      ))}
                    </div>
                  )}

                  <div class="mt-4 flex flex-wrap gap-2">
                    {question.tags.map((tag: string) => (
                      <span class="px-3 py-1 bg-gradient-to-r from-[#fddc43] to-yellow-200 text-black text-xs rounded-full capitalize font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
    </div>

    <script is:inline>
      function filterContent(type, tag) {
        const questions = document.querySelectorAll('.question-card');
        const playlists = document.querySelectorAll('.playlist-card');
        const buttons = document.querySelectorAll('.filter-btn');

        buttons.forEach(btn => {
          const isActive = btn.getAttribute('data-type') === type && btn.getAttribute('data-tag') === tag;
          btn.classList.toggle('bg-pink-300', isActive && type === 'question');
          btn.classList.toggle('bg-blue-300', isActive && type === 'playlists');
          btn.classList.toggle('text-white', isActive);
          btn.classList.toggle('bg-pink-100', !isActive && btn.getAttribute('data-type') === 'question');
          btn.classList.toggle('bg-blue-100', !isActive && btn.getAttribute('data-type') === 'playlists');
          btn.classList.toggle('text-gray-700', !isActive);
        });

        questions.forEach((question) => {
          const tags = question.getAttribute('data-tags').split(',');
          const shouldShow = type === 'question' && (tag === 'all' || !tag || tags.includes(tag));
          
          if (shouldShow) {
            question.style.display = 'block';
            setTimeout(() => {
              question.style.opacity = '1';
              question.style.transform = 'translateY(0)';
            }, 50);
          } else {
            question.style.opacity = '0';
            question.style.transform = 'translateY(20px)';
            setTimeout(() => {
              question.style.display = 'none';
            }, 300);
          }
        });

        playlists.forEach((playlist) => {
          const playlistTag = playlist.getAttribute('data-tag');
          const shouldShow = type === 'playlists' && playlistTag === tag;
          
          if (shouldShow) {
            playlist.style.display = 'block';
            setTimeout(() => {
              playlist.style.opacity = '1';
              playlist.style.transform = 'translateY(0)';
            }, 50);
          } else {
            playlist.style.opacity = '0';
            playlist.style.transform = 'translateY(20px)';
            setTimeout(() => {
              playlist.style.display = 'none';
            }, 300);
          }
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        filterContent('question', 'all');
      });
    </script>
  </section>

  <style>
    /* Center playlist card */
    .playlist-card {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
    }
  </style>
</Base>
